---
// HOME PAGE NEW — /home-page-new/  (naya, behtar design — purana home page "/" waisa hi hai)
// Har section ka text neeche arrays mein hai; design is file ke <style> mein.
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../../components/FaqList.astro';
import { site } from '../../data/site';
import { posts } from '../../data/posts';

const stats = [
  { value: '+240%', label: 'average organic traffic lift in 6 months' },
  { value: '120+', label: 'clients served across 15 industries' },
  { value: '87%', label: 'reach page 1 within 90 days' },
  { value: '4.9/5', label: 'average client satisfaction rating' },
];

const problems = [
  { icon: 'fas fa-chart-line', title: 'Stuck on Page 3', text: 'No topical authority. No semantic depth. No real ranking strategy behind the scenes.' },
  { icon: 'fas fa-robot', title: 'Invisible to AI', text: 'ChatGPT and Perplexity don’t mention you. Your competitors get cited. You get skipped.' },
  { icon: 'fas fa-map-marker-alt', title: 'Zero Local Leads', text: 'Weak GMB. Thin location pages. You’re losing every “near me” search in your area.' },
];

const pillars = [
  { n: '01', title: 'Foundation', text: 'Technically flawless. Fast, crawlable, and built on a Core Web Vitals–optimized architecture.' },
  { n: '02', title: 'Semantic Depth', text: 'Entity-driven content and topical clusters that make search engines trust you as the authority.' },
  { n: '03', title: 'Local Dominance', text: 'Precision location pages and GMB optimization working together as one integrated system.' },
  { n: '04', title: 'GEO / AI Optimization', text: 'Schema, entity clarity, and citation-ready content that gets you mentioned inside AI answers.' },
];

// big: true = bento grid mein bara tile, wide: true = poori line wala lamba tile
const services = [
  { icon: 'fas fa-certificate', tag: 'NEXT FRONTIER', title: 'AI &amp; GEO Optimization', text: 'Get cited by ChatGPT, Perplexity, Claude, and Google AI Overviews when customers ask for a recommendation in your category.', href: '/services/ai-geo-optimization/', big: true },
  { icon: 'fas fa-globe', tag: 'FOUNDATION', title: 'Rank-Ready Website Design', text: 'SEO-first websites built to rank from day one — not after 12 months of “fixes.”', href: '/services/web-development/' },
  { icon: 'fas fa-brain', tag: 'AUTHORITY', title: 'Semantic SEO', text: 'Entity-driven content architecture that makes your site the definitive voice in your niche.', href: '/services/semantic-seo-optimization-services/' },
  { icon: 'fas fa-map-marker-alt', tag: 'LOCAL', title: 'Local Landing Pages', text: 'Hyper-targeted, geo-specific pages engineered to dominate every city you serve.', href: '/services/local-landing-pages/' },
  { icon: 'fas fa-store', tag: 'LOCAL PACK', title: 'GMB Management', text: 'Turn your Google Business Profile into a predictable local lead machine.', href: '/services/gmb-management-services/' },
  { icon: 'fas fa-search', tag: 'DIAGNOSTIC', title: 'SEO + GEO Audits', text: 'Deep, no-fluff audits that uncover exactly what’s holding your rankings back. Senior-led, 48-hour turnaround — and your first audit is free.', href: '/services/seo-audits/', wide: true },
];

const geoPoints = [
  'Entity &amp; schema optimization tuned for LLMs',
  'Answer-engine-ready content structure',
  'Citation-worthy authority signals',
  'AI visibility tracking across 5+ engines',
  'Monthly GEO reporting and optimization',
];

const cases = [
  { icon: 'fas fa-balance-scale', colors: ['#0F172A', '#1E293B'], tag: 'LEGAL · SEMANTIC SEO', title: 'From Page 4 to Position 2 in 90 Days', value: '+312%', label: 'organic traffic', href: '/industries/legal/' },
  { icon: 'fas fa-home', colors: ['#7F1D1D', '#DC2626'], tag: 'HOME SERVICES · GMB', title: '5× More Local Calls in 60 Days', value: '+480%', label: 'GMB actions', href: '/industries/home-services/' },
  { icon: 'fas fa-rocket', colors: ['#064E3B', '#059669'], tag: 'SAAS · GEO OPTIMIZATION', title: 'Cited by ChatGPT in 3 Weeks', value: '0 → 74%', label: 'AI visibility', href: '/case-studies/geo-ai-saas-citations/' },
];

const industries = [
  { icon: 'fas fa-balance-scale', name: 'Legal &amp; Law Firms', href: '/industries/legal/' },
  { icon: 'fas fa-tooth', name: 'Medical &amp; Dental', href: '/industries/medical-dental/' },
  { icon: 'fas fa-tools', name: 'Home Services', href: '/industries/home-services/' },
  { icon: 'fas fa-building', name: 'Real Estate', href: '/industries/real-estate/' },
  { icon: 'fas fa-shopping-cart', name: 'E-commerce &amp; SaaS', href: '/industries/ecommerce-website-and-seo/' },
];

const steps = [
  { title: 'Audit', text: 'Deep technical, semantic, and GEO audit of your existing footprint.' },
  { title: 'Strategy', text: 'Custom roadmap built around your niche, geography, and growth targets.' },
  { title: 'Build', text: 'Execution by senior strategists — content, schema, pages, and GMB.' },
  { title: 'Launch', text: 'Careful launch with monitoring, stress testing, and team training.' },
  { title: 'Scale', text: 'Monthly optimization, AI visibility tracking, and aggressive growth.' },
];

const reviews = [
  { quote: 'Rank Ready took our firm from invisible to the first result for nearly every key term in our market. Inquiries tripled in four months. They’re the only SEO team I’d recommend without hesitation.', initials: 'JS', name: 'John Smith', role: 'Managing Partner, Smith &amp; Associates Law' },
  { quote: 'We went from begging for referrals to turning away work. Their GMB and local page strategy is unmatched. Best investment we’ve made in the business.', initials: 'SK', name: 'Sarah Khan', role: 'Owner, Elite Home Services' },
  { quote: 'I didn’t even know GEO was a thing. Now my brand gets cited by ChatGPT when people ask for recommendations in my industry. Rank Ready is years ahead of every other agency.', initials: 'DP', name: 'Daniel Park', role: 'Founder, NorthPeak SaaS' },
];

const report = [
  { k: 'Technical SEO', v: '48/100', pct: 48, c: 'red' },
  { k: 'Semantic Structure', v: '62/100', pct: 62, c: 'amber' },
  { k: 'Local Signals', v: '31/100', pct: 31, c: 'red' },
  { k: 'AI Visibility', v: '0%', pct: 3, c: 'red' },
];

const latest = posts.slice(0, 3);
const fmt = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const faqs = [
  { q: 'How long does it take to see SEO results?', a: 'Most clients see measurable ranking movement within 30–60 days and major traffic lifts by month 3–6. SEO is a compounding investment — we build systems, not short-term spikes.' },
  { q: 'What is GEO and how is it different from SEO?', a: 'SEO gets you ranked in Google’s blue links. GEO (Generative Engine Optimization) gets your brand cited inside the AI answer in ChatGPT, Perplexity, Google AI Overviews, and others. They work together, but GEO is a separate discipline.' },
  { q: 'Do you work with clients globally?', a: 'Yes. We work with businesses across the US, UK, Canada, Australia, the EU, and the UAE. Everything is remote-first, with flexible meeting times, clear reporting, and scheduled strategy calls — so timezones are never a problem.' },
  { q: 'What is included in the Rank-Ready website package?', a: 'Strategy, semantic architecture, on-page SEO, schema, Core Web Vitals optimization, local landing pages (if applicable), GMB setup, and a full launch plan. Every package is scoped to your business — no templates.' },
  { q: 'Do you offer monthly retainers or one-time projects?', a: 'Both. Website builds and audits are one-time engagements. Semantic SEO, GEO, and GMB management are monthly retainers because they need continuous optimization to win.' },
  { q: 'How do you track AI and GEO visibility?', a: 'We use a combination of proprietary tools, manual query monitoring across ChatGPT, Perplexity, and Gemini, and third-party tracking platforms. You get a monthly report showing exactly where you are cited and where we are pushing next.' },
  { q: 'What industries do you specialize in?', a: 'Legal, medical and dental, home services, real estate, e-commerce, and SaaS. We take select clients outside these categories if we see strong fit.' },
  { q: 'Do you offer any guarantees?', a: 'We guarantee the work, the process, and the reporting — but anyone promising guaranteed rankings is lying to you. SEO is influence, not a button. We promise best-in-class execution and full transparency.' },
];
---
<BaseLayout
  title="Rank Ready — Websites That Come Pre-Ranked | SEO + GEO Agency"
  description="Rank-Ready websites engineered for Google and AI search. Semantic SEO, GEO, local landing pages, GMB and audits. Get a free SEO + GEO audit in 48 hours."
>
  <!-- 1. HERO -->
  <section class="n-hero">
    <div class="bg" aria-hidden="true"><div class="g1"></div><div class="g2"></div><div class="gl"></div></div>
    <div class="row inner hero-grid">
      <div class="hero-copy">
        <div class="badge"><span class="dot"></span>NOW OPTIMIZING FOR AI SEARCH &amp; GOOGLE</div>
        <h1>Rank on Google.<br />Get cited by AI.<br /><span class="grad">Dominate both.</span></h1>
        <p class="lead">We build Rank-Ready websites engineered for traditional SEO <em>and</em> generative engines like ChatGPT, Perplexity, and Google AI Overviews — so your business wins the future of search, not just the past.</p>
        <div class="rr-btn-group">
          <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book a Free Strategy Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
          <a href="#audit" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Get My Free Audit</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        </div>
        <div class="trust">
          <div class="avs"><span class="av a1">JS</span><span class="av a2">SK</span><span class="av a3">DP</span><span class="av a4">+</span></div>
          <div class="trust-txt"><div class="stars">★★★★★ <b>4.9/5</b></div><span>from 120+ clients in 15+ industries</span></div>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="vis-card g-card">
          <div class="v-search"><i class="fas fa-search"></i> best law firm near me</div>
          <div class="v-res">
            <div class="v-rank">#1</div>
            <div><div class="v-title">Smith &amp; Associates Law Firm</div><div class="v-url">smithlaw.com · ★★★★★ 4.9</div></div>
          </div>
          <div class="v-tag">GOOGLE · 1ST RESULT</div>
        </div>
        <div class="vis-card ai-card">
          <div class="ai-head"><span class="ai-ico">AI</span><span>ChatGPT</span><span class="ai-live">● live answer</span></div>
          <p>Based on recent reviews and expertise, I’d recommend <strong>Smith &amp; Associates</strong> as a top choice for…</p>
          <div class="ai-src"><span>smithlaw.com</span><span>avvo.com</span><span>justia.com</span></div>
        </div>
        <div class="vis-card score-card">
          <div class="ring"><svg viewBox="0 0 36 36"><path class="r-bg" d="M18 2.5a15.5 15.5 0 1 1 0 31a15.5 15.5 0 1 1 0-31" /><path class="r-fg" d="M18 2.5a15.5 15.5 0 1 1 0 31a15.5 15.5 0 1 1 0-31" /></svg><b>74%</b></div>
          <div><div class="sc-t">AI Visibility Score</div><div class="sc-n">↑ from 0% in 90 days</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. STATS STRIP -->
  <section class="stats-sec">
    <div class="row stats">
      {stats.map((s) => (<div class="stat"><div class="st-v grad">{s.value}</div><div class="st-l">{s.label}</div></div>))}
    </div>
  </section>

  <!-- 3. INDUSTRIES STRIP -->
  <section class="ind-sec">
    <div class="row ind-row">
      <p class="ind-lbl">Specialists in</p>
      <div class="ind-list">
        {industries.map((i) => (<a href={i.href} class="ind"><i class={i.icon}></i><span set:html={i.name} /></a>))}
      </div>
    </div>
  </section>

  <!-- 4. THE HARD TRUTH -->
  <section class="sec prob-sec">
    <div class="row prob-grid">
      <div class="prob-head">
        <p class="eyebrow red">THE HARD TRUTH</p>
        <h2 class="h2">Your website looks fine. <span class="muted">It just isn’t built to be found.</span></h2>
        <p class="sub">Most sites fail in search for the same three reasons. If any of these sound familiar, you’re leaving customers to your competitors every single day.</p>
        <a href="/services/seo-audits/" class="rr-btn rr-btn-outline"><span>Find out what’s holding you back</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
      </div>
      <div class="prob-list">
        {problems.map((p, i) => (
          <div class="prob">
            <div class="prob-n">0{i + 1}</div>
            <div class="prob-ico"><i class={p.icon}></i></div>
            <div><div class="prob-t">{p.title}</div><div class="prob-x" set:html={p.text} /></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. METHOD -->
  <section class="sec method-sec">
    <div class="bg" aria-hidden="true"><div class="m-glow"></div><div class="gl"></div></div>
    <div class="row inner center head">
      <p class="eyebrow">THE RANK READY METHOD™</p>
      <h2 class="h2 light">Four layers. <span class="grad">One system</span> that compounds.</h2>
      <p class="sub light">Every engagement is built on the same four-layer foundation — each layer makes the next one stronger.</p>
    </div>
    <div class="row inner pillars">
      {pillars.map((p, i) => (
        <div class:list={['pillar', { hot: i === 3 }]}>
          <div class="p-top"><span class="p-n">{p.n}</span><span class="p-line"></span></div>
          <div class="p-t">{p.title}</div>
          <div class="p-x">{p.text}</div>
          {i === 3 && <span class="p-new">NEW</span>}
        </div>
      ))}
    </div>
  </section>

  <!-- 6. SERVICES (BENTO) -->
  <section class="sec svc-sec">
    <div class="row svc-head">
      <div>
        <p class="eyebrow">WHAT WE DO</p>
        <h2 class="h2">Six services. Built to work together.</h2>
      </div>
      <a href="/services/" class="rr-btn rr-btn-outline"><span>View all services</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
    </div>
    <div class="row bento">
      {services.map((s) => (
        <a href={s.href} class:list={['tile', { big: s.big, wide: s.wide }]}>
          {s.big && <div class="tile-glow"></div>}
          <div class="tile-in">
            <div class="t-ico"><i class={s.icon}></i></div>
            <div class="t-tag">{s.tag}</div>
            <div class="t-title" set:html={s.title} />
            <div class="t-text" set:html={s.text} />
            {s.big && <ul class="t-list">{geoPoints.slice(0, 3).map((g) => <li set:html={g} />)}</ul>}
            <div class="t-more">Explore service <i class="fas fa-arrow-right"></i></div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 7. GEO -->
  <section class="sec geo-sec">
    <div class="row geo-grid">
      <div>
        <p class="eyebrow purple"><i class="fas fa-bolt"></i> THE FUTURE OF SEARCH</p>
        <h2 class="h2 light">Your next customer won’t Google you. <span class="purple-t">They’ll ask ChatGPT.</span></h2>
        <p class="sub light">Generative Engine Optimization (GEO) gets your brand cited <em>inside</em> AI-generated answers from ChatGPT, Perplexity, Claude, Google AI Overviews, and Gemini. It’s not SEO 2.0 — it’s a completely new playbook.</p>
        <ul class="geo-list">{geoPoints.map((p) => <li set:html={p} />)}</ul>
        <a href="/services/ai-geo-optimization/" class="rr-btn rr-btn-primary"><span>Explore GEO Services</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
      </div>
      <div class="geo-vis">
        <div class="compare">
          <div class="cmp old">
            <div class="cmp-h">Traditional search</div>
            <div class="g-q"><i class="fas fa-search"></i> best seo agency near me</div>
            <div class="g-r"><div class="g-u"><span class="g-ad">Sponsored</span> topseoagency.com</div><div class="g-t">Top SEO Agency | Free Consultation</div></div>
            <div class="g-r"><div class="g-u">clutch.co › seo-firms</div><div class="g-t">Top 50 SEO Companies — 2026 Rankings</div></div>
            <div class="g-r"><div class="g-u">digitalgrowth.io</div><div class="g-t">SEO Services That Deliver Results</div></div>
            <div class="g-r"><div class="g-u">localseopros.com</div><div class="g-t">Local SEO Experts | Get a Quote</div></div>
            <div class="g-more">+ 6 more results on page 1</div>
            <div class="cmp-note">10 blue links · you compete for clicks</div>
          </div>
          <div class="cmp new">
            <div class="cmp-h"><span class="sp"><i class="fas fa-compass"></i></span> Perplexity AI</div>
            <div class="g-q ai"><i class="fas fa-search"></i> best seo agency near me</div>
            <div class="ai-lbl"><i class="fas fa-check-circle"></i> Answer</div>
            <p>For the best local SEO agency specializing in AI optimization, I’d recommend <strong>Rank Ready</strong>. They’re pioneers in Generative Engine Optimization…</p>
            <div class="chips"><span>rank-ready.com</span><span>forbes.com</span><span>searchengineland.com</span></div>
            <div class="ai-cite"><span class="ai-cite-n">3</span> sources cited · Rank Ready ranked #1</div>
            <div class="cmp-note">1 answer · you’re the recommendation</div>
          </div>
        </div>
        <div class="geo-fact"><b>58%</b> of Google searches now end without a traditional click. If you’re not in the AI answer, you’re invisible.</div>
      </div>
    </div>
  </section>

  <!-- 8. CASE STUDIES -->
  <section class="sec cs-sec">
    <div class="row svc-head">
      <div>
        <p class="eyebrow">PROVEN RESULTS</p>
        <h2 class="h2">Real businesses. Real rankings.</h2>
      </div>
      <a href="/case-studies/" class="rr-btn rr-btn-outline"><span>All case studies</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
    </div>
    <div class="row cs-grid">
      {cases.map((c) => (
        <a href={c.href} class="cs">
          <div class="cs-top" style={'background:linear-gradient(135deg,' + c.colors[0] + ' 0%,' + c.colors[1] + ' 100%)'}>
            <div class="cs-gridlines"></div>
            <span class="cs-ico"><i class={c.icon}></i></span>
            <div class="cs-metric"><b>{c.value}</b><span>{c.label}</span></div>
          </div>
          <div class="cs-body">
            <div class="cs-tag">{c.tag}</div>
            <div class="cs-title">{c.title}</div>
            <div class="cs-more">Read the case study <i class="fas fa-arrow-right"></i></div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 9. PROCESS -->
  <section class="sec proc-sec">
    <div class="row center head">
      <p class="eyebrow">HOW WE WORK</p>
      <h2 class="h2">From audit to scale in five clear steps.</h2>
      <p class="sub">No black boxes. You always know what we’re doing, why, and what comes next.</p>
    </div>
    <ol class="row steps">
      {steps.map((s, i) => (
        <li class="step">
          <div class="s-dot">{i + 1}</div>
          <div class="s-t">{s.title}</div>
          <div class="s-x">{s.text}</div>
        </li>
      ))}
    </ol>
  </section>

  <!-- 10. TESTIMONIALS -->
  <section class="sec rev-sec">
    <div class="row rev-grid">
      <div class="rev-feature">
        <div class="q-mark">“</div>
        <p class="rf-q">{reviews[0].quote}</p>
        <div class="who"><div class="w-av">{reviews[0].initials}</div><div><div class="w-n">{reviews[0].name}</div><div class="w-r" set:html={reviews[0].role} /></div></div>
        <div class="rf-badge">★★★★★ <span>4.9/5 average rating</span></div>
      </div>
      <div class="rev-side">
        <p class="eyebrow">WHAT CLIENTS SAY</p>
        <h2 class="h2">We let results — and clients — do the talking.</h2>
        {reviews.slice(1).map((r) => (
          <div class="rev">
            <div class="stars sm">★★★★★</div>
            <p>“{r.quote}”</p>
            <div class="who sm"><div class="w-av">{r.initials}</div><div><div class="w-n">{r.name}</div><div class="w-r" set:html={r.role} /></div></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. FREE AUDIT -->
  <section class="sec audit-sec" id="audit">
    <div class="row audit-card">
      <div class="au-glow"></div>
      <div class="au-grid">
        <div>
          <p class="eyebrow light-g">FREE 20-PAGE AUDIT</p>
          <h2 class="h2 light">See exactly why you’re not ranking — and what to fix first.</h2>
          <p class="sub light">A free, no-strings audit of your technical SEO, semantic structure, local footprint, and your visibility inside AI search engines. Delivered in 48 hours.</p>
          <form class="au-form" data-key={site.web3formsKey} data-email={site.email}>
            <input type="email" name="email" required placeholder="Enter your work email" aria-label="Email" />
            <button type="submit" class="rr-btn rr-btn-primary"><span>Get My Free Audit</span><i class="fas fa-arrow-right rr-btn-arrow"></i></button>
          </form>
          <p class="au-msg" hidden></p>
          <div class="au-ticks"><span><i class="fas fa-check"></i> Free</span><span><i class="fas fa-check"></i> 48-hour delivery</span><span><i class="fas fa-check"></i> No sales pitch</span><span><i class="fas fa-check"></i> 100% actionable</span></div>
        </div>
        <div class="report">
          <div class="r-head"><span class="r-lbl">RANK READY AUDIT</span><span class="r-pill">Sample</span></div>
          <div class="r-title">Your SEO + GEO Health Report</div>
          {report.map((r) => (
            <div class="r-line">
              <div class="r-top"><span>{r.k}</span><b class={r.c}>{r.v}</b></div>
              <div class="r-bar"><span class={r.c} style={'width:' + r.pct + '%'}></span></div>
            </div>
          ))}
          <div class="r-note"><i class="fas fa-clipboard-check"></i> 23 actionable recommendations inside</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 12. LATEST BLOG -->
  <section class="sec blog-sec">
    <div class="row svc-head">
      <div>
        <p class="eyebrow">INSIGHTS</p>
        <h2 class="h2">Latest from the Rank Ready blog.</h2>
      </div>
      <a href="/blog/" class="rr-btn rr-btn-outline"><span>Visit the blog</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
    </div>
    <div class="row blog-grid">
      {latest.map((p) => (
        <a href={'/' + p.slug + '/'} class="post">
          <div class="p-img">{p.img ? <img src={'/images/blog/' + p.img} alt={p.title} width="768" height="512" loading="lazy" /> : <div class="ph"><i class="fas fa-pen-nib"></i></div>}</div>
          <div class="p-body">
            <div class="p-meta"><span class="chip">{p.cat}</span><span>{fmt(p.date)}</span></div>
            <div class="p-title">{p.title}</div>
            <div class="p-more">Read article <i class="fas fa-arrow-right"></i></div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 13. FAQ -->
  <section class="sec faq-sec">
    <div class="row faq-grid">
      <div class="faq-head">
        <p class="eyebrow">FAQ</p>
        <h2 class="h2">Questions, answered honestly.</h2>
        <p class="sub">Still unsure? Talk to a senior strategist — no pitch, just straight answers.</p>
        <div class="faq-cta">
          <div class="fc-t">Still have questions?</div>
          <p>Book a free 30-minute call and get clear advice on your rankings.</p>
