<script>
  const f = document.querySelector('.au-form') as HTMLFormElement;
  const msg = document.querySelector('.au-msg') as HTMLElement;
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (f.elements.namedItem('email') as HTMLInputElement).value;
    const key = f.dataset.key;
    if (!key) {
      location.href = 'mailto:' + f.dataset.email + '?subject=' + encodeURIComponent('Free SEO + GEO Audit Request') + '&body=' + encodeURIComponent('Please send a free audit to: ' + email);
      return;
    }
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ access_key: key, subject: 'Free Audit Request', email }),
    });
    msg.hidden = false;
    msg.textContent = res.ok ? 'Thank you! Your audit request has been received.' : 'Something went wrong. Please email us instead.';
    if (res.ok) f.reset();
  });
</script>

