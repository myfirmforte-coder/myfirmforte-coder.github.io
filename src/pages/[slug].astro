---
// BLOG POST PAGE — har blog post ka URL wahi hai jo purani site par tha: /<slug>/
// Posts ka text: src/data/wp-posts.json (purani WordPress site se import kiya gaya)
// SEO title/description: src/data/wp-seo.json
// Saaf karne ka code: src/lib/wpPosts.ts
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import seoData from '../data/wp-seo.json';
import { wpPosts, cleanContent, stripTags, decode, localImg, type WpPost } from '../lib/wpPosts';

export function getStaticPaths() {
  return wpPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: WpPost }
const { post } = Astro.props;
const seo = (seoData as Record<string, { t: string; d: string }>)[post.slug];
const title = decode(post.title);
const { html, toc, words } = cleanContent(post.content);
const minutes = Math.max(2, Math.round(words / 220));
const cat = post.categories.find((c) => c !== 'Uncategorized') || 'SEO';
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const fallback: Record<string, string> = {
  'Technical SEO': '/images/services/seo-2.jpg',
  'Local SEO': '/images/services/loc-street.jpg',
  'Semantic SEO': '/images/services/ai-abstract.jpg',
  'Website Design': '/images/services/web-3.jpg',
};
const imgOf = (p: WpPost) => (p.featured ? localImg(p.featured.src) : fallback[p.categories[0]] || '/images/services/seo-2.jpg');
const hero = imgOf(post);
const description = seo?.d && seo.d.length > 60 ? seo.d : stripTags(post.excerpt).replace(/\s*\[&hellip;\]|\s*\[…\]/g, '').slice(0, 158);
const pageTitle = seo?.t ? (seo.t.includes('Rank Ready') ? seo.t : seo.t + ' | Rank Ready') : title + ' | Rank Ready';

const same = wpPosts.filter((p) => p.slug !== post.slug && p.categories.includes(cat));
const related = [...same, ...wpPosts.filter((p) => p.slug !== post.slug && !same.includes(p))].slice(0, 3);

const schema = {
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: title, description, datePublished: post.date, dateModified: post.modified,
  image: new URL(hero, Astro.site).href,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL('/' + post.slug + '/', Astro.site).href,
};
---
<BaseLayout title={pageTitle} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <!-- 1. HERO -->
  <section class="p-hero">
    <div class="row p-head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><i class="fas fa-chevron-right"></i><a href="/blog/">Blog</a><i class="fas fa-chevron-right"></i><span>{cat}</span></nav>
      <h1>{title}</h1>
      <div class="meta">
        <span class="chip">{cat}</span>
        <span><i class="far fa-calendar"></i>{fmt(post.date)}</span>
        <span><i class="far fa-clock"></i>{minutes} min read</span>
        <span><i class="far fa-user"></i>Rank Ready Team</span>
      </div>
    </div>
  </section>

  <div class="row cover">
    <img src={hero} alt={post.featured?.alt || title} width="1024" height="683" />
  </div>

  <!-- 2. ARTICLE + SIDEBAR -->
  <section class="p-body">
    <div class="row p-grid">
      <article class="prose" set:html={html} />
      <aside class="side">
        {toc.length > 2 && (
          <nav class="toc" aria-label="On this page">
            <div class="toc-head"><span class="side-lbl">On this page</span><span class="toc-count">{toc.length} sections</span></div>
            <ol class="toc-list">{toc.map((t, i) => <li><a href={'#' + t.id} data-id={t.id}><span class="tn">{String(i + 1).padStart(2, '0')}</span><span class="tt">{t.text}</span></a></li>)}</ol>
            <div class="toc-bar"><span id="toc-progress"></span></div>
          </nav>
        )}
        <div class="side-cta">
          <span class="ico"><i class="fas fa-search"></i></span>
          <div class="sc-title">Free SEO + GEO audit</div>
          <p>Find the 3 issues actually holding your rankings back, checked by a senior strategist.</p>
          <a href="/services/seo-audits/" class="rr-btn rr-btn-primary sc-btn"><span>Get My Free Audit</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        </div>
      </aside>
    </div>
  </section>

  <!-- 3. AUTHOR -->
  <section class="author-sec">
    <div class="row">
      <div class="author">
        <div class="a-av">RR</div>
        <div>
          <div class="a-name">Written by the Rank Ready team</div>
          <p>Senior SEO and GEO strategists with 8+ years and 500+ clients behind them. Everything we publish comes from real audits and real client work, not theory.</p>
        </div>
        <a href={site.calendly} class="rr-btn rr-btn-primary" target="_blank" rel="noopener"><span>Book a Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
      </div>
    </div>
  </section>

  <!-- 4. RELATED -->
  <section class="rel-sec">
    <div class="row rel-head">
      <div><p class="eyebrow">KEEP READING</p><h2 class="h2">Related <span class="g">articles.</span></h2></div>
      <a href="/blog/" class="rr-btn rr-btn-outline"><span>All articles</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
    </div>
    <div class="row rel-grid">
      {related.map((p) => (
        <a href={'/' + p.slug + '/'} class="post">
          <div class="p-img"><img src={imgOf(p)} alt={decode(p.title)} width="768" height="512" loading="lazy" /></div>
          <div class="p-b">
            <div class="pm"><span class="chip">{p.categories[0]}</span><span class="date">{fmt(p.date)}</span></div>
            <h3>{decode(p.title)}</h3>
            <span class="read">Read more <i class="fas fa-arrow-right"></i></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 5. FINAL CTA -->
  <section class="final">
    <div class="row final-in">
      <h2>Let’s make you <span class="g">Rank Ready.</span></h2>
      <p>Book a free 30-minute strategy call. No pressure, no pitch, just clear advice on what is holding your rankings back and how to fix it.</p>
      <div class="btns">
        <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book Your Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        <a href="/contact/" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Get in Touch</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // "On this page": jo section screen par hai use highlight karo, aur parhne ki progress dikhao
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-list a')];
  const list = document.querySelector<HTMLElement>('.toc-list');
  const bar = document.getElementById('toc-progress');
  const article = document.querySelector<HTMLElement>('.prose');
  const heads = links.map((a) => document.getElementById(a.dataset.id || '')).filter(Boolean) as HTMLElement[];
  let current = '';
  function update() {
    let id = heads.length ? heads[0].id : '';
    for (const h of heads) { if (h.getBoundingClientRect().top < 140) id = h.id; }
    if (id !== current) {
      current = id;
      links.forEach((a) => a.classList.toggle('active', a.dataset.id === id));
      const act = links.find((a) => a.dataset.id === id);
      if (act && list) list.scrollTo({ top: act.offsetTop - list.clientHeight / 2 + act.clientHeight / 2, behavior: 'smooth' });
    }
    if (bar && article) {
      const r = article.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.4 - r.top) / r.height));
      bar.style.width = (p * 100).toFixed(1) + '%';
    }
  }
  if (links.length) { window.addEventListener('scroll', update, { passive: true }); update(); }
</script>

<style>
  section, .cover { font-family: var(--inter); position: relative; }
  :global(.rr-btn i.rr-btn-arrow) { font-size: 13px; }
  .g { background: linear-gradient(90deg, #6EE7B7 0%, #059669 100%); -webkit-box-decoration-break: clone; box-decoration-break: clone; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: #34D399; }
  .eyebrow { margin-bottom: 14px; padding: 0; }
  .h2 { font-size: 40px; font-weight: 800; line-height: 1.12; letter-spacing: -1.3px; color: var(--navy); margin: 0; padding: 0; }
  .ico { flex: none; width: 46px; height: 46px; border-radius: 13px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; box-shadow: 0 12px 24px -12px rgba(5,150,105,.6), inset 0 1px 0 rgba(255,255,255,.35); display: flex; align-items: center; justify-content: center; font-size: 18px; }
  .chip { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase; color: #047857; background: #ECFDF5; border-radius: 100px; padding: 4px 11px; line-height: 1.5; }

  /* 1. Hero */
  .p-hero { background: linear-gradient(135deg, #0B1224 0%, #020617 100%); padding: 80px 0 190px; overflow: hidden; }
  .p-head { max-width: 900px; text-align: center; }
  .crumbs { display: flex; justify-content: center; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 24px; color: #6EE7B7; }
  .crumbs a { color: var(--slate-400); }
  .crumbs a:hover { color: #fff; }
  .crumbs i { font-size: 9px; color: var(--slate-500); }
  .p-hero h1 { font-size: 50px; font-weight: 800; line-height: 1.12; letter-spacing: -1.6px; color: #fff; margin-bottom: 26px; padding: 0; }
  .meta { display: flex; justify-content: center; flex-wrap: wrap; align-items: center; gap: 12px 24px; font-size: 14.5px; color: var(--slate-300); }
  .meta i { color: #6EE7B7; margin-right: 7px; }
  .meta .chip { background: rgba(110,231,183,.14); color: #6EE7B7; }

  /* cover */
  .cover { z-index: 2; margin-top: -140px; max-width: 1040px; }
  .cover img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 24px; box-shadow: 0 40px 80px -40px rgba(2,6,23,.55); background: #0F172A; }

  /* 2. Body */
  .p-body { padding: 70px 0 60px; background: #fff; }
  .p-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 64px; align-items: start; max-width: 1160px; }
  .side { position: sticky; top: 110px; display: grid; gap: 20px; }
  .toc { border: 1px solid #E2E8F0; border-radius: 20px; padding: 22px 0 0; background: #fff; overflow: hidden; box-shadow: 0 20px 40px -32px rgba(15,23,42,.3); }
  .toc-head { display: flex; align-items: center; justify-content: space-between; padding: 0 22px 14px; border-bottom: 1px solid #F1F5F9; }
  .side-lbl { font-size: 12px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; color: #059669; }
  .toc-count { font-size: 12px; font-weight: 600; color: var(--slate-400); }
  .toc-list { list-style: none; margin: 0; padding: 8px 0; max-height: calc(100vh - 430px); min-height: 160px; overflow-y: auto; scrollbar-width: none; -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 12px, #000 calc(100% - 28px), transparent 100%); mask-image: linear-gradient(180deg, transparent 0, #000 12px, #000 calc(100% - 28px), transparent 100%); }
  .toc-list::-webkit-scrollbar { display: none; }
  .toc-list a { display: grid; grid-template-columns: 26px 1fr; gap: 8px; padding: 8px 22px 8px 19px; border-left: 3px solid transparent; font-size: 14px; line-height: 1.5; color: #475569; transition: background .2s, color .2s, border-color .2s; }
  .tn { font-size: 12px; font-weight: 700; color: #94A3B8; font-variant-numeric: tabular-nums; padding-top: 1px; }
  .toc-list a:hover { background: #F8FAFC; color: var(--navy); }
  .toc-list a.active { border-left-color: #10B981; background: #ECFDF5; color: #064E3B; font-weight: 600; }
  .toc-list a.active .tn { color: #059669; }
  .toc-bar { height: 3px; background: #F1F5F9; }
  .toc-bar span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #6EE7B7, #059669); transition: width .15s linear; }
  .side-cta { background: linear-gradient(135deg, #064E3B 0%, #065F46 40%, #0F172A 100%); border-radius: 20px; padding: 26px; color: #fff; }
  .sc-title { font-size: 20px; font-weight: 800; margin: 16px 0 8px; }
  .side-cta p { font-size: 14.5px; line-height: 1.6; color: #CBD5E1; padding: 0; margin: 0 0 18px; }
  .sc-btn { width: 100%; justify-content: center; }

  /* prose */
  .prose { font-size: 18px; line-height: 1.8; color: #334155; min-width: 0; }
  .prose :global(p) { margin: 0 0 22px; padding: 0; }
  .prose :global(h2) { font-size: 32px; font-weight: 800; line-height: 1.22; letter-spacing: -.8px; color: var(--navy); margin: 52px 0 18px; padding: 0; scroll-margin-top: 100px; }
  .prose :global(h3) { font-size: 23px; font-weight: 700; line-height: 1.3; color: var(--navy); margin: 36px 0 14px; padding: 0; }
  .prose :global(h4) { font-size: 19px; font-weight: 700; color: var(--navy); margin: 28px 0 10px; padding: 0; }
  .prose :global(h2:first-child), .prose :global(h3:first-child) { margin-top: 0; }
  .prose :global(strong) { color: var(--navy); }
  .prose :global(a) { color: #059669; font-weight: 600; text-decoration: underline; text-decoration-color: #A7F3D0; text-underline-offset: 3px; }
  .prose :global(a:hover) { text-decoration-color: #059669; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 24px; padding: 0 0 0 4px; list-style: none; }
  .prose :global(li) { position: relative; padding-left: 30px; margin-bottom: 10px; }
  .prose :global(ul > li::before) { content: ""; position: absolute; left: 4px; top: .62em; width: 10px; height: 10px; border-radius: 3px; background: linear-gradient(135deg, #6EE7B7, #059669); }
  .prose :global(ol) { counter-reset: n; }
  .prose :global(ol > li) { counter-increment: n; }
  .prose :global(ol > li::before) { content: counter(n); position: absolute; left: 0; top: .2em; width: 22px; height: 22px; border-radius: 7px; background: linear-gradient(135deg, #6EE7B7, #059669); color: #fff; font-size: 12px; font-weight: 700; line-height: 22px; text-align: center; }
  .prose :global(li ul), .prose :global(li ol) { margin: 10px 0 0; }
  .prose :global(li > p) { margin: 0 0 6px; }
  .prose :global(blockquote) { margin: 32px 0; padding: 22px 28px; border-left: 4px solid #10B981; background: #F0FDF4; border-radius: 0 16px 16px 0; font-size: 20px; font-weight: 600; line-height: 1.6; color: var(--navy); }
  .prose :global(blockquote p:last-child) { margin: 0; }
  .prose :global(pre) { background: #0F172A; color: #E2E8F0; border-radius: 14px; padding: 20px 22px; font-size: 14.5px; line-height: 1.7; overflow-x: auto; white-space: pre-wrap; overflow-wrap: anywhere; margin: 0 0 24px; }
  .prose :global(code) { font-size: .9em; background: #F1F5F9; padding: 2px 6px; border-radius: 6px; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(hr) { border: 0; height: 1px; background: #E2E8F0; margin: 40px 0; }
  .prose :global(figure) { margin: 32px 0; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 16px; display: block; margin: 0 auto; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 24px; font-size: 15.5px; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border: 1px solid #E2E8F0; padding: 10px 14px; text-align: left; }
  .prose :global(th) { background: #F8FAFC; color: var(--navy); }
  .prose :global(.post-cta) { margin: 36px 0; padding: 30px 32px; border-radius: 20px; background: linear-gradient(135deg, #064E3B 0%, #065F46 45%, #0F172A 100%); color: #E2E8F0; }
  .prose :global(.post-cta p) { margin: 0 0 12px; }
  .prose :global(.post-cta p:first-child) { font-size: 21px; font-weight: 800; color: #fff; line-height: 1.4; }
  .prose :global(.post-cta p:last-child) { margin: 0; }
  .prose :global(.post-cta a) { color: #6EE7B7; text-decoration-color: rgba(110,231,183,.5); }
  .prose :global(.post-cta strong) { color: #fff; }
  .prose :global(.post-cta + hr), .prose :global(hr + .post-cta) { display: none; }

  /* 3. Author */
  .author-sec { padding: 0 0 80px; background: #fff; }
  .author { max-width: 1160px; margin: 0 auto; display: flex; align-items: center; gap: 24px; border: 1px solid #E2E8F0; border-radius: 22px; padding: 28px 32px; background: #F8FAFC; }
  .a-av { flex: none; width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, #0F172A 0%, #065F46 100%); border: 2px solid #6EE7B7; color: #fff; font-weight: 800; font-size: 20px; display: flex; align-items: center; justify-content: center; }
  .a-name { font-size: 18px; font-weight: 800; color: var(--navy); margin-bottom: 4px; }
  .author p { font-size: 15px; line-height: 1.65; color: var(--slate-500); padding: 0; margin: 0; }
  .author .rr-btn { flex: none; }

  /* 4. Related */
  .rel-sec { padding: 90px 0; background: var(--light-bg); }
  .rel-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 36px; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .post { display: flex; flex-direction: column; background: #fff; border: 1px solid #E2E8F0; border-radius: 20px; overflow: hidden; transition: transform .3s, box-shadow .3s, border-color .3s; }
  .post:hover { transform: translateY(-4px); border-color: #A7F3D0; box-shadow: 0 26px 50px -30px rgba(15,23,42,.35); }
  .p-img { aspect-ratio: 768 / 450; overflow: hidden; background: #0F172A; }
  .p-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s; }
  .post:hover .p-img img { transform: scale(1.05); }
  .p-b { padding: 22px 24px 24px; display: flex; flex-direction: column; flex: 1; }
  .pm { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .date { font-size: 13px; color: var(--slate-400); }
  .p-b h3 { font-size: 18px; font-weight: 700; line-height: 1.4; color: var(--navy); margin: 0 0 16px; padding: 0; }
  .read { margin-top: auto; font-size: 15px; font-weight: 700; color: #059669; }
  .read i { font-size: 12px; margin-left: 4px; transition: transform .3s; }
  .post:hover .read i { transform: translateX(5px); }

  /* 5. Final */
  .final { background: linear-gradient(135deg, #020617 0%, #0F172A 50%, #064E3B 100%); padding: 110px 0; }
  .final-in { text-align: center; max-width: 820px; }
  .final h2 { font-size: 56px; font-weight: 800; line-height: 1.06; letter-spacing: -2px; color: #fff; margin-bottom: 20px; padding: 0; }
  .final p { font-size: 18px; line-height: 1.7; color: var(--slate-300); max-width: 620px; margin: 0 auto 36px; padding: 0; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

  @media (max-width: 1080px) {
    .p-grid { grid-template-columns: 1fr; }
    .side { position: static; grid-template-columns: 1fr 1fr; }
    .toc-list { max-height: 340px; }
  }
  @media (max-width: 980px) {
    .rel-grid { grid-template-columns: 1fr 1fr; }
    .author { flex-wrap: wrap; }
  }
  @media (max-width: 767px) {
    .p-hero { padding: 56px 0 120px; }
    .p-hero h1 { font-size: 32px; letter-spacing: -.8px; }
    .meta { gap: 10px 16px; font-size: 13.5px; }
    .cover { margin-top: -90px; }
    .cover img { border-radius: 18px; }
    .p-body { padding: 44px 0 40px; }
    .prose { font-size: 17px; }
    .prose :global(h2) { font-size: 26px; margin-top: 40px; }
    .prose :global(h3) { font-size: 21px; }
    .prose :global(blockquote) { font-size: 18px; padding: 18px 20px; }
    .prose :global(.post-cta) { padding: 24px 22px; }
    .side { grid-template-columns: 1fr; }
    .author-sec { padding-bottom: 60px; }
    .author { padding: 24px 22px; }
    .rel-sec { padding: 70px 0; }
    .h2 { font-size: 30px; }
    .rel-grid { grid-template-columns: 1fr; }
    .final { padding: 80px 0; }
    .final h2 { font-size: 36px; letter-spacing: -1.2px; }
  }
</style>
