---
// INDUSTRIES PAGE — /industries/  (naya design, home/services jaisa)
// Har industry ka text, checklist, photo aur result card neeche "industries" array mein hai.
// photo: public/images/... mein rakhi tasveer. href: us industry ka apna page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const industries = [
  {
    id: 'legal', icon: 'fas fa-balance-scale', name: 'Legal', tag: 'LEGAL · LAW FIRMS', href: '/industries/legal/', photo: '/images/cases/legal-1.jpg',
    title: 'Law firms that actually win on Google.',
    text: 'Personal injury. Family law. Criminal defense. Corporate. Every practice area has brutal local competition and razor-thin CPC if you run paid. Organic is where margins live — and we know exactly how to win it.',
    points: ['Entity-driven practice area pages (Semantic SEO)', 'Local pack domination for every city you serve', 'GMB management + automated review acquisition', 'Review schema &amp; legal directory optimization'],
    stat: { value: '+214%', title: 'avg. qualified lead growth', note: 'across 30+ law firm clients in the past 3 years' },
  },
  {
    id: 'medical', icon: 'fas fa-tooth', name: 'Medical &amp; Dental', tag: 'MEDICAL &amp; DENTAL', href: '/industries/medical-dental/', photo: '/images/services/ind-medical.jpg',
    title: 'Fill your schedule with local patients.',
    text: 'Dental practices, cosmetic clinics, orthodontists, dermatologists — patients search locally, and they trust who ranks #1. We build the systems that make that #1 spot yours, across every treatment you offer.',
    points: ['HIPAA-compliant copy &amp; schema', 'Per-location landing pages with unique content', 'Insurance and treatment query targeting', 'Google Business Profile + review management'],
    stat: { value: '+187%', title: 'avg. monthly bookings lift', note: 'measured across 20+ multi-location practices' },
  },
  {
    id: 'home', icon: 'fas fa-tools', name: 'Home Services', tag: 'HOME SERVICES', href: '/industries/home-services/', photo: '/images/cases/home-2.jpg',
    title: 'Own every ‘near me’ search in your service area.',
    text: 'Plumbing. HVAC. Roofing. Electrical. Landscaping. If you’re not in the local pack for your services in every ZIP code you serve, you’re invisible. We fix that — permanently.',
    points: ["Hyper-local 'near me' service pages", 'Service area optimization across GMB', 'Emergency-service query capture', 'Call tracking and lead attribution setup'],
    stat: { value: '+480%', title: 'avg. GMB call increase', note: 'across home services clients in past 12 months' },
  },
  {
    id: 'realestate', icon: 'fas fa-home', name: 'Real Estate', tag: 'REAL ESTATE', href: '/industries/real-estate/', photo: '/images/cases/home-4.jpg',
    title: 'Rank for neighborhoods, not just ‘homes for sale’.',
    text: 'High-intent luxury real estate buyers search by neighborhood, school district, and lifestyle — not generic terms. We build the hyper-targeted content architecture that captures them at the moment they’re ready to transact.',
    points: ['Neighborhood-level semantic content', 'IDX integration + listing schema', 'Buyer/seller persona content funnels', 'Hyper-targeted luxury and niche keywords'],
    stat: { value: '+156%', title: 'avg. attributed listing revenue', note: 'measured across 15+ boutique agencies' },
  },
  {
    id: 'saas', icon: 'fas fa-shopping-cart', name: 'E-com &amp; SaaS', tag: 'E-COMMERCE &amp; SAAS', href: '/industries/ecommerce-website-and-seo/', photo: '/images/services/ind-shop.jpg',
    title: 'Rank in Google AND be cited by ChatGPT.',
    text: 'For B2B SaaS and DTC e-commerce brands, the new battlefield isn’t just Google — it’s also Perplexity, ChatGPT, and Gemini. We’re one of the few agencies actually doing GEO optimization at scale.',
    points: ['GEO optimization — cited in AI engines', 'Commercial-intent keyword clusters', 'SERP feature capture (People Also Ask, Featured Snippets)', 'Product-led SEO &amp; comparison page strategy'],
    stat: { value: '74%', title: 'avg. AI engine citation rate', note: 'for clients on our GEO program for 90+ days' },
  },
];

const stats = [
  { value: '15+', label: 'industries ranked since 2018' },
  { value: '+214%', label: 'avg. qualified lead growth for law firms' },
  { value: '+480%', label: 'avg. GMB call increase in home services' },
  { value: '74%', label: 'avg. AI citation rate for SaaS &amp; e-com' },
];

const more = [
  { icon: 'fas fa-shield-alt', name: 'Insurance' },
  { icon: 'fas fa-chart-pie', name: 'Financial Services' },
  { icon: 'fas fa-graduation-cap', name: 'Education' },
  { icon: 'fas fa-industry', name: 'Manufacturing' },
  { icon: 'fas fa-truck', name: 'Logistics' },
  { icon: 'fas fa-plane', name: 'Travel' },
  { icon: 'fas fa-hands-helping', name: 'Non-profit' },
  { icon: 'fas fa-utensils', name: 'Restaurants' },
];
---
<BaseLayout
  title="Industries We Serve | Specialized SEO by Vertical | Rank Ready"
  description="Vertical-specific SEO playbooks for law, healthcare, home services, real estate, e-commerce & SaaS. Each industry has its own ranking system. Find yours."
>
  <!-- 1. HERO -->
  <section class="in-hero">
    <div class="row hero-grid">
      <div class="hero-copy">
        <p class="kicker">Industries</p>
        <h1>We’ve ranked 15+ industries. <span class="g">Yours is probably next.</span></h1>
        <p class="lead">Every industry has its own keyword landscape, buyer intent, and competition. Here’s how we win in the five verticals we know best — and how we’d approach yours.</p>
        <div class="btns">
          <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Get a Free Industry Audit</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
          <a href="#industries" class="rr-btn rr-btn-ghost rr-btn-lg"><span>See Industries</span><i class="fas fa-arrow-down rr-btn-arrow"></i></a>
        </div>
      </div>
      <div class="mosaic" aria-hidden="true">
        {industries.slice(0, 4).map((i, n) => (
          <div class:list={['tile', 't' + (n + 1)]}>
            <img src={i.photo} alt="" width="900" height="560" />
            <span class="tile-tag"><i class={i.icon}></i><span set:html={i.name} /></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. STATS -->
  <div class="row stats">
    {stats.map((s) => (
      <div class="stat">
        <div class="s-v">{s.value}</div>
        <div class="s-l" set:html={s.label} />
      </div>
    ))}
  </div>

  <!-- 3. JUMP LINKS -->
  <nav class="row jump" id="industries" aria-label="Industries on this page">
    {industries.map((i) => (
      <a href={'#' + i.id}><span class="j-ico"><i class={i.icon}></i></span><span set:html={i.name} /></a>
    ))}
  </nav>

  <!-- 4. FIVE INDUSTRIES -->
  <section class="list">
    {industries.map((i, n) => (
      <article id={i.id} class:list={['row', 'ind', { flip: n % 2 === 1 }]}>
        <div class="ind-media">
          <img src={i.photo} alt={i.name.replace('&amp;', '&') + ' SEO'} width="900" height="560" loading="lazy" />
          <div class="res">
            <div class="res-l">Average client result</div>
            <div class="res-v">{i.stat.value}</div>
            <div class="res-t">{i.stat.title}</div>
            <div class="res-n">{i.stat.note}</div>
          </div>
        </div>
        <div class="ind-text">
          <div class="ind-tag"><span class="ico"><i class={i.icon}></i></span><span set:html={i.tag} /></div>
          <h2 class="h2" set:html={i.title} />
          <p class="ind-p" set:html={i.text} />
          <ul class="checks">
            {i.points.map((p) => <li><i class="fas fa-check"></i><span set:html={p} /></li>)}
          </ul>
          <div class="btns">
            <a href={i.href} class="rr-btn rr-btn-primary"><span set:html={'Explore ' + i.name + ' SEO'} /><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
            <a href={site.calendly} class="rr-btn rr-btn-outline" target="_blank" rel="noopener"><span>Free Industry Audit</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- 5. NOT ON THIS LIST -->
  <section class="more">
    <div class="row">
      <div class="more-card">
        <div class="more-head">
          <p class="eyebrow light">NOT ON THIS LIST?</p>
          <h2 class="h2 light">We’ve worked in 15+ industries.</h2>
          <p class="sub light">Insurance. Financial services. Education. Manufacturing. Logistics. Travel. Non-profit. If your business has search intent — and every business does — we can help you capture more of it.</p>
          <div class="btns">
            <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book a Free Strategy Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
            <a href="/contact/" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Tell Us About Your Industry</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
          </div>
        </div>
        <div class="more-grid">
          {more.map((m) => (
            <div class="m-item"><span class="ico"><i class={m.icon}></i></span><span>{m.name}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FINAL CTA -->
  <section class="final">
    <div class="row final-in">
      <h2>Let’s make you <span class="g">Rank Ready.</span></h2>
      <p>Book a free 30-minute strategy call. No pressure, no pitch — just clear advice on what’s holding your rankings back and how to fix it.</p>
      <div class="btns center">
        <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book Your Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        <a href="/contact/" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Get in Touch</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section, .jump, .stats { font-family: var(--inter); position: relative; }
  :global(.rr-btn i.rr-btn-arrow) { font-size: 13px; }
  :global(html) { scroll-behavior: smooth; }
  .g { background: linear-gradient(90deg, #6EE7B7 0%, #059669 100%); -webkit-box-decoration-break: clone; box-decoration-break: clone; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: #34D399; }
  .eyebrow { margin-bottom: 14px; padding: 0; }
  .eyebrow.light { color: #6EE7B7; }
  .h2 { font-size: 40px; font-weight: 800; line-height: 1.14; letter-spacing: -1.2px; color: var(--navy); margin-bottom: 18px; padding: 0; }
  .h2.light { color: #fff; }
  .sub { font-size: 17px; line-height: 1.7; color: var(--slate-500); padding: 0; margin: 0 0 30px; }
  .sub.light { color: var(--slate-300); }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btns.center { justify-content: center; }
  .ico { flex: none; width: 44px; height: 44px; border-radius: 13px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; box-shadow: 0 12px 24px -12px rgba(5,150,105,.6), inset 0 1px 0 rgba(255,255,255,.35); display: inline-flex; align-items: center; justify-content: center; font-size: 17px; }

  /* 1. Hero */
  .in-hero { background: linear-gradient(135deg, #0B1224 0%, #020617 100%); padding: 90px 0 150px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .kicker { font-size: 13px; font-weight: 600; letter-spacing: 1.6px; text-transform: uppercase; color: #6EE7B7; padding: 0 0 0 34px; margin-bottom: 22px; position: relative; }
  .kicker::before { content: ""; position: absolute; left: 0; top: 50%; width: 24px; height: 2px; background: #10B981; }
  .in-hero h1 { font-size: 58px; font-weight: 800; line-height: 1.06; letter-spacing: -2.1px; color: #fff; margin-bottom: 24px; padding: 0; }
  .lead { font-size: 18px; line-height: 1.7; color: var(--slate-300); margin-bottom: 34px; padding: 0; max-width: 560px; }
  .mosaic { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 190px 190px; gap: 14px; }
  .tile { position: relative; border-radius: 18px; overflow: hidden; }
  .tile.t1 { grid-row: span 2; }
  .tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s ease; }
  .tile:hover img { transform: scale(1.05); }
  .tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(2,6,23,.75) 100%); }
  .tile-tag { position: absolute; left: 14px; bottom: 14px; z-index: 1; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #fff; }
  .tile-tag i { width: 28px; height: 28px; border-radius: 8px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); display: inline-flex; align-items: center; justify-content: center; font-size: 12px; }
  .mosaic .t4 { display: none; }

  /* 2. Stats */
  .stats { z-index: 2; margin-top: -70px; background: #fff; border: 1px solid #E2E8F0; border-radius: 20px; box-shadow: 0 30px 60px -30px rgba(15,23,42,.25); display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { padding: 28px 30px; }
  .stat + .stat { border-left: 1px solid #F1F5F9; }
  .s-v { font-size: 38px; font-weight: 800; letter-spacing: -1.4px; line-height: 1.1; color: var(--navy); }
  .s-l { font-size: 14px; line-height: 1.5; color: var(--slate-500); margin-top: 6px; }

  /* 3. Jump */
  .jump { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 60px; scroll-margin-top: 30px; }
  .jump a { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px 8px 8px; border: 1px solid #E2E8F0; border-radius: 100px; font-size: 15px; font-weight: 600; color: var(--navy); background: #fff; transition: border-color .25s, box-shadow .25s, transform .25s; }
  .jump a:hover { border-color: #A7F3D0; transform: translateY(-2px); box-shadow: 0 14px 30px -18px rgba(15,23,42,.35); }
  .j-ico { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; }

  /* 4. List */
  .list { padding: 70px 0 40px; background: #fff; }
  .ind { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; padding: 50px 0; scroll-margin-top: 90px; }
  .ind + .ind { border-top: 1px solid #F1F5F9; }
  .ind.flip .ind-media { order: 2; }
  .ind-media { position: relative; padding-bottom: 36px; }
  .ind-media img { display: block; width: 100%; aspect-ratio: 16 / 11; object-fit: cover; border-radius: 22px; }
  .res { position: absolute; right: -18px; bottom: 0; width: 270px; background: linear-gradient(135deg, #064E3B 0%, #065F46 45%, #0F172A 100%); color: #fff; border-radius: 18px; padding: 22px 24px; box-shadow: 0 30px 60px -24px rgba(2,6,23,.55); }
  .ind.flip .res { right: auto; left: -18px; }
  .res-l { font-size: 11px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: #6EE7B7; margin-bottom: 6px; }
  .res-v { font-size: 46px; font-weight: 800; letter-spacing: -1.8px; line-height: 1; margin-bottom: 8px; background: linear-gradient(90deg, #6EE7B7 0%, #10B981 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: #34D399; }
  .res-t { font-size: 15px; font-weight: 700; line-height: 1.4; margin-bottom: 4px; }
  .res-n { font-size: 12.5px; line-height: 1.5; color: var(--slate-300); }
  .ind-tag { display: flex; align-items: center; gap: 12px; font-size: 12.5px; font-weight: 700; letter-spacing: 1.4px; color: #059669; margin-bottom: 18px; }
  .ind-p { font-size: 16.5px; line-height: 1.75; color: #475569; padding: 0; margin-bottom: 22px; }
  .checks { list-style: none; margin: 0 0 30px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px; }
  .checks li { display: flex; gap: 10px; font-size: 15px; line-height: 1.5; color: #334155; padding: 0; }
  .checks li i { flex: none; width: 20px; height: 20px; margin-top: 1px; border-radius: 50%; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; font-size: 9px; display: flex; align-items: center; justify-content: center; }

  /* 5. More */
  .more { padding: 40px 0 100px; background: #fff; }
  .more-card { display: grid; grid-template-columns: 1.1fr .9fr; gap: 50px; align-items: center; background: linear-gradient(135deg, #064E3B 0%, #065F46 40%, #0F172A 100%); border-radius: 30px; padding: 64px; }
  .more-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .m-item { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); color: #fff; font-size: 15px; font-weight: 600; }
  .m-item .ico { width: 36px; height: 36px; border-radius: 10px; font-size: 14px; }

  /* 6. Final */
  .final { background: linear-gradient(135deg, #020617 0%, #0F172A 50%, #064E3B 100%); padding: 120px 0; }
  .final-in { text-align: center; max-width: 820px; }
  .final h2 { font-size: 60px; font-weight: 800; line-height: 1.06; letter-spacing: -2px; color: #fff; margin-bottom: 20px; padding: 0; }
  .final p { font-size: 18px; line-height: 1.7; color: var(--slate-300); max-width: 620px; margin: 0 auto 36px; padding: 0; }

  @media (max-width: 1100px) {
    .res { right: 12px; } .ind.flip .res { left: 12px; }
  }
  @media (max-width: 980px) {
    .hero-grid, .ind, .more-card { grid-template-columns: 1fr; gap: 40px; }
    .in-hero { padding: 64px 0 130px; }
    .mosaic { max-width: 620px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(3) { border-left: 0; }
    .stat:nth-child(n+3) { border-top: 1px solid #F1F5F9; }
    .ind.flip .ind-media { order: 0; }
    .ind-media { max-width: 680px; }
    .more-card { padding: 48px 36px; }
  }
  @media (max-width: 767px) {
    .in-hero h1 { font-size: 38px; letter-spacing: -1.2px; }
    .lead { font-size: 16.5px; }
    .h2 { font-size: 30px; letter-spacing: -.9px; }
    .mosaic { grid-template-rows: 130px 130px; gap: 10px; }
    .stats { margin-top: -60px; }
    .stat { padding: 20px 18px; }
    .s-v { font-size: 28px; }
    .s-l { font-size: 12.5px; }
    .jump { margin-top: 40px; gap: 8px; }
    .jump a { font-size: 13.5px; padding: 6px 14px 6px 6px; }
    .j-ico { width: 28px; height: 28px; font-size: 11px; }
    .list { padding: 40px 0 20px; }
    .ind { padding: 36px 0; gap: 28px; }
    .ind-media { padding-bottom: 0; }
    .res, .ind.flip .res { position: relative; left: auto; right: auto; width: auto; margin: -50px 14px 0; }
    .checks { grid-template-columns: 1fr; }
    .btns .rr-btn { width: 100%; }
    .more { padding: 20px 0 70px; }
    .more-card { padding: 40px 22px; border-radius: 22px; }
    .more-card > * { min-width: 0; }
    .more-card .rr-btn { white-space: normal; text-align: center; }
    .more-grid { gap: 8px; }
    .m-item { min-width: 0; padding: 10px; gap: 10px; font-size: 13.5px; }
    .m-item .ico { width: 30px; height: 30px; font-size: 12px; }
  }
  @media (max-width: 400px) {
    .m-item { padding: 9px 8px; gap: 8px; font-size: 12.5px; }
    .m-item .ico { width: 26px; height: 26px; font-size: 11px; }
    .final { padding: 80px 0; }
    .final h2 { font-size: 38px; letter-spacing: -1.2px; }
  }
</style>
