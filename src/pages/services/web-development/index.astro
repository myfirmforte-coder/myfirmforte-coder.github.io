---
// WEB DEVELOPMENT SERVICES — /services/web-development/
// (Purana URL /services/rank-ready-website-design/ yahan redirect hota hai.)
// Saara text neeche arrays mein hai — wahan se badlein.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import FaqList from '../../../components/FaqList.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import { site } from '../../../data/site';

const problems = [
  { icon: '🎨', title: 'Designed for judges, not search engines', text: 'Awwwards-style sites win design awards and lose organic traffic. Without semantic HTML, proper heading hierarchy, and crawlable structure, Google sees an empty shell where your content should be.' },
  { icon: '🐌', title: 'Core Web Vitals failures killing rankings', text: 'Heavy page builders, uncompressed images, render-blocking scripts. Google penalizes slow sites by pushing them down the SERP. Most Divi, Elementor, and WordPress theme builds fail CWV out of the box.' },
  { icon: '🏗️', title: 'No schema, no entity signals, no architecture', text: "Modern search runs on structured data and semantic relationships. If your pages don't tell Google what they're about in machine-readable terms, you're invisible to rich results, AI Overviews, and entity-based ranking." },
];

const included = [
  { icon: '🧱', title: 'Semantic HTML Architecture', text: 'Properly structured H1-H6 hierarchy, clean article/section tags, accessible landmarks, and a DOM tree search engines can actually parse.' },
  { icon: '⚡', title: 'Core Web Vitals Optimization', text: 'Target: 90+ Lighthouse across LCP, INP, and CLS. Optimized images (WebP/AVIF), lazy loading, deferred scripts, and preloaded critical assets.' },
  { icon: '🧩', title: 'Schema Markup (JSON-LD)', text: 'Organization, WebSite, WebPage, Service, LocalBusiness, Article, FAQPage, BreadcrumbList, and Review schemas configured per page type.' },
  { icon: '📱', title: 'Mobile-First, Fully Responsive', text: 'Designed mobile-up, not desktop-down. Every breakpoint tested. Touch targets, font sizes, and navigation built around how people actually use phones.' },
  { icon: '🎯', title: 'Conversion-Focused UX', text: 'Hero CTAs above the fold, trust signals placed by decision points, strategic whitespace, and forms engineered for completion rates above industry average.' },
  { icon: '♿', title: 'WCAG 2.2 AA Accessibility', text: 'Color contrast, keyboard navigation, screen reader compatibility, skip links, and ARIA labels — which also happen to correlate with better rankings.' },
  { icon: '📊', title: 'GA4 + GTM + Search Console Setup', text: 'Full analytics stack configured from day one. Event tracking, goal conversions, enhanced measurement, and Google Search Console verified and submitted.' },
  { icon: '🔒', title: 'Security, HTTPS &amp; Hardening', text: 'SSL, HSTS headers, security plugin configuration, login hardening, rate limiting, and regular security scans baked into the handoff checklist.' },
  { icon: '✍️', title: 'SEO-Ready Content CMS', text: 'A content management system your team can actually use — with built-in fields for meta titles, descriptions, schema, OG images, and custom excerpts.' },
];

const steps = [
  { title: 'Discovery &amp; SEO Audit', text: "Kickoff call, goal alignment, brand review, competitor analysis, and a full audit of your current site's ranking opportunities and technical state." },
  { title: 'Strategy &amp; Wireframes', text: 'Keyword research, information architecture, sitemap, page-by-page content strategy, and lo-fi wireframes approved before a single pixel gets designed.' },
  { title: 'Design &amp; Copywriting', text: 'High-fidelity designs in Figma with component systems for consistency. Copy written or polished by our team around target keywords and user intent.' },
  { title: 'Development &amp; QA', text: 'Semantic build, schema implementation, Core Web Vitals optimization, cross-browser testing, accessibility audit, and staging-environment review.' },
  { title: 'Launch &amp; 30-Day Support', text: 'DNS cutover, 301 redirect mapping, Search Console submission, GA4 validation, and 30 days of post-launch support to catch anything the wild finds.' },
];

const matters = [
  { title: 'Page experience is now a real ranking factor', text: "Google's page experience update rolled into core ranking back in 2021, but the weight has only grown. Core Web Vitals — LCP (Largest Contentful Paint), INP (Interaction to Next Paint), and CLS (Cumulative Layout Shift) — are now table stakes. Sites that fail any of the three get quietly demoted in competitive SERPs. We build every Rank-Ready site to pass all three with room to spare." },
  { title: 'Structured data is the language of modern search', text: 'Rich results, People Also Ask, AI Overviews, and entity understanding all rely on <strong>structured data</strong>. A site without schema markup is a site that Google (and ChatGPT, and Perplexity) struggles to fully understand. Every page on a Rank-Ready build ships with the correct JSON-LD schema for its purpose.' },
  { title: "Mobile-first indexing isn't optional anymore", text: 'Google indexes the mobile version of your site by default — and has since 2019. If your site looks great on desktop but your mobile experience is an afterthought, every ranking signal Google evaluates is coming from the weaker version of your site. We design mobile-first, period.' },
  { title: 'E-E-A-T is baked into how your site is built', text: "Experience, Expertise, Authoritativeness, and Trustworthiness aren't just content guidelines — they're architectural decisions. Author bylines, bio schema, case studies, security indicators, and credential markup all signal E-E-A-T to Google. We build these signals in from day one, not as a retrofit." },
];

const facts = [
  { value: '53%', label: 'of users abandon a site that takes over 3 seconds to load' },
  { value: '75%', label: 'of people never scroll past the first page of search results' },
  { value: '3.5×', label: 'higher engagement on sites that meet all Core Web Vitals thresholds' },
  { value: '+42%', label: 'avg. traffic lift after semantic rebuild vs. cosmetic redesign' },
];

const audience = [
  { icon: '⚖️', title: 'Professional Services', text: 'Law firms, accountants, consultants, and agencies where organic search is a primary lead channel.' },
  { icon: '🏥', title: 'Healthcare &amp; Dental', text: 'Medical practices, dental groups, cosmetic clinics, and specialists competing in local markets.' },
  { icon: '🏠', title: 'Home &amp; Local Services', text: "Plumbing, HVAC, roofing, landscaping, and any business where 'near me' searches drive revenue." },
  { icon: '🛒', title: 'E-commerce &amp; DTC', text: 'Shopify, WooCommerce, and headless brands where category and product pages must rank on commercial keywords.' },
  { icon: '🚀', title: 'B2B &amp; SaaS', text: 'Software companies and B2B service brands competing in content-heavy, high-intent keyword landscapes.' },
  { icon: '🏢', title: 'Multi-Location Brands', text: 'Franchise groups, regional chains, and national brands needing scalable architectures for 10+ location pages.' },
];

const faqs = [
  { q: 'How long does a Rank-Ready website take to build?', a: 'Most projects ship in <strong>6-8 weeks</strong> from kickoff to launch. Timeline depends on scope (number of pages, custom functionality, content availability). Very simple sites can ship in 4 weeks; larger enterprise builds may run 10-12 weeks. You’ll get a firm timeline in the proposal — we don’t sandbag and we don’t miss dates.' },
  { q: 'What platforms do you build on?', a: 'Our default stack is <strong>WordPress with Divi</strong> (which is what rank-ready.com is built on) because it gives clients real content control without developer dependence. We also build on <strong>Webflow</strong>, <strong>Shopify</strong> (for e-commerce), and custom Next.js/headless stacks for enterprise clients with specific performance or integration needs. We’ll recommend the right platform based on your use case — not based on what’s easiest for us.' },
  { q: 'Do you migrate content from my existing site?', a: 'Yes. <strong>Full content migration is included</strong> for sites up to 50 pages or posts. Larger migrations are scoped separately but handled the same way: we preserve URL structure where possible, build a full 301 redirect map for any URLs that change, and verify no rankings are lost in the move. You don’t need to copy-paste anything.' },
  { q: 'Do you write copy or just design the layouts?', a: 'Both options exist. Most Rank-Ready builds include <strong>professional SEO copywriting</strong> for core pages (home, about, services, contact) — written around keyword research and buyer intent. If you’d prefer to write copy yourself or already have a copywriter, we design templates that support your process and optimize whatever content you provide.' },
  { q: 'What happens to SEO after the site launches?', a: 'Two options. <strong>Option A (DIY):</strong> You get detailed handoff documentation, training videos, and a 30-day support window to answer questions as you manage SEO in-house. <strong>Option B (Managed):</strong> We roll you into our Semantic SEO or GMB management retainer, which starts at a fraction of agency rates because the foundation is already optimized. Either way, the site ships with enough built-in SEO to rank well for months before any additional work is needed.' },
  { q: 'Who owns the website after launch?', a: 'You do. Fully. <strong>Zero vendor lock-in.</strong> All source code, design files, CMS access, hosting credentials, and analytics dashboards are yours. You can move to a different agency, take the work in-house, or hand the keys to your cousin who codes — and everything will still work because it’s built on standard tooling, not proprietary nonsense.' },
  { q: 'How many pages does a typical build include?', a: 'The default <strong>Rank-Ready Growth package</strong> includes up to 10 pages (home, about, 3-6 service pages, contact, 1-2 resource pages, and a blog landing page). Most professional services and local businesses fit within this scope. Additional pages, location pages, and e-commerce catalogs are scoped as add-ons with transparent per-page pricing.' },
  { q: 'How many revisions are included?', a: 'We work iteratively, not in ‘revision rounds.’ Every phase (wireframes, design, development) has a structured feedback loop where you review, comment, and we iterate until the phase is approved before moving to the next. Major scope changes after approval trigger a change-order conversation — but we’ve never had a client feel they ran out of revisions.' },
  { q: 'Is ongoing hosting or maintenance included?', a: 'Hosting is <strong>not included</strong> — you own your hosting account on Cloudways, Kinsta, WP Engine, or wherever you prefer. We’ll set it up and configure it, but the bill is yours. <strong>Maintenance</strong> (plugin updates, security patches, backups, minor edits) is offered as an optional monthly retainer starting at $150/month.' },
];

const related = [
  { icon: '🧠', color: 'green', title: 'Semantic SEO', text: 'Content and entity-driven SEO to dominate your topical niche once the site is live.', href: '/services/semantic-seo/' },
  { icon: '🚀', color: 'purple', title: 'AI &amp; GEO Optimization', text: 'Get cited by ChatGPT, Perplexity, and Google AI Overviews — the new search frontier.', href: '/services/ai-geo-optimization/' },
  { icon: '📊', color: 'dark', title: 'Free SEO &amp; GEO Audit', text: "Know exactly what's holding your current site back — and what it would take to fix it.", href: '/services/seo-audits/' },
];

const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Rank-Ready Web Development Services',
  serviceType: 'SEO-first website design and development',
  provider: { '@type': 'ProfessionalService', name: site.name, url: Astro.site?.toString() },
  areaServed: 'Worldwide',
};
---
<BaseLayout
  title="Rank-Ready Web Development Services | SEO-First Websites | Rank Ready"
  description="Web development services built for SEO, speed, and conversions. Custom WordPress, Webflow, & headless builds with scalable architecture and full ownership."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceSchema)} />

  <!-- 1. HERO -->
  <section class="sec w-hero">
    <div class="bg" aria-hidden="true"><div class="g1"></div><div class="g2"></div><div class="gl"></div></div>
    <div class="row hero-row inner">
      <div>
        <div class="badge"><span class="dot"></span>RANK-READY WEBSITE DESIGN</div>
        <h1>Websites that come <span class="grad">pre-ranked.</span></h1>
        <p class="lead">Most agencies design a pretty website, hand you the keys, and wish you luck with SEO. We build the two things as one thing — so your site ranks from the day it goes live, not six months later.</p>
        <div class="rr-btn-group">
          <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Get a Free Strategy Call</span><span class="rr-btn-arrow">→</span></a>
          <a href="/contact/" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Request a Quote</span><span class="rr-btn-arrow">→</span></a>
        </div>
      </div>
      <div>
        <div class="result-card">
          <div class="rc-g1"></div><div class="rc-g2"></div>
          <div class="rc-in">
            <div class="rc-lbl">AVERAGE CLIENT RESULT</div>
            <div class="rc-val grad">4.2×</div>
            <div class="rc-title">avg. organic traffic lift within 90 days of launch</div>
            <div class="rc-note">measured across 40+ Rank-Ready website builds since 2022</div>
            <div class="rc-foot">
              <div class="avs"><span class="av a1">JS</span><span class="av a2">SK</span><span class="av a3">DP</span></div>
              <div class="rc-trust">Trusted by 500+ clients since 2018</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. THE PROBLEM -->
  <section class="sec w-problem">
    <SectionHeading
      eyebrow="THE PROBLEM WITH MOST WEBSITES"
      title="A beautiful website that doesn’t rank is a very expensive brochure."
      sub="If you’ve built a site in the last 3 years and your traffic didn’t move, this is why."
    />
    <div class="row grid g-3">
      {problems.map((p) => (
        <div class="prob">
          <div class="prob-ico">{p.icon}</div>
          <div class="c-title">{p.title}</div>
          <div class="c-text">{p.text}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. WHAT'S INCLUDED -->
  <section class="sec w-incl">
    <SectionHeading
      eyebrow="WHAT’S INCLUDED"
      title="Every site we ship includes all of this. No upsells."
      sub="When we say ‘Rank-Ready,’ we mean it. Here’s exactly what you get with every website design engagement — not as add-ons, but built into the foundation."
    />
    <div class="row grid g-3 gap57">
      {included.map((f) => (
        <div class="feat">
          <div class="feat-ico">{f.icon}</div>
          <div class="f-title" set:html={f.title} />
          <div class="f-text">{f.text}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. HOW IT WORKS -->
  <section class="sec w-how">
    <SectionHeading
      eyebrow="HOW IT WORKS"
      title="From discovery call to ranking site in 6-8 weeks."
      sub="A transparent 5-phase process. No surprise timelines, no mystery deliverables — you’ll know exactly what’s happening and why, every single week."
    />
    <div class="row grid g-5">
      {steps.map((s, i) => (
        <div class="step">
          <div class="num">{String(i + 1).padStart(2, '0')}</div>
          <div class="f-title" set:html={s.title} />
          <div class="f-text">{s.text}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. WHY THIS MATTERS -->
  <section class="sec w-why">
    <div class="row row-narrow why-text">
      <p class="eyebrow" style="margin-bottom:14px">WHY THIS MATTERS IN 2026</p>
      <h2>The gap between ‘has a website’ and ‘has a ranking website’ has never been wider.</h2>
      <div class="article">
        {matters.map((m) => (<><h3>{m.title}</h3><p set:html={m.text} /></>))}
      </div>
    </div>
    <div class="row facts-row">
      <div class="facts">
        {facts.map((f) => (
          <div class="fact">
            <div class="fact-val grad">{f.value}</div>
            <div class="fact-lbl">{f.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. IS THIS FOR YOU -->
  <section class="sec w-who">
    <SectionHeading
      eyebrow="IS THIS FOR YOU?"
      title="Who gets the most from a Rank-Ready website."
      sub="We’re selective about who we work with — not because the service is niche, but because we do our best work with businesses that actually want to rank and are willing to invest in a real foundation."
    />
    <div class="row grid g-3 gap57">
      {audience.map((a) => (
        <div class="aud">
          <div class="aud-ico">{a.icon}</div>
          <div class="aud-title" set:html={a.title} />
          <div class="aud-text">{a.text}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 7. FEATURED RESULT -->
  <section class="sec w-result">
    <div class="row feat-row">
      <div class="fr-card">
        <div class="fr-g1"></div><div class="fr-g2"></div>
        <div class="fr-grid">
          <div>
            <div class="rc-lbl">FEATURED RESULT</div>
            <div class="fr-val grad">+312%</div>
            <div class="fr-title">organic traffic within 6 months of launch</div>
            <div class="fr-note">Smith &amp; Associates Law · Rank-Ready website rebuild + semantic SEO</div>
          </div>
          <div>
            <div class="fr-stars">⭐⭐⭐⭐⭐</div>
            <div class="fr-quote">"We didn't just get a new site — we got a completely different business. Inquiries tripled in four months and our marketing team finally has analytics they can actually use."</div>
            <div class="fr-who">
              <div class="fr-av">JS</div>
              <div><div class="fr-name">John Smith</div><div class="fr-role">Managing Partner, Smith &amp; Associates Law</div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="sec w-faq">
    <SectionHeading
      eyebrow="COMMON QUESTIONS"
      title="Everything you’re probably wondering."
      sub="If your question isn’t here, send it over and we’ll reply in one business day."
    />
    <FaqList faqs={faqs} />
  </section>

  <!-- 9. EXPLORE MORE -->
  <section class="sec w-more">
    <SectionHeading
      eyebrow="EXPLORE MORE"
      title="Services that pair perfectly with this one."
      sub="Most clients start with one service and expand as results come in. Here’s what tends to work well together."
    />
    <div class="row grid g-3">
      {related.map((r) => (
        <a href={r.href} class="rel">
          <div class:list={['rel-ico', r.color]}>{r.icon}</div>
          <div class="rel-title" set:html={r.title} />
          <div class="rel-text">{r.text}</div>
          <div class="rel-more">Learn more →</div>
        </a>
      ))}
    </div>
  </section>

  <!-- 10. CTA -->
  <CtaBanner />
</BaseLayout>

<style>
  .grad { background: linear-gradient(135deg, #10B981 0%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .inner { z-index: 1; }
  .bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .gap57 { row-gap: 57px; }
  section { font-family: var(--inter); }

  /* 1. Hero */
  .w-hero { background: linear-gradient(135deg, #0F172A 0%, #020617 100%); padding: 120px 0; overflow: hidden; }
  .g1 { position: absolute; top: 10%; left: -5%; width: 550px; height: 550px; background: radial-gradient(circle, rgba(16,185,129,.15) 0%, transparent 70%); filter: blur(70px); }
  .g2 { position: absolute; bottom: -15%; right: -5%; width: 650px; height: 650px; background: radial-gradient(circle, rgba(139,92,246,.18) 0%, transparent 70%); filter: blur(80px); }
  .gl { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 60px 60px; -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%); mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%); }
  .hero-row { display: grid; grid-template-columns: 57.8% 36.7%; justify-content: space-between; align-items: start; }
  .badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: rgba(16,185,129,.12); border: 1px solid rgba(16,185,129,.35); border-radius: 100px; font-size: 12px; font-weight: 600; color: var(--green); letter-spacing: 1.5px; line-height: 1.7; margin-bottom: 24px; }
  .dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 12px var(--green); }
  .w-hero h1 { font-size: 64px; font-weight: 800; line-height: 70.4px; letter-spacing: -2px; color: #fff; margin-bottom: 24px; }
  .w-hero .lead { font-size: 19px; line-height: 30.6px; color: var(--slate-300); margin-bottom: 36px; }
  .result-card { background: linear-gradient(135deg, #1E293B 0%, #020617 100%); border: 1px solid rgba(255,255,255,.08); border-radius: 24px; padding: 40px 36px; position: relative; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(0,0,0,.5); }
  .rc-g1 { position: absolute; top: -60px; right: -60px; width: 220px; height: 220px; background: radial-gradient(circle, rgba(16,185,129,.25), transparent 70%); filter: blur(40px); }
  .rc-g2 { position: absolute; bottom: -40px; left: -40px; width: 160px; height: 160px; background: radial-gradient(circle, rgba(139,92,246,.25), transparent 70%); filter: blur(30px); }
  .rc-in { position: relative; }
  .rc-lbl { font-size: 11px; letter-spacing: 2px; color: rgba(255,255,255,.55); font-weight: 600; margin-bottom: 18px; line-height: 1.7; }
  .rc-val { font-size: 84px; font-weight: 800; letter-spacing: -3px; line-height: 1; margin-bottom: 14px; }
  .rc-title { font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 8px; line-height: 1.3; }
  .rc-note { font-size: 13.5px; color: var(--slate-400); line-height: 1.55; }
  .rc-foot { margin-top: 28px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.08); display: flex; align-items: center; gap: 10px; }
  .avs { display: flex; }
  .av { width: 28px; height: 28px; border-radius: 50%; border: 2px solid #0F172A; font-size: 10px; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; }
  .av + .av { margin-left: -8px; }
  .a1 { background: linear-gradient(135deg, #10B981, #8B5CF6); }
  .a2 { background: linear-gradient(135deg, #8B5CF6, #7C3AED); }
  .a3 { background: linear-gradient(135deg, #FBBF24, #F59E0B); }
  .rc-trust { font-size: 12px; color: var(--slate-400); line-height: 1.7; }

  /* 2. Problem */
  .w-problem { background: var(--light-bg); }
  .prob { background: #fff; padding: 36px 32px; border-radius: 16px; border: .8px solid #E2E8F0; }
  .prob-ico { display: inline-flex; width: 48px; height: 48px; background: #FEF2F2; border: 1px solid #FECACA; border-radius: 12px; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 20px; }
  .c-title { font-size: 20px; font-weight: 700; color: var(--navy); line-height: 1.3; margin-bottom: 12px; }
  .c-text { font-size: 15px; color: var(--slate-500); line-height: 1.7; }

  /* 3. Included + 4. Steps */
  .w-incl { background: #fff; padding: 120px 0 100px; }
  .feat { background: #fff; padding: 32px 28px; border-radius: 14px; box-shadow: 6px 6px 40px 0 rgba(15,23,42,.06); }
  .feat-ico { display: inline-flex; width: 52px; height: 52px; background: linear-gradient(135deg, #10B981, #059669); border-radius: 12px; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 20px; color: #fff; box-shadow: 0 8px 20px -6px rgba(16,185,129,.4); }
  .f-title { font-size: 18px; font-weight: 700; color: var(--navy); line-height: 1.35; margin-bottom: 10px; }
  .f-text { font-size: 14.5px; color: var(--slate-500); line-height: 1.7; }
  .w-how { background: var(--light-bg); padding: 120px 0; }
  .num { width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #10B981, #8B5CF6); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 22px; margin-bottom: 18px; letter-spacing: -.5px; box-shadow: 0 10px 24px -8px rgba(16,185,129,.4); }

  /* 5. Why this matters */
  .w-why { background: linear-gradient(135deg, #0F172A 0%, #020617 100%); padding: 120px 0; }
  .why-text { padding-bottom: 30px; }
  .w-why h2 { font-size: 44px; font-weight: 800; line-height: 50.6px; letter-spacing: -1px; color: #fff; margin-bottom: 24px; }
  .article { font-size: 16.5px; color: var(--slate-300); line-height: 1.85; }
  .article h3 { color: #fff; font-size: 22px; font-weight: 700; margin: 30px 0 14px; letter-spacing: -.3px; line-height: 1.3; padding: 0; }
  .article p { padding: 0; }
  .article :global(strong) { color: #fff; }
  .facts-row { max-width: 1100px; padding: 30px 0 0; }
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .fact { padding: 28px; background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; }
  .fact-val { font-size: 40px; font-weight: 800; letter-spacing: -1px; line-height: 1; margin-bottom: 10px; }
