---
// SERVICES PAGE — /services/
// Naya design (home/about jaisa). 6 service cards, method steps, "why us", stats aur FAQs sab neeche arrays mein hain.
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../../components/FaqList.astro';
import { site } from '../../data/site';

// Har service ka card. featured: true = dark green card (GEO). id = page par anchor (#geo waghera).
const services = [
  { id: 'web', icon: 'fas fa-laptop-code', tag: 'FOUNDATION', title: 'Rank-Ready Website Design', href: '/services/web-development/',
    text: 'Most agencies design a pretty site and wish you luck with SEO. We build the two things as one thing — semantic HTML, schema, CWV, and conversion UX baked in from day one.',
    points: ['Semantic architecture &amp; schema markup', 'Core Web Vitals optimized (90+ Lighthouse)', 'SEO-ready CMS with custom fields', '6-8 week timelines, zero vendor lock-in'] },
  { id: 'semantic', icon: 'fas fa-project-diagram', tag: 'AUTHORITY', title: 'Semantic SEO', href: '/services/semantic-seo-optimization-services/',
    text: 'Google stopped matching strings in 2013. We build entity-driven topical authority that ranks for hundreds of related queries per page, not one.',
    points: ['Entity &amp; topical gap research', 'Content architecture &amp; clusters', 'Internal linking &amp; schema strategy', '+312% avg. traffic growth in 6 months'] },
  { id: 'local', icon: 'fas fa-map-marked-alt', tag: 'LOCAL', title: 'Local Landing Pages', href: '/services/local-landing-pages/',
    text: "One city, one service, one page that wins. We've shipped 120+ genuinely unique city pages for multi-location clients — zero duplicate content, full local schema.",
    points: ['Genuinely unique content per city', 'LocalBusiness + Service schema per page', 'NAP consistency across citations', '+480% avg. local pack appearances'] },
  { id: 'gmb', icon: 'fas fa-store', tag: 'LOCAL PACK', title: 'GMB Management', href: '/services/gmb-management-services/',
    text: 'Your Google Business Profile is the most valuable digital real estate you own. We manage every signal Google uses to rank local businesses — end-to-end.',
    points: ['Weekly posts, monthly photo strategy', 'Review acquisition &amp; response system', 'Q&amp;A management, NAP monitoring', '5× avg. call volume in 90 days'] },
  { id: 'geo', icon: 'fas fa-robot', tag: 'NEXT FRONTIER', title: 'AI &amp; GEO Optimization', href: '/services/ai-geo-optimization/', featured: true,
    text: "The next search frontier isn't Google — it's generative engines. We get your brand cited by ChatGPT, Perplexity, Claude, and Google AI Overviews.",
    points: ['Entity establishment across open web', 'AI visibility audits &amp; citation monitoring', 'llms.txt &amp; schema for LLMs', '74% avg. AI citation rate in 90 days'] },
  { id: 'audits', icon: 'fas fa-search', tag: 'DIAGNOSTIC', title: 'SEO + GEO Audits', href: '/services/seo-audits/',
    text: 'Senior-led audits that actually diagnose the problem. No 80-page PDFs full of noise — just focused findings, a prioritized action plan, and a path forward.',
    points: ['10 layers: technical, content, semantic, GEO', '48-hour turnaround available', 'Free first audit, no obligation', 'Action plan with impact + effort scoring'] },
];

const method = [
  { title: 'Diagnose first', text: "Every engagement starts with a senior-led audit. We don't recommend services until we've identified what's actually broken, what's underperforming, and where the biggest wins are hiding." },
  { title: "Architect, don't patch", text: 'Most agencies apply surface-level fixes. We build systems — semantic architectures, entity maps, content hierarchies — that compound over time instead of requiring constant re-work.' },
  { title: 'Build for both Google &amp; AI', text: 'Every asset we produce is optimized for traditional SEO AND generative engines. The overlap is significant — and the sites we build rank in Google, get cited by ChatGPT, and appear in Perplexity.' },
  { title: 'Measure what matters', text: "Vanity metrics don't pay the bills. We track rankings, traffic, conversions, and revenue attribution. Monthly reports are plain-English summaries of what moved — not 40-page PDFs nobody reads." },
];

const why = [
  { icon: 'fas fa-project-diagram', title: 'Semantic SEO specialists', text: "While most agencies still chase keywords, we build entity-driven topical authority. It's the only approach that works long-term in 2026." },
  { icon: 'fas fa-robot', title: 'Real GEO expertise', text: "We've been executing GEO since 2023 — not since last month when ChatGPT got popular. We've banked the data, the methodology, and the proven playbooks." },
  { icon: 'fas fa-user-tie', title: 'Senior-led, not junior-dumped', text: 'Every engagement gets senior strategic oversight. No junior teams executing from templates while the senior you signed up for takes the next sales call.' },
  { icon: 'fas fa-bullseye', title: 'Results over reports', text: "Monthly summaries under 5 pages. Quarterly strategy calls. No 40-page PDFs designed to look impressive — just clear updates on what moved and what's next." },
  { icon: 'fas fa-unlock-alt', title: 'Zero vendor lock-in', text: "Everything we build is yours — code, content, schemas, tracking. Move to another agency tomorrow and it all still works. Transparency isn't optional." },
  { icon: 'fas fa-bolt', title: 'Ship velocity', text: "We don't drag out timelines to justify retainers. Websites ship in 6-8 weeks. Audits turn around in 5-7 days. Movement shows up fast, because speed compounds." },
];

const numbers = [
  { value: '+312%', label: 'avg. organic traffic in 6 months' },
  { value: '5×', label: 'call volume lift on GMB clients' },
  { value: '74%', label: 'AI citation rate (GEO clients)' },
  { value: '500+', label: 'clients served since 2018' },
];

const faqs = [
  { q: 'Which service should I start with?', a: 'It depends on where your biggest bottleneck is. If you have a decent site but aren’t ranking, <strong>Semantic SEO or GEO</strong> is usually the right start. If your site itself is the bottleneck (slow, non-semantic, no schema), <strong>Rank-Ready Website Design</strong> has to come first or everything else fights a losing battle. If you’re a local business where the 3-pack drives everything, <strong>GMB Management + Local Landing Pages</strong> is the highest-ROI combo. Not sure? Get a <a href="/services/seo-audits/">free audit</a> and we’ll tell you honestly.' },
  { q: 'Can I hire Rank Ready for just one service, or do I need to commit to everything?', a: 'Just one is fine. Most clients start with one service, see results, and expand from there. The services are designed to work together but they’re also genuinely valuable standalone. We’ll never upsell you into services you don’t need.' },
  { q: "What's your typical engagement model — project or retainer?", a: 'Depends on the service. <strong>Website Design</strong> and <strong>Audits</strong> are fixed-scope projects with a one-time fee. <strong>Semantic SEO, GMB Management, Local Pages, and GEO</strong> are monthly retainers because they require ongoing work to compound. Minimum retainer engagement is 3 months (enough time to see real movement), but most clients stay on for 12+ months because the returns keep growing.' },
  { q: 'How much does each service cost?', a: 'Pricing is based on scope — which depends on your site size, competitive landscape, and business goals. Instead of publishing generic tiers that don’t match your situation, we give every prospect a custom quote after a 30-minute discovery call. That way, you see real numbers for your real business, not made-up package names. <a href="https://calendly.com/rankready/initial-consultation/" target="_blank" rel="noopener">Book a call</a> and you’ll get a quote within 48 hours.' },
  { q: 'Do you work with international clients?', a: 'Yes — we operate globally. We have clients in the US, UK, EU, Australia, UAE, Canada, and South Asia. We work in English-language markets primarily, but we’ve supported multilingual SEO engagements (hreflang strategy, multi-region optimization, localized content) on several enterprise projects. Our team operates across time zones with 24/7 support coverage.' },
  { q: 'How long before I see results?', a: 'It varies by service. <strong>GMB Management</strong> typically shows movement in 30-60 days. <strong>Local Landing Pages</strong> start ranking within 60-90 days of indexation. <strong>Semantic SEO</strong> compounds from month 3 with meaningful traffic lift by month 4-6. <strong>GEO</strong> shows first citations in 30-60 days, durable results by month 4. <strong>Website Design</strong> typically sees 4.2× traffic within 90 days of launch. None of this is instant — SEO is a long game. But we show early indicators so you know it’s working long before the big numbers hit.' },
  { q: "What if we're already working with another SEO agency?", a: 'That’s fine. We’ve taken over from other agencies many times. Our <strong>free audit</strong> is a good neutral starting point — you’ll see what’s working, what isn’t, and what a different approach might unlock. If the audit reveals you’re being well-served, we’ll tell you that too. If it reveals real gaps, you’ll have a clear picture before making any decisions.' },
  { q: 'Do you sign NDAs?', a: 'Always. We also don’t publish client logos or case studies without explicit written permission. The results you see on our site are from clients who opted in — many more fly completely under the radar. We respect discretion.' },
];

---
<BaseLayout
  title="SEO Services | Rank Ready — Semantic SEO, GEO, GMB, Local & Web"
  description="Six integrated services for ranking in Google AND AI. Semantic SEO, GEO, Local Pages, GMB, Web Design, Audits. Pick one or stack them. Free audit."
>
  <!-- 1. HERO -->
  <section class="sv-hero">
    <div class="row hero-grid">
      <div class="hero-copy">
        <p class="kicker">Our Services</p>
        <h1>Six services. <span class="g">One system</span> for ranking.</h1>
        <p class="lead">Every service we offer is part of one integrated system — because SEO in 2026 isn’t about keywords or backlinks or content or GMB or GEO in isolation. It’s about getting all of it working together. Here’s how we do that.</p>
        <div class="btns">
          <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book a Free Strategy Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
          <a href="#services-grid" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Explore Services</span><i class="fas fa-arrow-down rr-btn-arrow"></i></a>
        </div>
      </div>
      <nav class="index" aria-label="Services on this page">
        <div class="ix-h">What we do</div>
        {services.map((s, i) => (
          <a href={'#' + s.id} class="ix-row">
            <span class="ix-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="ix-t" set:html={s.title} />
            {s.featured && <span class="ix-new">NEW</span>}
            <i class="fas fa-arrow-right ix-a"></i>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- 2. NUMBERS -->
  <div class="row stats">
    {numbers.map((n) => (
      <div class="stat">
        <div class="s-v">{n.value}</div>
        <div class="s-l">{n.label}</div>
      </div>
    ))}
  </div>

  <!-- 3. SIX SERVICES -->
  <section class="svcs" id="services-grid">
    <div class="row sec-head">
      <div>
        <p class="eyebrow">PICK YOUR STARTING POINT</p>
        <h2 class="h2">The six services, in plain English.</h2>
      </div>
      <p class="sub">Most clients start with one service, see results, then expand into adjacent areas. Here’s everything we do, with enough detail for you to self-select.</p>
    </div>
    <div class="row svc-grid">
      {services.map((s, i) => (
        <a href={s.href} id={s.id} class:list={['svc', { featured: s.featured }]}>
          <div class="svc-top">
            <div class="svc-ico"><i class={s.icon}></i></div>
            <span class="svc-n">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="svc-tag">{s.tag}{s.featured && <span class="svc-new">NEW · GEO INSIDE</span>}</div>
          <h3 class="svc-title" set:html={s.title} />
          <p class="svc-text">{s.text}</p>
          <ul>
            {s.points.map((p) => <li><i class="fas fa-check"></i><span set:html={p} /></li>)}
          </ul>
          <div class="svc-more">Explore this service <i class="fas fa-arrow-right"></i></div>
        </a>
      ))}
    </div>
  </section>

  <!-- 4. METHOD -->
  <section class="method">
    <div class="row method-grid">
      <div class="method-head">
        <p class="eyebrow">THE RANK READY METHOD™</p>
        <h2 class="h2">How we work across every engagement.</h2>
        <p class="sub">Whether you hire us for one service or all six, the underlying methodology is the same. It’s what makes the results compound.</p>
      </div>
      <ol class="steps">
        {method.map((m, i) => (
          <li class="step">
            <span class="st-n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 set:html={m.title} />
              <p>{m.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. WHY CHOOSE -->
  <section class="why">
    <div class="row">
      <div class="why-card">
        <div class="why-head">
          <p class="eyebrow light">WHY CHOOSE RANK READY</p>
          <h2 class="h2 light">What makes us different from the other 10,000 SEO agencies.</h2>
          <p class="sub light">Six things our clients consistently tell us we do better than every agency they’ve worked with before.</p>
        </div>
        <div class="why-grid">
          {why.map((w) => (
            <div class="reason">
              <div class="r-ico"><i class={w.icon}></i></div>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="faq-sec">
    <div class="row faq-grid">
      <div class="faq-head">
        <p class="eyebrow">COMMON QUESTIONS</p>
        <h2 class="h2">How we work, priced &amp; packaged.</h2>
        <p class="sub">The most common questions we get from founders and marketing leads evaluating whether Rank Ready is the right fit.</p>
        <div class="faq-cta">
          <div class="fc-t">Not sure where to start?</div>
          <p>Get a free audit and we’ll tell you honestly which service will move the needle first.</p>
          <a href="/services/seo-audits/" class="rr-btn rr-btn-primary"><span>Get a Free Audit</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        </div>
      </div>
      <div class="faq-list"><FaqList faqs={faqs} /></div>
    </div>
  </section>

  <!-- 7. FINAL CTA -->
  <section class="final">
    <div class="row final-in">
      <h2>Let’s make you <span class="g">Rank Ready.</span></h2>
      <p>Book a free 30-minute strategy call. No pressure, no pitch — just clear advice on what’s holding your rankings back and how to fix it.</p>
      <div class="btns center">
        <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book Your Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        <a href="/contact/" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Get in Touch</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section { font-family: var(--inter); position: relative; }
  :global(.rr-btn i.rr-btn-arrow) { font-size: 13px; }
  :global(html) { scroll-behavior: smooth; }
  .g { background: linear-gradient(90deg, #6EE7B7 0%, #059669 100%); -webkit-box-decoration-break: clone; box-decoration-break: clone; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: #34D399; }
  .eyebrow { margin-bottom: 14px; padding: 0; }
  .eyebrow.light { color: #6EE7B7; }
  .h2 { font-size: 44px; font-weight: 800; line-height: 1.12; letter-spacing: -1.4px; color: var(--navy); margin-bottom: 20px; padding: 0; }
  .h2.light { color: #fff; }
  .sub { font-size: 17px; line-height: 1.7; color: var(--slate-500); padding: 0; margin: 0; }
  .sub.light { color: var(--slate-300); }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btns.center { justify-content: center; }

  /* 1. Hero */
  .sv-hero { background: linear-gradient(135deg, #0B1224 0%, #020617 100%); padding: 96px 0 150px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 64px; align-items: center; }
  .kicker { font-size: 13px; font-weight: 600; letter-spacing: 1.6px; text-transform: uppercase; color: #6EE7B7; padding: 0 0 0 34px; margin-bottom: 22px; position: relative; }
  .kicker::before { content: ""; position: absolute; left: 0; top: 50%; width: 24px; height: 2px; background: #10B981; }
  .sv-hero h1 { font-size: 60px; font-weight: 800; line-height: 1.06; letter-spacing: -2.2px; color: #fff; margin-bottom: 24px; padding: 0; }
  .lead { font-size: 18px; line-height: 1.7; color: var(--slate-300); margin-bottom: 34px; padding: 0; max-width: 600px; }
  .index { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: 22px; padding: 10px 10px 8px; }
  .ix-h { font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: var(--slate-400); padding: 14px 16px 10px; }
  .ix-row { display: flex; align-items: center; gap: 14px; padding: 15px 16px; border-radius: 12px; color: #E2E8F0; transition: background .25s; }
  .ix-row + .ix-row { border-top: 1px solid rgba(255,255,255,.06); }
  .ix-row:hover { background: rgba(16,185,129,.1); color: #fff; }
  .ix-n { font-size: 13px; font-weight: 700; color: #34D399; width: 22px; }
  .ix-t { font-size: 16px; font-weight: 600; flex: 1; }
  .ix-new { font-size: 10px; font-weight: 700; letter-spacing: 1px; color: #052e22; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; border-radius: 100px; padding: 3px 8px; }
  .ix-a { font-size: 12px; color: var(--slate-400); transition: transform .25s, color .25s; }
  .ix-row:hover .ix-a { transform: translateX(4px); color: #34D399; }

  /* 2. Numbers */
  .stats { position: relative; z-index: 2; margin-top: -70px; background: #fff; border: 1px solid #E2E8F0; border-radius: 20px; box-shadow: 0 30px 60px -30px rgba(15,23,42,.25); display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { padding: 30px 32px; font-family: var(--inter); }
  .stat + .stat { border-left: 1px solid #F1F5F9; }
  .s-v { font-size: 40px; font-weight: 800; letter-spacing: -1.4px; line-height: 1.1; color: var(--navy); }
  .s-l { font-size: 14px; line-height: 1.5; color: var(--slate-500); margin-top: 6px; }

  /* 3. Services */
  .svcs { padding: 110px 0 100px; background: #fff; scroll-margin-top: 40px; }
  .sec-head { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: end; margin-bottom: 52px; }
  .sec-head .h2 { margin-bottom: 0; }
  .svc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .svc { display: flex; flex-direction: column; background: #fff; border: 1px solid #E2E8F0; border-radius: 22px; padding: 34px 34px 30px; color: inherit; scroll-margin-top: 120px; transition: border-color .3s, box-shadow .3s, transform .3s; }
  .svc:hover { border-color: #A7F3D0; transform: translateY(-4px); box-shadow: 0 30px 60px -32px rgba(15,23,42,.28); }
  .svc-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
  .svc-ico { width: 54px; height: 54px; border-radius: 15px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; box-shadow: 0 12px 24px -12px rgba(5,150,105,.6), inset 0 1px 0 rgba(255,255,255,.35); display: flex; align-items: center; justify-content: center; font-size: 21px; }
  .svc-n { font-size: 13px; font-weight: 700; letter-spacing: 1px; color: #CBD5E1; }
  .svc-tag { font-size: 12px; font-weight: 700; letter-spacing: 1.4px; color: #059669; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .svc-new { font-size: 10px; letter-spacing: 1px; color: #fff; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); border-radius: 100px; padding: 3px 9px; }
  .svc-title { font-size: 26px; font-weight: 800; letter-spacing: -.6px; line-height: 1.25; color: var(--navy); margin-bottom: 12px; padding: 0; }
  .svc-text { font-size: 15.5px; line-height: 1.7; color: var(--slate-500); padding: 0; margin-bottom: 22px; }
  .svc ul { list-style: none; margin: 0 0 26px; padding: 20px 0 0; border-top: 1px solid #F1F5F9; display: grid; gap: 11px; }
  .svc li { display: flex; gap: 11px; font-size: 15px; line-height: 1.5; color: #334155; padding: 0; }
  .svc li i { flex: none; width: 20px; height: 20px; margin-top: 1px; border-radius: 50%; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; font-size: 9px; display: flex; align-items: center; justify-content: center; }
  .svc-more { margin-top: auto; font-size: 15px; font-weight: 700; color: #059669; }
  .svc-more i { font-size: 12px; margin-left: 4px; transition: transform .3s; }
  .svc:hover .svc-more i { transform: translateX(5px); }
  .svc.featured { background: linear-gradient(135deg, #064E3B 0%, #065F46 45%, #0F172A 100%); border-color: transparent; }
  .svc.featured .svc-n { color: rgba(255,255,255,.35); }
  .svc.featured .svc-tag { color: #6EE7B7; }
  .svc.featured .svc-title { color: #fff; }
  .svc.featured .svc-text { color: #CBD5E1; }
  .svc.featured ul { border-top-color: rgba(255,255,255,.12); }
  .svc.featured li { color: #E2E8F0; }
  .svc.featured .svc-more { color: #6EE7B7; }

  /* 4. Method */
  .method { padding: 100px 0; background: var(--light-bg); }
  .method-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 72px; align-items: start; }
  .method-head { position: sticky; top: 110px; }
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: none; }
  .step { display: grid; grid-template-columns: 74px 1fr; gap: 10px; padding: 30px 0; border-top: 1px solid #E2E8F0; }
  .step:last-child { border-bottom: 1px solid #E2E8F0; }
  .st-n { font-size: 34px; font-weight: 800; letter-spacing: -1px; line-height: 1; color: #10B981; }
  .step h3 { font-size: 21px; font-weight: 700; color: var(--navy); line-height: 1.3; margin-bottom: 8px; padding: 0; }
  .step p { font-size: 15.5px; line-height: 1.75; color: var(--slate-500); padding: 0; margin: 0; }

  /* 5. Why */
  .why { padding: 100px 0; background: #fff; }
  .why-card { background: linear-gradient(135deg, #064E3B 0%, #065F46 40%, #0F172A 100%); border-radius: 30px; padding: 70px 64px; }
  .why-head { max-width: 700px; margin-bottom: 50px; }
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255,255,255,.12); }
  .reason { padding: 30px 30px 30px 0; border-bottom: 1px solid rgba(255,255,255,.12); }
  .reason:nth-child(3n+2), .reason:nth-child(3n) { padding-left: 30px; border-left: 1px solid rgba(255,255,255,.12); }
  .reason:nth-last-child(-n+3) { border-bottom: 0; padding-bottom: 0; }
  .r-ico { width: 46px; height: 46px; border-radius: 13px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; box-shadow: 0 12px 24px -12px rgba(5,150,105,.6), inset 0 1px 0 rgba(255,255,255,.35); display: flex; align-items: center; justify-content: center; font-size: 17px; margin-bottom: 18px; }
  .reason h3 { font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 8px; padding: 0; line-height: 1.35; }
  .reason p { font-size: 15px; line-height: 1.7; color: #CBD5E1; padding: 0; margin: 0; }

  /* 6. FAQ */
  .faq-sec { padding: 100px 0; background: var(--light-bg); }
  .faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 60px; align-items: start; }
