---
// CONTACT PAGE — /contact/ (new design)
// Phone, email, WhatsApp, Calendly: src/data/site.ts
// Form: agar site.ts mein web3formsKey ho to message seedha email pe aata hai; khali ho to visitor ka email app khulta hai.
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqList from '../../components/FaqList.astro';
import { site } from '../../data/site';

const services = ["I'm not sure yet — need guidance", 'Rank-Ready Website Design', 'Semantic SEO', 'Local Landing Pages', 'GMB Management', 'AI &amp; GEO Optimization', 'SEO Audits'];
const budgets = ['Under $1,000', '$1,000 – $3,000', '$3,000 – $5,000', '$5,000+'];

const channels = [
  { icon: 'fas fa-envelope', label: 'Email us', value: site.email, href: 'mailto:' + site.email },
  { icon: 'fas fa-phone-alt', label: 'Call us', value: site.phone, href: site.phoneLink },
  { icon: 'fab fa-whatsapp', label: 'WhatsApp', value: 'Chat with us now', href: site.whatsapp, ext: true },
  { icon: 'fas fa-globe-americas', label: 'Hours', value: 'Working globally, 24/7' },
];

const steps = [
  { title: 'We read your message', text: 'A senior strategist reviews your site and your goals. Not a sales bot.' },
  { title: 'You hear back within 1 day', text: 'A clear reply with our first thoughts, or a link to book a short call.' },
  { title: 'You get a plan', text: 'A free audit or a written roadmap, so you know exactly what to fix first.' },
];

const reasons = [
  { icon: 'fas fa-user-tie', title: 'Senior expertise', text: '8+ years, 500+ clients, hundreds of rankings earned. You work with the strategists, not trainees.' },
  { icon: 'fas fa-robot', title: 'AI-era ready', text: 'GEO is our specialty. We get clients cited inside ChatGPT, Perplexity and Google AI Overviews.' },
  { icon: 'fas fa-bullseye', title: 'Tailored strategy', text: 'No templates. Every roadmap is built from scratch around your industry, geography and goals.' },
  { icon: 'fas fa-chart-bar', title: '100% transparent', text: 'Monthly reports in plain English. You always know exactly what is being done and what is working.' },
  { icon: 'fas fa-bolt', title: 'Fast turnarounds', text: 'Audits in 48 hours. Strategy in a week. Website builds in 4 to 6 weeks.' },
  { icon: 'fas fa-layer-group', title: 'Built to scale', text: 'Start with one service and grow with us, from a single location to 500+ location brands.' },
];

const faqs = [
  { q: 'How fast do you reply to inquiries?', a: 'Within 1 business day, and usually much faster. You’ll either get a direct response from a senior team member or a Calendly link to book a quick call, depending on what works best for your request.' },
  { q: 'Do I need to have a budget in mind before contacting you?', a: 'No. We work with budgets ranging from small-business one-time audits to enterprise monthly retainers. The budget field on the form just helps us route you to the right conversation.' },
  { q: 'Can I get a free audit without committing to anything?', a: 'Absolutely. Our free SEO + GEO audit is genuinely free and comes with no obligation. Most people who get one use it to fix things on their own, and some come back later when they want help implementing.' },
  { q: 'Do you work with businesses outside the UK and US?', a: 'Yes. We work with clients worldwide and plan calls around your time zone. Email and WhatsApp are always the fastest way to reach us.' },
];
---
<BaseLayout
  title="Contact Rank Ready | Book a Free SEO Consultation"
  description="Book a free 30-min strategy call or send a project brief. Reply within 1 business day. Working globally · 24/7. Email, phone, WhatsApp, or Calendly."
>
  <!-- 1. HERO -->
  <section class="c-hero">
    <div class="row hero-grid">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><i class="fas fa-chevron-right"></i><span>Contact</span></nav>
        <h1>Let’s make your business <span class="g">unignorable.</span></h1>
        <p class="lead">Whether you’re ready to start a project, need a free audit, or just want to sanity-check your current SEO strategy, we’d love to hear from you.</p>
        <div class="btns">
          <a href="#form" class="rr-btn rr-btn-primary rr-btn-lg"><span>Send a Message</span><i class="fas fa-arrow-down rr-btn-arrow"></i></a>
          <a href={site.calendly} class="rr-btn rr-btn-ghost rr-btn-lg" target="_blank" rel="noopener"><span>Book a Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        </div>
        <ul class="h-pills">
          <li><i class="fas fa-bolt"></i>Reply within 1 business day</li>
          <li><i class="fas fa-globe-americas"></i>Working globally, 24/7</li>
          <li><i class="fas fa-lock"></i>No spam, ever</li>
        </ul>
      </div>
      <div class="hero-visual">
        <img src="/images/about/team-2.jpg" alt="The Rank Ready team at work" width="1200" height="900" />
        <div class="h-card">
          <span class="ico"><i class="fas fa-comments"></i></span>
          <div>
            <div class="hc-title">Real people, fast answers</div>
            <div class="hc-text">Every message is read by a senior strategist.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. CHANNELS STRIP -->
  <div class="row channels">
    {channels.map((c) => {
      const inner = (<><span class="ico sm"><i class={c.icon}></i></span><span><span class="ch-lbl">{c.label}</span><span class="ch-val">{c.value}</span></span></>);
      return c.href
        ? <a href={c.href} class="ch" target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>{inner}</a>
        : <div class="ch">{inner}</div>;
    })}
  </div>

  <!-- 3. FORM + SIDE -->
  <section class="form-sec" id="form">
    <div class="row form-grid">
      <div class="form-card">
        <p class="eyebrow">GET IN TOUCH</p>
        <h2 class="h2">Tell us about <span class="g">your project.</span></h2>
        <p class="sub">Share a few details and we’ll get back to you within one business day with a clear next step, usually a quick strategy call or a free audit.</p>

        <form id="contact-form" data-key={site.web3formsKey} data-email={site.email} novalidate>
          <div class="f-row">
            <label class="fld"><span>First name <b>*</b></span><input name="first" placeholder="Jane" required autocomplete="given-name" /></label>
            <label class="fld"><span>Last name <b>*</b></span><input name="last" placeholder="Doe" required autocomplete="family-name" /></label>
          </div>
          <div class="f-row">
            <label class="fld"><span>Email <b>*</b></span><input name="email" type="email" placeholder="you@company.com" required autocomplete="email" /></label>
            <label class="fld"><span>Phone <em>(optional)</em></span><input name="phone" type="tel" placeholder="+1 555 000 0000" autocomplete="tel" /></label>
          </div>
          <label class="fld"><span>Website / Company</span><input name="website" placeholder="yourcompany.com" autocomplete="organization" /></label>
          <div class="f-row">
            <label class="fld"><span>Which service are you interested in?</span>
              <select name="service">{services.map((s) => <option set:html={s} />)}</select>
            </label>
            <label class="fld"><span>Monthly budget range</span>
              <select name="budget">{budgets.map((b) => <option>{b}</option>)}</select>
            </label>
          </div>
          <label class="fld"><span>Tell us about your project</span>
            <textarea name="message" rows="5" placeholder="What are your biggest SEO or visibility challenges right now? What does success look like in one month?"></textarea>
          </label>
          <button type="submit" class="rr-btn rr-btn-primary rr-btn-lg f-btn"><span>Send Message</span><i class="fas fa-paper-plane rr-btn-arrow"></i></button>
          <p class="f-msg" id="f-msg" role="status" hidden></p>
          <p class="f-note"><i class="fas fa-lock"></i>Your details are only used to reply to your enquiry.</p>
        </form>
      </div>

      <aside class="side">
        <div class="avail">
          <img src="/images/services/ent-meet.jpg" alt="" width="800" height="500" loading="lazy" />
          <div class="av-in">
            <div class="av-badge"><span class="dot"></span>Available now</div>
            <div class="av-title">Prefer to skip the form?</div>
            <p>Grab a 30-minute strategy slot on our calendar. No pitch, just honest advice.</p>
            <a href={site.calendly} class="rr-btn rr-btn-primary av-btn" target="_blank" rel="noopener"><span>Book a Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
          </div>
        </div>
        <div class="next">
          <div class="nx-lbl">What happens next</div>
          <ol>
            {steps.map((s, i) => (
              <li><span class="nx-n">{i + 1}</span><div><div class="nx-title">{s.title}</div><div class="nx-text">{s.text}</div></div></li>
            ))}
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <!-- 4. WHY CHOOSE -->
  <section class="why">
    <div class="row">
      <div class="why-card">
        <div class="why-top">
          <div>
            <p class="eyebrow light">WHY CHOOSE RANK READY</p>
            <h2 class="h2 light">Six reasons clients pick us, <span class="g">and stay for years.</span></h2>
          </div>
          <p class="sub light">We’re not the cheapest. We’re not the biggest. But we’re the team most likely to actually move your rankings, and tell you the truth about what it takes.</p>
        </div>
        <div class="why-grid">
          {reasons.map((r) => (
            <div class="reason"><span class="ico"><i class={r.icon}></i></span><h3>{r.title}</h3><p>{r.text}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="faq-sec">
    <div class="row faq-grid">
      <div class="faq-head">
        <p class="eyebrow">QUICK ANSWERS</p>
        <h2 class="h2">Before you <span class="g">send a message.</span></h2>
        <p class="sub">The questions we get most. If yours isn’t covered, just send us a note and we’ll reply fast.</p>
        <div class="faq-cta">
          <span class="ico sm"><i class="fab fa-whatsapp"></i></span>
          <div>
            <div class="fc-title">Need an answer right now?</div>
            <a href={site.whatsapp} target="_blank" rel="noopener">Message us on WhatsApp <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      </div>
      <div class="faq-list"><FaqList faqs={faqs} /></div>
    </div>
  </section>

  <!-- 6. FINAL CTA -->
  <section class="final">
    <div class="row final-in">
      <h2>Let’s make you <span class="g">Rank Ready.</span></h2>
      <p>Book a free 30-minute strategy call. No pressure, no pitch, just clear advice on what is holding your rankings back and how to fix it.</p>
      <div class="btns center">
        <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book Your Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        <a href="/services/seo-audits/" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Get a Free Audit</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const f = document.getElementById('contact-form') as HTMLFormElement;
  const msg = document.getElementById('f-msg') as HTMLElement;
  const val = (n: string) => ((f.elements.namedItem(n) as HTMLInputElement | null)?.value || '').trim();
  const show = (t: string, ok: boolean) => { msg.hidden = false; msg.textContent = t; msg.className = 'f-msg ' + (ok ? 'ok' : 'err'); };
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!val('first') || !val('last') || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(val('email'))) {
      show('Please add your first name, last name and a valid email.', false);
      return;
    }
    const lines = [
      'Name: ' + val('first') + ' ' + val('last'),
      'Email: ' + val('email'),
      'Phone: ' + (val('phone') || '-'),
      'Website / Company: ' + (val('website') || '-'),
      'Service: ' + val('service'),
      'Budget: ' + val('budget'),
      '',
      val('message'),
    ];
    const key = f.dataset.key;
    if (!key) {
      location.href = 'mailto:' + f.dataset.email + '?subject=' + encodeURIComponent('New enquiry from ' + val('first') + ' ' + val('last')) + '&body=' + encodeURIComponent(lines.join('\n'));
      show('Your email app is opening with your message — just press send.', true);
      return;
    }
    const btn = f.querySelector('button') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ access_key: key, subject: 'New website enquiry — ' + val('first') + ' ' + val('last'), from_name: 'Rank Ready website', email: val('email'), message: lines.join('\n') }),
      });
      if (res.ok) { show('Thank you! Your message has been sent — we’ll reply within one business day.', true); f.reset(); }
      else show('Something went wrong. Please email us at ' + f.dataset.email + '.', false);
    } catch { show('Something went wrong. Please email us at ' + f.dataset.email + '.', false); }
    btn.disabled = false;
  });
</script>

<style>
  section, .channels { font-family: var(--inter); position: relative; }
  :global(.rr-btn i.rr-btn-arrow) { font-size: 13px; }
  .g { background: linear-gradient(90deg, #6EE7B7 0%, #059669 100%); -webkit-box-decoration-break: clone; box-decoration-break: clone; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: #34D399; }
  .eyebrow { margin-bottom: 14px; padding: 0; }
  .eyebrow.light { color: #6EE7B7; }
  .h2 { font-size: 44px; font-weight: 800; line-height: 1.12; letter-spacing: -1.4px; color: var(--navy); margin-bottom: 18px; padding: 0; }
  .h2.light { color: #fff; }
  .sub { font-size: 17px; line-height: 1.7; color: var(--slate-500); padding: 0; margin: 0; }
  .sub.light { color: #CBD5E1; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btns.center { justify-content: center; }
  h3 { padding: 0; }
  .ico { flex: none; width: 52px; height: 52px; border-radius: 15px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; box-shadow: 0 12px 24px -12px rgba(5,150,105,.6), inset 0 1px 0 rgba(255,255,255,.35); display: flex; align-items: center; justify-content: center; font-size: 21px; }
  .ico.sm { width: 46px; height: 46px; border-radius: 13px; font-size: 18px; }

  /* 1. Hero */
  .c-hero { background: linear-gradient(135deg, #0B1224 0%, #020617 100%); padding: 90px 0 150px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 64px; align-items: center; }
  .hero-grid > * { min-width: 0; }
  .crumbs { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 24px; color: #6EE7B7; }
  .crumbs a { color: var(--slate-400); }
  .crumbs a:hover { color: #fff; }
  .crumbs i { font-size: 9px; color: var(--slate-500); }
  .c-hero h1 { font-size: 60px; font-weight: 800; line-height: 1.06; letter-spacing: -2.2px; color: #fff; margin-bottom: 24px; padding: 0; }
  .lead { font-size: 18px; line-height: 1.7; color: var(--slate-300); margin-bottom: 34px; padding: 0; max-width: 580px; }
  .h-pills { list-style: none; margin: 30px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .h-pills li { display: flex; align-items: center; gap: 9px; font-size: 14.5px; font-weight: 600; color: #CBD5E1; }
  .h-pills i { color: #6EE7B7; font-size: 13px; }
  .hero-visual { position: relative; padding-bottom: 36px; }
  .hero-visual img { display: block; width: 90%; margin-left: auto; aspect-ratio: 4 / 3.3; object-fit: cover; border-radius: 22px; }
  .h-card { position: absolute; left: 0; bottom: 0; display: flex; align-items: center; gap: 16px; background: #fff; border-radius: 18px; padding: 20px 24px; max-width: 340px; box-shadow: 0 30px 60px -24px rgba(2,6,23,.6); }
  .hc-title { font-size: 16px; font-weight: 700; color: var(--navy); margin-bottom: 3px; }
  .hc-text { font-size: 13.5px; color: var(--slate-500); line-height: 1.5; }

  /* 2. Channels */
  .channels { z-index: 2; margin-top: -70px; background: #fff; border: 1px solid #E2E8F0; border-radius: 20px; box-shadow: 0 30px 60px -30px rgba(15,23,42,.25); display: grid; grid-template-columns: repeat(4, 1fr); }
  .ch { display: flex; align-items: center; gap: 16px; padding: 26px 26px; transition: background .25s; min-width: 0; }
  .ch + .ch { border-left: 1px solid #F1F5F9; }
  a.ch:hover { background: #F8FAFC; }
  .ch > span:last-child { min-width: 0; }
  .ch-lbl { display: block; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--slate-400); margin-bottom: 3px; }
  .ch-val { display: block; font-size: 15.5px; font-weight: 700; color: var(--navy); overflow-wrap: anywhere; }

  /* 3. Form */
  .form-sec { padding: 100px 0; background: #fff; scroll-margin-top: 80px; }
  .form-grid { display: grid; grid-template-columns: 1.35fr .9fr; gap: 48px; align-items: start; }
  .form-card { background: #fff; border: 1px solid #E2E8F0; border-radius: 26px; padding: 48px; box-shadow: 0 30px 60px -40px rgba(15,23,42,.3); }
  .form-card .sub { margin-bottom: 32px; }
  form { display: grid; gap: 18px; }
  .f-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .fld { display: grid; gap: 8px; }
  .fld > span { font-size: 14px; font-weight: 600; color: #334155; }
  .fld b { color: #DC2626; font-weight: 700; }
  .fld em { font-style: normal; font-weight: 500; color: var(--slate-400); }
  .fld input, .fld select, .fld textarea { width: 100%; font: inherit; font-size: 15px; color: var(--navy); background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; padding: 13px 15px; outline: 0; transition: border-color .25s, box-shadow .25s, background .25s; box-sizing: border-box; }
  .fld textarea { resize: vertical; min-height: 130px; }
  .fld input:focus, .fld select:focus, .fld textarea:focus { background: #fff; border-color: #6EE7B7; box-shadow: 0 0 0 4px rgba(16,185,129,.12); }
  .f-btn { justify-self: start; margin-top: 6px; }
  .f-msg { font-size: 15px; font-weight: 600; border-radius: 12px; padding: 13px 16px; margin: 0; }
  .f-msg.ok { background: #ECFDF5; color: #047857; }
  .f-msg.err { background: #FEF2F2; color: #B91C1C; }
  .f-note { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--slate-400); padding: 0; margin: 0; }
  .f-note i { color: #059669; }
  .side { display: grid; gap: 20px; position: sticky; top: 110px; }
  .avail { background: linear-gradient(135deg, #064E3B 0%, #065F46 40%, #0F172A 100%); border-radius: 24px; overflow: hidden; color: #fff; }
  .avail img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .av-in { padding: 28px; }
  .av-badge { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #6EE7B7; margin-bottom: 12px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #34D399; box-shadow: 0 0 0 4px rgba(52,211,153,.2); }
  .av-title { font-size: 24px; font-weight: 800; letter-spacing: -.6px; margin-bottom: 8px; }
  .av-in p { font-size: 15px; line-height: 1.65; color: #CBD5E1; padding: 0; margin: 0 0 22px; }
  .av-btn { width: 100%; justify-content: center; }
  .next { border: 1px solid #E2E8F0; border-radius: 24px; padding: 28px; }
  .nx-lbl { font-size: 12px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; color: #059669; margin-bottom: 18px; }
  .next ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; position: relative; }
  .next li { display: flex; gap: 16px; }
  .nx-n { flex: none; width: 34px; height: 34px; border-radius: 10px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; font-weight: 800; font-size: 14px; display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 20px -10px rgba(5,150,105,.6); }
  .nx-title { font-size: 16px; font-weight: 700; color: var(--navy); margin-bottom: 3px; }
  .nx-text { font-size: 14px; line-height: 1.6; color: var(--slate-500); }

  /* 4. Why */
  .why { padding: 0 0 100px; background: #fff; }
  .why-card { background: linear-gradient(135deg, #064E3B 0%, #065F46 40%, #0F172A 100%); border-radius: 30px; padding: 70px 64px; }
  .why-top { display: grid; grid-template-columns: 1.1fr .9fr; gap: 50px; align-items: end; margin-bottom: 46px; }
  .why-top .h2 { margin-bottom: 0; }
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255,255,255,.12); }
  .reason { padding: 34px 34px 34px 34px; border-left: 1px solid rgba(255,255,255,.12); border-bottom: 1px solid rgba(255,255,255,.12); }
  .reason:nth-child(3n+1) { padding-left: 0; border-left: 0; }
  .reason:nth-child(3n) { padding-right: 0; }
  .reason:nth-last-child(-n+3) { border-bottom: 0; padding-bottom: 0; }
  .reason .ico { margin-bottom: 20px; }
  .reason h3 { font-size: 20px; font-weight: 700; color: #fff; margin-bottom: 10px; line-height: 1.35; }
  .reason p { font-size: 15px; line-height: 1.75; color: #CBD5E1; padding: 0; margin: 0; }

  /* 5. FAQ */
  .faq-sec { padding: 100px 0; background: var(--light-bg); }
  .faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 60px; align-items: start; }
  .faq-head { position: sticky; top: 110px; }
  .faq-head .sub { margin-bottom: 28px; }
  .faq-cta { display: flex; align-items: center; gap: 16px; background: #fff; border: 1px solid #E2E8F0; border-radius: 20px; padding: 22px; }
  .fc-title { font-size: 16px; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
  .faq-cta a { font-size: 14.5px; font-weight: 700; color: #059669; }
  .faq-cta a i { font-size: 11px; margin-left: 4px; }
  .faq-list :global(.row) { width: 100%; max-width: none; padding: 0; }

  /* 6. Final */
  .final { background: linear-gradient(135deg, #020617 0%, #0F172A 50%, #064E3B 100%); padding: 120px 0; }
