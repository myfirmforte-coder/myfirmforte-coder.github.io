---
// ABOUT US PAGE — /about-us/
// Text, team members, values sab neeche arrays mein hain. Wahan se badlein.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';

const stats = [
  { value: '8+', label: 'Years helping businesses rank higher', style: 'dark', color: 'grad' },
  { value: '500+', label: 'Happy clients served globally', style: 'light', color: '#10B981' },
  { value: '15+', label: 'Industries we specialize in', style: 'light', color: '#8B5CF6' },
  { value: '★ 4.9', label: 'Average client rating since day one', style: 'dark', color: '#FBBF24', small: true },
];

const values = [
  { icon: 'fab fa-codepen', title: 'Honest Pricing', text: 'Fair, transparent rates with no hidden fees. You’ll always know exactly what you’re paying for — and why it’s worth it.' },
  { icon: 'fas fa-poll', title: 'Real Results', text: 'Rankings, traffic, and revenue — not vanity metrics. Every engagement tied to outcomes your business actually cares about.' },
  { icon: 'fas fa-handshake', title: 'Partnership First', text: 'We’re not a vendor you manage — we’re an extension of your team. Long-term relationships, not one-off transactions.' },
];

// Team: naya member add karna ho to yahan ek line add karein. accent: 'green' ya 'purple'.
const team = [
  { initials: 'L', role: 'FOUNDER', name: 'Lareb', accent: 'green', linkedin: '#', x: '#', facebook: '#' },
  { initials: 'US', role: 'MANAGING DIRECTOR', name: 'Umair Sabir', accent: 'purple', linkedin: '#', x: '#', facebook: '#' },
  { initials: 'SH', role: 'DIGITAL MARKETER', name: 'Shahroz Hassan', accent: 'green', linkedin: '#', x: '#', facebook: '#' },
  { initials: 'MZ', role: 'PROJECT MANAGER', name: 'Mehmood Zaigham', accent: 'purple', linkedin: '#', x: '#', facebook: '#' },
  { initials: 'MZ', role: 'Social Media Strategist', name: 'Muhammad Zeeshan', accent: 'green', linkedin: '#', x: '#', facebook: 'https://www.facebook.com/share/1C7gKU2apa/' },
  { initials: 'F', role: 'UI/UX DESIGNER', name: 'Farran', accent: 'purple', linkedin: '#', x: '#', facebook: '#' },
];

const reasons = [
  [
    { icon: '⚡', color: 'green', title: 'Senior-Only Team', text: 'Every client is served by senior strategists with 5+ years of experience. No juniors practicing on your site.' },
    { icon: '🎯', color: 'purple', title: 'GEO-First Thinking', text: "We're already doing AI search optimization while most agencies are still arguing about keyword density." },
    { icon: '📊', color: 'green', title: 'Transparent Reporting', text: "Monthly reports that show exactly what moved, what didn't, and what's next. No jargon. No smoke." },
  ],
  [
    { icon: '🌍', color: 'purple', title: 'Global Clients, Global Standards', text: 'Serving clients across the US, UK, Canada, Australia, EU, and the Middle East — remote-first, always on.' },
    { icon: '💡', color: 'green', title: 'Semantic-First SEO', text: 'Entity-driven architecture, not keyword stuffing. The only way to win modern search engines.' },
    { icon: '✋', color: 'purple', title: 'No Long-Term Lock-ins', text: 'Month-to-month retainers. Stay because the work is worth it — not because you signed a 12-month contract.' },
  ],
];
---
<BaseLayout
  title="About Rank Ready | Global SEO & GEO Agency Since 2018"
  description="Global SEO agency since 2018. 500+ clients across legal, healthcare, home services, SaaS. Senior-led, no junior dump, zero vendor lock-in. Meet the team."
>
  <!-- 1. HERO -->
  <section class="sec a-hero">
    <div class="bg" aria-hidden="true"><div class="g1"></div><div class="g2"></div><div class="gl"></div></div>
    <div class="row center inner">
      <div class="badge-wrap"><div class="badge"><span class="dot"></span>ABOUT RANK READY</div></div>
      <h1>Eight years of helping businesses <span class="grad">dominate search.</span></h1>
      <p class="lead">We’re a small, senior team obsessed with one thing: making your business the obvious choice when someone searches for what you do — on Google, on ChatGPT, and everywhere in between.</p>
    </div>
  </section>

  <!-- 2. WHO WE ARE -->
  <section class="sec who">
    <div class="row who-row">
      <div>
        <p class="eyebrow" style="margin-bottom:16px">WHO WE ARE</p>
        <h2>Small team. <span style="color:#10B981">Senior work.</span> Honest pricing.</h2>
        <div class="body">
          <p>Rank Ready has been helping businesses grow online for over 8 years. We built our reputation as a Top-Rated Seller on Fiverr — serving hundreds of clients globally — before transitioning into a full-service SEO and GEO agency.</p>
          <p>We’re intentionally small. No account executives, no bloated agency overhead, no juniors doing senior work. When you hire us, you get the actual people doing the strategy, writing the content, and shipping the results.</p>
          <p>We believe in transparent pricing, real deliverables, and work you can verify — not retainers that disappear into black boxes.</p>
        </div>
        <div class="rr-btn-group">
          <a href={site.calendly} class="rr-btn rr-btn-primary" target="_blank" rel="noopener"><span>Work With Us</span><span class="rr-btn-arrow">→</span></a>
          <a href="/case-studies/" class="rr-btn rr-btn-outline"><span>See Our Work</span><span class="rr-btn-arrow">→</span></a>
        </div>
      </div>
      <div class="stats">
        {stats.map((s) => (
          <div class:list={['stat', s.style]}>
            <div class:list={['val', { grad: s.color === 'grad', small: s.small }]} style={s.color !== 'grad' ? `color:${s.color}` : undefined}>{s.value}</div>
            <div class="lbl">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. OUR MISSION -->
  <section class="sec mission">
    <SectionHeading
      eyebrow="OUR MISSION"
      title="Quality digital work shouldn’t be a luxury."
      sub="We believe every business — whether a one-person law firm or a 50-person SaaS — deserves access to real, results-driven SEO and website work. Not inflated retainers. Not cookie-cutter templates. Not promises that never materialize."
    />
    <div class="row grid g-3">
      {values.map((v) => (
        <div class="vcard">
          <i class={v.icon}></i>
          <h3>{v.title}</h3>
          <p>{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. OUR TEAM -->
  <section class="sec team">
    <SectionHeading
      eyebrow="OUR TEAM"
      title="The people doing the work."
      sub="Every Rank Ready client works directly with senior strategists. No outsourced handoffs. No account managers you’ve never spoken to making decisions for you."
    />
    <div class="row grid g-3 team-grid">
      {team.map((m) => (
        <div class="member">
          <div class:list={['photo', m.accent]}>
            <div class="photo-grid"></div>
            <div class="avatar">{m.initials}</div>
          </div>
          <div class="info">
            <div class="role">{m.role}</div>
            <div class="name">{m.name}</div>
            <div class="socials">
              <a href={m.linkedin} aria-label="LinkedIn">in</a>
              <a href={m.x} aria-label="X">𝕏</a>
              <a href={m.facebook} aria-label="Facebook" target={m.facebook !== '#' ? '_blank' : undefined} rel="noopener">f</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. WHY RANK READY -->
  <section class="sec why on-dark">
    <SectionHeading
      eyebrow="WHY RANK READY"
      title="Most agencies sell retainers. We sell results."
      sub="Six things that separate us from the typical SEO shop — and why our clients stay for years."
    />
    <div class="row grid g-2 why-row">
      {reasons.map((col) => (
        <div class="why-col">
          {col.map((r) => (
            <div class="reason">
              <div class:list={['r-ico', r.color]}>{r.icon}</div>
              <div>
                <div class="r-title">{r.title}</div>
                <div class="r-text">{r.text}</div>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- 6. FINAL CTA -->
  <section class="sec a-cta">
    <div class="bg" aria-hidden="true"><div class="c1"></div><div class="c2"></div></div>
    <div class="row row-narrow center inner">
      <h2>Let’s make you <span class="grad">Rank Ready.</span></h2>
      <p class="lead">Book a free 30-minute strategy call. No pressure, no pitch — just clear advice on what’s holding your rankings back and how to fix it.</p>
      <div class="rr-btn-group" style="justify-content:center">
        <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book Your Free Call</span><span class="rr-btn-arrow">→</span></a>
        <a href="/contact/" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Get in Touch</span><span class="rr-btn-arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .grad { background: linear-gradient(135deg, #10B981 0%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .inner { z-index: 1; }
  .bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }

  /* 1. Hero */
  .a-hero { background: linear-gradient(135deg, #0F172A 0%, #020617 100%); padding: 120px 0 100px; font-family: var(--inter); }
  .a-hero .row { max-width: 1100px; }
  .g1 { position: absolute; top: 10%; left: -10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(16,185,129,.12) 0%, transparent 70%); filter: blur(60px); }
  .g2 { position: absolute; bottom: -20%; right: -10%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(139,92,246,.15) 0%, transparent 70%); filter: blur(80px); }
  .gl { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 60px 60px; -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%); mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%); }
  .badge-wrap { display: flex; justify-content: center; margin-bottom: 24px; }
  .badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: rgba(16,185,129,.12); border: 1px solid rgba(16,185,129,.35); border-radius: 100px; font-size: 12px; font-weight: 600; color: var(--green); letter-spacing: 1.5px; line-height: 1.7; }
  .dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 12px var(--green); }
  .a-hero h1 { font-size: 68px; font-weight: 800; line-height: 74.8px; letter-spacing: -2px; color: #fff; margin-bottom: 24px; }
  .a-hero .lead { max-width: 720px; margin: 0 auto; font-size: 19px; line-height: 30.6px; color: var(--slate-300); }

  /* 2. Who we are */
  .who { background: #fff; padding: 120px 0 100px; font-family: var(--inter); }
  .who-row { display: grid; grid-template-columns: 1fr 1fr; column-gap: 8%; align-items: start; }
  .who h2 { font-size: 44px; font-weight: 800; line-height: 50.6px; letter-spacing: -1px; color: var(--navy); margin-bottom: 24px; }
  .who .body { font-size: 17px; line-height: 30.6px; color: var(--slate-500); margin-bottom: 24px; }
  .who .body p { padding-bottom: 17px; }
  .who .body p:last-child { padding-bottom: 0; }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .stat { padding: 32px 24px; border-radius: 16px; }
  .stat.dark { background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); }
  .stat.light { background: var(--light-bg); border: 1px solid #E2E8F0; }
  .val { font-size: 48px; font-weight: 800; letter-spacing: -1px; line-height: 1; margin-bottom: 10px; }
  .val.small { font-size: 40px; }
  .lbl { font-size: 14px; line-height: 1.5; color: var(--slate-500); }
  .dark .lbl { color: var(--slate-400); }

  /* 3. Mission */
  .mission { background: var(--light-bg); padding: 120px 0; }
  .vcard { background: #fff; padding: 36px 28px; border-radius: 16px; box-shadow: 6px 6px 40px 0 rgba(15,23,42,.06); font-family: var(--inter); }
  .vcard i { display: block; font-size: 47px; color: var(--green); margin-bottom: 30px; }
  .vcard h3 { font-size: 20px; font-weight: 700; line-height: 20px; color: var(--navy); margin-bottom: 12px; }
  .vcard p { font-size: 15px; line-height: 30.6px; color: var(--slate-500); }

  /* 4. Team */
  .team { background: #fff; padding: 120px 0; }
  .team-grid { row-gap: 57px; }
  .member { background: #fff; border-radius: 16px; box-shadow: 6px 6px 40px 0 rgba(15,23,42,.08); font-family: var(--inter); }
  .photo { height: 280px; border-radius: 16px 16px 0 0; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .photo.green { background: linear-gradient(135deg, #0F172A 0%, #1E293B 50%, #10B98122 100%); }
  .photo.purple { background: linear-gradient(135deg, #0F172A 0%, #1E293B 50%, #8B5CF622 100%); }
  .photo-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 30px 30px; }
  .avatar { position: relative; width: 130px; height: 130px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: 48px; letter-spacing: -1px; box-shadow: 0 20px 40px -10px rgba(0,0,0,.4), 0 0 0 4px rgba(255,255,255,.08); }
  .green .avatar { background: linear-gradient(135deg, #10B981, #8B5CF6); }
  .purple .avatar { background: var(--purple); }
  .info { padding: 28px; }
  .role { font-size: 11px; color: var(--slate-500); letter-spacing: 1.5px; margin-bottom: 8px; font-weight: 600; line-height: 1.7; }
  .name { font-size: 22px; color: var(--navy); font-weight: 700; margin-bottom: 14px; line-height: 1.7; }
  .socials { display: flex; gap: 10px; }
  .socials a { width: 32px; height: 32px; background: var(--light-bg); border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: var(--slate-500); font-size: 13px; font-weight: 700; transition: all .3s; }
  .socials a:hover { background: var(--green); color: #fff; }

  /* 5. Why */
  .why { background: linear-gradient(135deg, #0F172A 0%, #020617 100%); padding: 120px 0; }
  .why-row { max-width: 1100px; }
  .why-col { background: var(--slate-800); padding: 32px 28px; border-radius: 16px; font-family: var(--inter); }
  .reason { display: flex; gap: 18px; align-items: flex-start; margin-bottom: 27px; }
  .reason:last-child { margin-bottom: 0; }
  .r-ico { flex-shrink: 0; width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; color: #fff; }
  .r-ico.green { background: linear-gradient(135deg, #10B981, #059669); }
  .r-ico.purple { background: linear-gradient(135deg, #8B5CF6, #7C3AED); }
  .r-title { font-weight: 700; font-size: 18px; color: #fff; margin-bottom: 8px; line-height: 1.7; }
  .r-text { font-size: 14.5px; color: var(--slate-400); line-height: 1.7; }

  /* 6. CTA */
  .a-cta { background: linear-gradient(135deg, #020617 0%, #0F172A 50%, #1E1B4B 100%); padding: 120px 0; font-family: var(--inter); overflow: hidden; }
  .c1 { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 800px; height: 400px; background: radial-gradient(ellipse, rgba(16,185,129,.12) 0%, transparent 60%); filter: blur(60px); }
  .c2 { position: absolute; bottom: 10%; right: 10%; width: 400px; height: 400px; background: radial-gradient(circle, rgba(139,92,246,.15) 0%, transparent 70%); filter: blur(80px); }
  .a-cta h2 { font-size: 64px; font-weight: 800; line-height: 70.4px; letter-spacing: -1.5px; color: #fff; margin-bottom: 24px; }
  .a-cta .lead { max-width: 640px; margin: 0 auto 36px; font-size: 18px; line-height: 30.6px; color: var(--slate-300); }

  @media (max-width: 980px) {
    .who-row { grid-template-columns: 1fr; row-gap: 40px; }
    .team-grid { row-gap: 30px; }
  }
  @media (max-width: 767px) {
    .a-hero { padding: 60px 0; }
    .a-hero h1 { font-size: 40px; line-height: 44px; letter-spacing: -1px; }
    .who, .mission, .team, .why, .a-cta { padding: 60px 0; }
    .who h2 { font-size: 32px; line-height: 38px; }
    .a-cta h2 { font-size: 40px; line-height: 44px; }
    .val { font-size: 36px; }
    .stats { gap: 12px; }
    .stat { padding: 24px 18px; }
  }
</style>
