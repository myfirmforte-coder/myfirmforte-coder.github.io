---
// CASE STUDIES PAGE — /case-studies/  (naya design, photos ke saath)
// Case study cards, filter buttons aur testimonials neeche arrays mein hain.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { caseTabs } from '../../data/caseStudies';


// photo = card ki tasveer (public/images/...). featured: true = hero mein bara card bhi yahi dikhta hai.
// link = "Read the case study" button ka page. Filter buttons (tabs) ki list: src/data/caseStudies.ts
const cases = [
  { icon: 'fas fa-balance-scale', photo: '/images/cases/legal-2.jpg', featured: true,
    tags: [['LEGAL', '/industries/legal/'], ['SEMANTIC SEO', '/services/semantic-seo-optimization-services/']],
    title: 'From Page 4 to Position 2 in 90 Days',
    text: 'A mid-sized law firm was buried on page 4 for their core practice area keywords. We rebuilt their content with entity-driven semantic architecture and strategic topical clusters. Within 90 days, they ranked #2 nationally for their primary service.',
    stats: [['+312%', 'Organic traffic'], ['3.2×', 'Qualified leads']], link: '/industries/legal/' },
  { icon: 'fas fa-tools', photo: '/images/cases/home-2.jpg',
    tags: [['HOME SERVICES', '/industries/home-services/'], ['GMB', '/services/gmb-management-services/']],
    title: '5× More Local Calls in 60 Days',
    text: "A multi-location home services company was losing every 'near me' search to competitors with better-optimized Google Business Profiles. We restructured their GMB strategy, added geo-specific service pages, and automated review acquisition.",
    stats: [['+480%', 'GMB actions'], ['5×', 'Call volume']], link: '/industries/home-services/' },
  { icon: 'fas fa-robot', photo: '/images/services/ai-woman.jpg',
    tags: [['SAAS', '/industries/ecommerce-website-and-seo/'], ['GEO OPTIMIZATION', '/services/ai-geo-optimization/']],
    title: 'Cited by ChatGPT in 3 Weeks',
    text: 'A B2B SaaS company wanted to show up when prospects asked AI tools for recommendations in their category. We implemented schema optimization, authority content, and entity signaling across their domain — and earned citations across 4 major AI engines.',
    stats: [['0 → 74%', 'AI visibility'], ['4 of 5', 'AI engines citing']], link: '/case-studies/geo-ai-saas-citations/' },
  { icon: 'fas fa-shopping-bag', photo: '/images/services/ec-pack.jpg',
    tags: [['E-COMMERCE', '/industries/ecommerce-website-and-seo/'], ['WEBSITE', '/services/web-development/']],
    title: 'Full Rebuild → #1 in 6 Months',
    text: "A DTC brand had a beautiful Shopify store that couldn't rank. We rebuilt it on a Rank-Ready architecture with proper semantic structure, Core Web Vitals optimization, and a content strategy built around commercial intent clusters.",
    stats: [['+$180K', 'Organic revenue'], ['340+', 'Page 1 keywords']], link: '/case-studies/website-design-dtc-rebuild/' },
  { icon: 'fas fa-tooth', photo: '/images/services/dent-3.jpg',
    tags: [['MEDICAL', '/industries/medical-dental/'], ['LOCAL SEO', '/services/local-landing-pages/']],
    title: '120 Location Pages, Zero Duplicate Content',
    text: 'A dental group with 120 locations needed unique, rankable pages for every city. Using semantic templates and local-intent research, we deployed 120 hyper-local pages with zero duplicate content penalties and dominant local pack visibility.',
    stats: [['+890%', 'Local pack appearances'], ['+2,400', 'Monthly bookings']], link: '/case-studies/local-seo-dental-group/' },
  { icon: 'fas fa-home', photo: '/images/services/re-lux.jpg',
    tags: [['REAL ESTATE', '/industries/real-estate/'], ['SEO', '/services/semantic-seo-optimization-services/'], ['WEBSITE', '/services/web-development/']],
    title: '$1.2M in Attributed Listings',
    text: 'A boutique real estate agency wanted to rank for high-intent luxury keywords. We rebuilt their site with a semantic-first architecture and built out hyper-targeted neighborhood content. Six months later, they credited $1.2M in closed volume to organic search.',
    stats: [['$1.2M', 'Attributed revenue'], ['48', 'Top-3 keywords']], link: '/industries/real-estate/' },
];

const reviews = [
  { quote: 'Rank Ready took our firm from invisible to the first result for nearly every key term in our market. Inquiries tripled in four months. They’re the only SEO team I’d recommend without hesitation.', initials: 'JS', name: 'John Smith', role: 'Managing Partner, Smith &amp; Associates Law' },
  { quote: 'We went from begging for referrals to turning away work. Their GMB and local page strategy is unmatched. Best investment we’ve made in the business.', initials: 'SK', name: 'Sarah Khan', role: 'Owner, Elite Home Services' },
  { quote: 'I didn’t even know GEO was a thing. Now my brand gets cited by ChatGPT when people ask for recommendations in my industry. Rank Ready is years ahead of every other agency.', initials: 'DP', name: 'Daniel Park', role: 'Founder, NorthPeak SaaS' },
];
const featured = cases.find((c) => c.featured) ?? cases[0];
const totals = [
  { value: '+312%', label: 'organic traffic for a mid-sized law firm' },
  { value: '5×', label: 'more local calls for home services' },
  { value: '0 → 74%', label: 'AI citation rate for a B2B SaaS' },
  { value: '$1.2M', label: 'attributed revenue for real estate' },
];
---
<BaseLayout
  title="SEO Case Studies | Real Results from Rank Ready Clients"
  description="Real results, named clients. +312% legal traffic, 5× home services calls, 0→74% AI citations, $1.2M attributed revenue. See exactly how we did it."
>
  <!-- 1. HERO -->
  <section class="cs-hero">
    <div class="row hero-grid">
      <div class="hero-copy">
        <p class="kicker">Case Studies</p>
        <h1>Real businesses. <span class="g">Real rankings. Real revenue.</span></h1>
        <p class="lead">No fluff. No vanity metrics. Just honest breakdowns of what we did, what moved, and what your business can take away.</p>
        <div class="btns">
          <a href="#cases" class="rr-btn rr-btn-primary rr-btn-lg"><span>Browse Case Studies</span><i class="fas fa-arrow-down rr-btn-arrow"></i></a>
          <a href={site.calendly} class="rr-btn rr-btn-ghost rr-btn-lg" target="_blank" rel="noopener"><span>Book a Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        </div>
      </div>
      <a href={featured.link} class="feat">
        <div class="feat-img">
          <img src={featured.photo} alt="" width="900" height="560" />
          <span class="feat-badge"><i class="fas fa-star"></i> Featured</span>
        </div>
        <div class="feat-body">
          <div class="tags">{featured.tags.map(([t], i) => <>{i > 0 && <span class="sep">·</span>}<span>{t}</span></>)}</div>
          <div class="feat-title" set:html={featured.title} />
          <div class="feat-stats">
            {featured.stats.map(([v, l]) => <div><b>{v}</b><span>{l}</span></div>)}
          </div>
          <span class="more">Read the case study <i class="fas fa-arrow-right"></i></span>
        </div>
      </a>
    </div>
  </section>

  <!-- 2. STATS -->
  <div class="row stats">
    {totals.map((t) => (
      <div class="stat"><div class="s-v">{t.value}</div><div class="s-l">{t.label}</div></div>
    ))}
  </div>

  <!-- 3. FILTERS + CASE STUDY CARDS -->
  <section class="list" id="cases">
    <div class="row sec-head">
      <div>
        <p class="eyebrow">ALL CASE STUDIES</p>
        <h2 class="h2">What we did, and what moved.</h2>
      </div>
      <nav class="filters" aria-label="Case study categories">
        {caseTabs.map((f, i) => <a href={f.href} class:list={['filter', { active: i === 0 }]}>{f.label}</a>)}
      </nav>
    </div>
    <div class="row cases">
      {cases.map((c) => (
        <article class="case">
          <a href={c.link} class="case-img" tabindex="-1" aria-hidden="true">
            <img src={c.photo} alt="" width="900" height="560" loading="lazy" />
            <span class="case-ico"><i class={c.icon}></i></span>
            <span class="case-metric"><b>{c.stats[0][0]}</b><span>{c.stats[0][1]}</span></span>
          </a>
          <div class="case-body">
            <div class="tags">
              {c.tags.map(([t, h], i) => <>{i > 0 && <span class="sep">·</span>}<a href={h}>{t}</a></>)}
            </div>
            <h3 class="case-title"><a href={c.link} set:html={c.title} /></h3>
            <p class="case-text" set:html={c.text} />
            <div class="case-stats">
              {c.stats.map(([v, l]) => <div><b>{v}</b><span>{l}</span></div>)}
            </div>
            <a href={c.link} class="more">Read the case study <i class="fas fa-arrow-right"></i></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 4. TESTIMONIALS -->
  <section class="rev">
    <div class="row head-c">
      <p class="eyebrow">WHAT CLIENTS SAY</p>
      <h2 class="h2">In their words.</h2>
      <p class="sub">The numbers matter. But so does what it actually felt like to work with us.</p>
    </div>
    <div class="row rev-grid">
      {reviews.map((r) => (
        <figure class="rv">
          <div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
          <blockquote set:html={r.quote} />
          <figcaption>
            <span class="av">{r.initials}</span>
            <span><b>{r.name}</b><span set:html={r.role} /></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 5. YOUR STORY HERE NEXT -->
  <section class="story">
    <div class="row">
      <div class="story-card">
        <div>
          <p class="eyebrow light">YOUR STORY HERE NEXT</p>
          <h2 class="h2 light">Want results like these for your business?</h2>
          <p class="sub light">Book a free strategy call. We’ll walk through your current rankings, opportunities, and exactly what we’d do to move the needle.</p>
          <div class="btns">
            <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book a Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
            <a href="/contact/" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Send a Message</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
          </div>
        </div>
        <img class="story-img" src="/images/about/team-3.jpg" alt="" width="1200" height="900" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- 6. FINAL CTA -->
  <section class="final">
    <div class="row final-in">
      <h2>Let’s make you <span class="g">Rank Ready.</span></h2>
      <p>Book a free 30-minute strategy call. No pressure, no pitch — just clear advice on what’s holding your rankings back and how to fix it.</p>
      <div class="btns center">
        <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book Your Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        <a href="/contact/" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Get in Touch</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section, .stats { font-family: var(--inter); position: relative; }
  :global(.rr-btn i.rr-btn-arrow) { font-size: 13px; }
  :global(html) { scroll-behavior: smooth; }
  .g { background: linear-gradient(90deg, #6EE7B7 0%, #059669 100%); -webkit-box-decoration-break: clone; box-decoration-break: clone; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: #34D399; }
  .eyebrow { margin-bottom: 14px; padding: 0; }
  .eyebrow.light { color: #6EE7B7; }
  .h2 { font-size: 42px; font-weight: 800; line-height: 1.12; letter-spacing: -1.3px; color: var(--navy); margin-bottom: 18px; padding: 0; }
  .h2.light { color: #fff; }
  .sub { font-size: 17px; line-height: 1.7; color: var(--slate-500); padding: 0; margin: 0; }
  .sub.light { color: var(--slate-300); margin-bottom: 30px; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btns.center { justify-content: center; }
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 700; letter-spacing: 1.3px; color: #059669; margin-bottom: 10px; }
  .tags a { color: #059669; }
  .tags a:hover { color: #047857; text-decoration: underline; }
  .sep { color: #CBD5E1; }
  .more { font-size: 15px; font-weight: 700; color: #059669; }
  .more i { font-size: 12px; margin-left: 4px; transition: transform .3s; }

  /* 1. Hero */
  .cs-hero { background: linear-gradient(135deg, #0B1224 0%, #020617 100%); padding: 90px 0 150px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 64px; align-items: center; }
  .kicker { font-size: 13px; font-weight: 600; letter-spacing: 1.6px; text-transform: uppercase; color: #6EE7B7; padding: 0 0 0 34px; margin-bottom: 22px; position: relative; }
  .kicker::before { content: ""; position: absolute; left: 0; top: 50%; width: 24px; height: 2px; background: #10B981; }
  .cs-hero h1 { font-size: 58px; font-weight: 800; line-height: 1.06; letter-spacing: -2.1px; color: #fff; margin-bottom: 24px; padding: 0; }
  .lead { font-size: 18px; line-height: 1.7; color: var(--slate-300); margin-bottom: 34px; padding: 0; max-width: 560px; }
  .feat { display: block; background: #fff; border-radius: 22px; overflow: hidden; box-shadow: 0 40px 80px -30px rgba(0,0,0,.6); color: inherit; transition: transform .35s; }
  .feat:hover { transform: translateY(-4px); }
  .feat:hover .more i { transform: translateX(5px); }
  .feat-img { position: relative; aspect-ratio: 16 / 8.5; overflow: hidden; }
  .feat-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .feat-badge { position: absolute; top: 16px; left: 16px; display: inline-flex; align-items: center; gap: 6px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; padding: 6px 12px; border-radius: 100px; }
  .feat-badge i { font-size: 10px; }
  .feat-body { padding: 24px 28px 26px; }
  .feat-title { font-size: 22px; font-weight: 800; letter-spacing: -.4px; line-height: 1.3; color: var(--navy); margin-bottom: 18px; }
  .feat-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 16px 0; border-top: 1px solid #F1F5F9; border-bottom: 1px solid #F1F5F9; margin-bottom: 18px; }
  .feat-stats b, .case-stats b { display: block; font-size: 28px; font-weight: 800; letter-spacing: -1px; line-height: 1.1; background: linear-gradient(90deg, #10B981 0%, #047857 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: #059669; }
  .feat-stats span, .case-stats span { font-size: 13px; color: var(--slate-500); }

  /* 2. Stats */
  .stats { z-index: 2; margin-top: -70px; background: #fff; border: 1px solid #E2E8F0; border-radius: 20px; box-shadow: 0 30px 60px -30px rgba(15,23,42,.25); display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { padding: 28px 30px; }
  .stat + .stat { border-left: 1px solid #F1F5F9; }
  .s-v { font-size: 36px; font-weight: 800; letter-spacing: -1.3px; line-height: 1.1; color: var(--navy); }
  .s-l { font-size: 14px; line-height: 1.5; color: var(--slate-500); margin-top: 6px; }

  /* 3. List */
  .list { padding: 100px 0; background: #fff; scroll-margin-top: 20px; }
  .sec-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; align-items: flex-end; margin-bottom: 44px; }
  .sec-head .h2 { margin-bottom: 0; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .filter { padding: 9px 16px; border: 1px solid #E2E8F0; border-radius: 100px; font-size: 14px; font-weight: 600; color: #334155; background: #fff; transition: all .25s; }
  .filter:hover { border-color: #A7F3D0; color: #047857; }
  .filter.active { background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); border-color: transparent; color: #fff; }
  .cases { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .case { display: flex; flex-direction: column; background: #fff; border: 1px solid #E2E8F0; border-radius: 22px; overflow: hidden; transition: transform .35s, box-shadow .35s, border-color .35s; }
  .case:hover { transform: translateY(-4px); border-color: #A7F3D0; box-shadow: 0 30px 60px -32px rgba(15,23,42,.3); }
  .case-img { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; }
  .case-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
  .case:hover .case-img img { transform: scale(1.05); }
  .case-img::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(2,6,23,.1) 30%, rgba(2,6,23,.8) 100%); }
  .case-ico { position: absolute; top: 14px; right: 14px; z-index: 1; width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 16px; box-shadow: 0 10px 20px -10px rgba(0,0,0,.5); }
  .case-metric { position: absolute; left: 20px; bottom: 16px; z-index: 1; color: #fff; }
  .case-metric b { display: block; font-size: 34px; font-weight: 800; letter-spacing: -1.2px; line-height: 1; }
  .case-metric span { font-size: 13px; color: rgba(255,255,255,.8); }
  .case-body { flex: 1; display: flex; flex-direction: column; padding: 22px 24px 24px; }
  .case-title { font-size: 20px; font-weight: 700; line-height: 1.35; margin-bottom: 10px; padding: 0; }
  .case-title a { color: var(--navy); }
  .case-title a:hover { color: #047857; }
  .case-text { font-size: 14.5px; line-height: 1.7; color: var(--slate-500); padding: 0; margin-bottom: 18px; }
  .case-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 14px 0; border-top: 1px solid #F1F5F9; margin-bottom: 16px; margin-top: auto; }
  .case-stats b { font-size: 22px; }
  .case:hover .more i { transform: translateX(5px); }

  /* 4. Reviews */
  .rev { padding: 100px 0; background: var(--light-bg); }
  .head-c { text-align: center; max-width: 720px; margin-bottom: 52px; }
  .rev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .rv { margin: 0; background: #fff; border: 1px solid #E2E8F0; border-radius: 20px; padding: 30px; display: flex; flex-direction: column; }
  .stars { color: #FBBF24; font-size: 13px; display: flex; gap: 3px; margin-bottom: 16px; }
  .rv blockquote { font-size: 16px; line-height: 1.7; color: #334155; margin: 0 0 24px; padding: 0; border: 0; font-style: normal; flex: 1; }
  .rv figcaption { display: flex; align-items: center; gap: 12px; padding-top: 18px; border-top: 1px solid #F1F5F9; }
  .av { width: 44px; height: 44px; flex: none; border-radius: 50%; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .rv figcaption b { display: block; font-size: 15px; color: var(--navy); }
  .rv figcaption span span { font-size: 13px; color: var(--slate-500); }

  /* 5. Story */
  .story { padding: 100px 0; background: #fff; }
  .story-card { display: grid; grid-template-columns: 1.1fr .9fr; gap: 50px; align-items: center; background: linear-gradient(135deg, #064E3B 0%, #065F46 40%, #0F172A 100%); border-radius: 30px; padding: 60px; }
  .story-img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 18px; border: 1px solid rgba(255,255,255,.12); }

  /* 6. Final */
  .final { background: linear-gradient(135deg, #020617 0%, #0F172A 50%, #064E3B 100%); padding: 120px 0; }
  .final-in { text-align: center; max-width: 820px; }
  .final h2 { font-size: 60px; font-weight: 800; line-height: 1.06; letter-spacing: -2px; color: #fff; margin-bottom: 20px; padding: 0; }
  .final p { font-size: 18px; line-height: 1.7; color: var(--slate-300); max-width: 620px; margin: 0 auto 36px; padding: 0; }

  @media (max-width: 1100px) {
    .cases, .rev-grid { grid-template-columns: 1fr 1fr; }
    .sec-head { grid-template-columns: 1fr; }
    .filters { justify-content: flex-start; }
  }
  @media (max-width: 980px) {
    .hero-grid, .story-card { grid-template-columns: 1fr; gap: 40px; }
    .cs-hero { padding: 64px 0 130px; }
    .feat { max-width: 620px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(3) { border-left: 0; }
    .stat:nth-child(n+3) { border-top: 1px solid #F1F5F9; }
    .story-card { padding: 48px 36px; }
  }
  @media (max-width: 767px) {
    .cs-hero h1 { font-size: 38px; letter-spacing: -1.2px; }
    .lead { font-size: 16.5px; }
    .h2 { font-size: 30px; letter-spacing: -.9px; }
    .stats { margin-top: -60px; }
    .stat { padding: 20px 18px; }
    .s-v { font-size: 26px; }
    .s-l { font-size: 12.5px; }
    .list, .rev, .story { padding: 70px 0; }
    .cases, .rev-grid { grid-template-columns: 1fr; gap: 16px; }
    .filter { font-size: 13px; padding: 7px 13px; }
    .feat-body { padding: 20px; }
    .feat-title { font-size: 19px; }
    .story-card { padding: 40px 22px; border-radius: 22px; }
    .btns .rr-btn { width: 100%; }
    .final { padding: 80px 0; }
    .final h2 { font-size: 38px; letter-spacing: -1.2px; }
  }
</style>
