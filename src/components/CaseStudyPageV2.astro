---
// CASE STUDY template (new design) — used by all 5 case study pages.
// Pages only pass a 'data' object. Text lives in the page; design lives here.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { caseTabs, caseSummaries } from '../data/caseStudies';

export interface CaseStudyData {
  meta: { title: string; description: string };
  path: string;                       // this page's URL, e.g. '/semantic-seo-case-study/'
  hero: { tag: string; title: string; lead: string; icon: string; photo?: string };  // icon = Font Awesome class
  facts: { label: string; value: string }[];          // Client / Industry / Timeline / Services
  kpis: { value: string; label: string }[];           // 4 headline numbers
  overview: { title: string; text: string }[];        // client overview + challenge paragraphs
  challenges: string[];                               // challenge bullet points
  table?: { before: string; after: string; rows: [string, string, string, string][] }; // metric, before, after, change
  approach: { title: string; text: string; points?: string[] }[];
  results: { value: string; title: string; text: string }[];
  quote?: { text: string; name: string; role: string; initials: string };
  takeaways: string[];
  storyPhoto?: string;                                // optional photo in the sticky side card
}
interface Props { data: CaseStudyData }
const { data: d } = Astro.props;
const more = caseSummaries.filter((c) => c.href !== d.path).slice(0, 3);
const factIcons = ['fas fa-building', 'fas fa-industry', 'fas fa-calendar-alt', 'fas fa-layer-group', 'fas fa-map-marker-alt', 'fas fa-bullseye'];

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: d.hero.title.replace(/<[^>]+>/g, ''),
  description: d.meta.description,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
};
---
<BaseLayout title={d.meta.title} description={d.meta.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />

  <!-- 1. HERO -->
  <section class="cs-hero">
    <div class="row hero-grid">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/case-studies/">Case Studies</a><i class="fas fa-chevron-right"></i><span>{d.hero.tag}</span></nav>
        <h1 set:html={d.hero.title} />
        <p class="lead" set:html={d.hero.lead} />
        <div class="btns">
          <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Get Results Like This</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
          <a href="#results" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Jump to Results</span><i class="fas fa-arrow-down rr-btn-arrow"></i></a>
        </div>
      </div>
      <div class:list={['hero-visual', { 'no-photo': !d.hero.photo }]}>
        {d.hero.photo && <img src={d.hero.photo} alt="" width="1200" height="900" />}
        <aside class="glance">
          <div class="gl-top"><span class="ico"><i class={d.hero.icon}></i></span><span class="gl-lbl">At a glance</span></div>
          <dl>
            {d.facts.map((f, i) => (<div class="fact"><dt><i class={factIcons[i] ?? 'fas fa-check'}></i>{f.label}</dt><dd set:html={f.value} /></div>))}
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- 2. KPI STRIP -->
  <div class="row stats">
    {d.kpis.map((k) => (<div class="stat"><div class="s-v">{k.value}</div><div class="s-l">{k.label}</div></div>))}
  </div>

  <!-- 3. TABS -->
  <div class="row tabs" aria-label="Case studies">
    {caseTabs.map((t) => <a href={t.href} class:list={['tab', { active: t.href === d.path }]}>{t.label}</a>)}
  </div>

  <!-- 4. STORY -->
  <section class="story">
    <div class="row story-grid">
      <article class="body">
        {d.overview.map((o, i) => (
          <div class="block">
            <div class="step-lbl"><span>{String(i + 1).padStart(2, '0')}</span>{i === 0 ? 'The client' : 'The challenge'}</div>
            <h2 class="h3" set:html={o.title} />
            <p set:html={o.text} />
            {i === d.overview.length - 1 && d.challenges.length > 0 && (
              <ul class="xlist">{d.challenges.map((c) => <li><span class="x"><i class="fas fa-times"></i></span><span set:html={c} /></li>)}</ul>
            )}
          </div>
        ))}

        <div class="block">
          <div class="step-lbl"><span>{String(d.overview.length + 1).padStart(2, '0')}</span>The approach</div>
          <h2 class="h3">How we did it</h2>
          <ol class="timeline">
            {d.approach.map((a, i) => (
              <li>
                <div class="tl-num">{i + 1}</div>
                <div class="tl-body">
                  <h3 set:html={a.title} />
                  <p set:html={a.text} />
                  {a.points && <ul class="tick-list">{a.points.map((p) => <li><i class="fas fa-check"></i><span set:html={p} /></li>)}</ul>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </article>

      <aside class="side">
        <div class="side-card">
          {d.storyPhoto && <img class="side-photo" src={d.storyPhoto} alt="" width="800" height="500" loading="lazy" />}
          <div class="side-in">
            <div class="side-lbl">The outcome</div>
            {d.kpis.slice(0, 2).map((k) => (<div class="side-kpi"><div class="side-val g">{k.value}</div><div class="side-txt">{k.label}</div></div>))}
            <a href={site.calendly} class="rr-btn rr-btn-primary side-btn" target="_blank" rel="noopener"><span>Book a Free Strategy Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
            <a href="/services/seo-audits/" class="side-link">Or get a free SEO + GEO audit <i class="fas fa-arrow-right"></i></a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- 5. RESULTS -->
  <section class="results" id="results">
    <div class="row head-c">
      <p class="eyebrow">THE RESULTS</p>
      <h2 class="h2">What moved, and <span class="g">by how much.</span></h2>
    </div>
    <div class="row res-grid">
      {d.results.map((r) => (
        <div class="res">
          <span class="ico sm"><i class="fas fa-chart-line"></i></span>
          <div class="res-val">{r.value}</div>
          <div class="res-title" set:html={r.title} />
          <div class="res-text" set:html={r.text} />
        </div>
      ))}
    </div>
    {d.table && (
      <div class="row tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Metric</th><th>Before<span>{d.table.before}</span></th><th>After<span>{d.table.after}</span></th><th>Change</th></tr></thead>
          <tbody>
            {d.table.rows.map(([m, b, a, c]) => (<tr><td>{m}</td><td class="muted">{b}</td><td class="strong">{a}</td><td><span class="chg"><i class="fas fa-arrow-up"></i>{c}</span></td></tr>))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <!-- 6. QUOTE -->
  {d.quote && (
    <section class="quote-sec">
      <div class="row">
        <div class="qcard">
          <img class="q-bg" src="/images/about/work-3.jpg" alt="" width="1600" height="900" loading="lazy" />
          <div class="q-shade"></div>
          <div class="q-in">
            <span class="ico q-ico"><i class="fas fa-quote-left"></i></span>
            <p class="q-text">{d.quote.text}</p>
            <div class="q-who"><div class="q-av">{d.quote.initials}</div><div><div class="q-name">{d.quote.name}</div><div class="q-role" set:html={d.quote.role} /></div></div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 7. TAKEAWAYS -->
  <section class="take-sec">
    <div class="row take-row">
      <div class="take-head">
        <p class="eyebrow">KEY TAKEAWAYS</p>
        <h2 class="h2">What your business can <span class="g">learn from this.</span></h2>
      </div>
      <div class="takes">
        {d.takeaways.map((t, i) => (<div class="take"><span class="take-n">{String(i + 1).padStart(2, '0')}</span><p set:html={t} /></div>))}
      </div>
    </div>
  </section>

  <!-- 8. MORE CASE STUDIES -->
  <section class="more-sec">
    <div class="row more-head">
      <div><p class="eyebrow">MORE CASE STUDIES</p><h2 class="h2">Keep <span class="g">reading.</span></h2></div>
      <a href="/case-studies/" class="rr-btn rr-btn-outline"><span>All case studies</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
    </div>
    <div class="row more-grid">
      {more.map((m) => (
        <a href={m.href} class="mcard">
          <div class="m-top">
            <img src={m.photo} alt="" width="800" height="500" loading="lazy" />
            <span class="ico m-ico"><i class={m.icon}></i></span>
          </div>
          <div class="m-body">
            <div class="m-tag">{m.tag}</div>
            <div class="m-title">{m.title}</div>
            <div class="m-stat"><strong>{m.stat}</strong> {m.statLabel}</div>
            <div class="m-more">Read the case study <i class="fas fa-arrow-right"></i></div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 9. FINAL CTA -->
  <section class="final">
    <div class="row final-in">
      <h2>Want results <span class="g">like these?</span></h2>
      <p>Book a free 30-minute strategy call. We will look at your site, your market and your competitors, and tell you honestly what it would take.</p>
      <div class="btns center">
        <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Book Your Free Call</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
        <a href="/contact/" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Get in Touch</span><i class="fas fa-arrow-right rr-btn-arrow"></i></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section, .stats, .tabs { font-family: var(--inter); position: relative; }
  :global(.rr-btn i.rr-btn-arrow) { font-size: 13px; }
  .g, .cs-hero h1 :global(.grad), .h2 :global(.grad), .h3 :global(.grad) { background: linear-gradient(90deg, #6EE7B7 0%, #059669 100%); -webkit-box-decoration-break: clone; box-decoration-break: clone; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: #34D399; }
  .eyebrow { margin-bottom: 14px; padding: 0; }
  .h2 { font-size: 44px; font-weight: 800; line-height: 1.12; letter-spacing: -1.4px; color: var(--navy); margin-bottom: 20px; padding: 0; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btns.center { justify-content: center; }
  .head-c { text-align: center; max-width: 760px; margin-bottom: 56px; }
  h3 { padding: 0; }
  .ico { flex: none; width: 52px; height: 52px; border-radius: 15px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; box-shadow: 0 12px 24px -12px rgba(5,150,105,.6), inset 0 1px 0 rgba(255,255,255,.35); display: flex; align-items: center; justify-content: center; font-size: 21px; }
  .ico.sm { width: 44px; height: 44px; border-radius: 13px; font-size: 17px; }

  /* 1. Hero */
  .cs-hero { background: linear-gradient(135deg, #0B1224 0%, #020617 100%); padding: 90px 0 150px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 64px; align-items: center; }
  .crumbs { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 24px; color: #6EE7B7; }
  .crumbs a { color: var(--slate-400); }
  .crumbs a:hover { color: #fff; }
  .crumbs i { font-size: 9px; color: var(--slate-500); }
  .cs-hero h1 { font-size: 56px; font-weight: 800; line-height: 1.08; letter-spacing: -2px; color: #fff; margin-bottom: 24px; padding: 0; }
  .lead { font-size: 18px; line-height: 1.7; color: var(--slate-300); margin-bottom: 34px; padding: 0; max-width: 580px; }
  .lead :global(strong) { color: #fff; }
  .hero-visual { position: relative; padding-bottom: 40px; }
  .hero-visual img { display: block; width: 82%; margin-left: auto; aspect-ratio: 4 / 4.2; object-fit: cover; border-radius: 22px; }
  .glance { position: absolute; left: 0; bottom: 0; width: 330px; background: #fff; border-radius: 20px; padding: 24px 26px 10px; box-shadow: 0 30px 60px -24px rgba(2,6,23,.6); }
  .no-photo .glance { position: static; width: auto; max-width: 440px; margin-left: auto; }
  .gl-top { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
  .gl-top .ico { width: 44px; height: 44px; border-radius: 13px; font-size: 18px; }
  .gl-lbl { font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: var(--slate-400); }
  .glance dl { margin: 0; }
  .fact { padding: 12px 0; border-top: 1px solid #F1F5F9; }
  .fact dt { font-size: 12px; font-weight: 600; letter-spacing: .6px; text-transform: uppercase; color: var(--slate-400); margin-bottom: 3px; }
  .fact dt i { width: 18px; color: #059669; font-size: 11px; }
  .fact dd { margin: 0; font-size: 15px; font-weight: 700; color: var(--navy); line-height: 1.45; }

  /* 2. KPI strip */
  .stats { z-index: 2; margin-top: -70px; background: #fff; border: 1px solid #E2E8F0; border-radius: 20px; box-shadow: 0 30px 60px -30px rgba(15,23,42,.25); display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { padding: 28px 30px; }
  .stat + .stat { border-left: 1px solid #F1F5F9; }
  .s-v { font-size: 36px; font-weight: 800; letter-spacing: -1.3px; line-height: 1.1; background: linear-gradient(90deg, #10B981 0%, #047857 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: #059669; }
  .s-l { font-size: 14px; line-height: 1.5; color: var(--slate-500); margin-top: 6px; }

  /* 3. Tabs */
  .tabs { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; padding-top: 44px; }
  .tab { font-size: 14px; font-weight: 600; color: var(--slate-600, #475569); border: 1px solid #E2E8F0; background: #fff; border-radius: 999px; padding: 9px 18px; transition: border-color .25s, color .25s, background .25s; }
  .tab:hover { border-color: #6EE7B7; color: #059669; }
  .tab.active { background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); border-color: transparent; color: #fff; box-shadow: 0 10px 22px -12px rgba(5,150,105,.7); }

  /* 4. Story */
  .story { padding: 80px 0 100px; background: #fff; }
  .story-grid { display: grid; grid-template-columns: 1fr 360px; gap: 72px; align-items: start; }
  .block { padding-bottom: 50px; margin-bottom: 50px; border-bottom: 1px solid #F1F5F9; }
  .block:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .step-lbl { display: flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; color: #059669; margin-bottom: 14px; }
  .step-lbl span { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 10px; background: #ECFDF5; color: #059669; font-size: 13px; letter-spacing: 0; }
  .h3 { font-size: 32px; font-weight: 800; line-height: 1.2; letter-spacing: -1px; color: var(--navy); margin-bottom: 16px; padding: 0; }
  .body p { font-size: 17px; line-height: 1.8; color: var(--slate-500); padding: 0; margin: 0; }
  .body p :global(strong) { color: var(--navy); }
  .xlist { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 12px; }
  .xlist li { display: flex; gap: 14px; align-items: flex-start; background: #FEF2F2; border: 1px solid #FEE2E2; border-radius: 14px; padding: 14px 18px; font-size: 15.5px; line-height: 1.6; color: #334155; }
  .x { flex: none; width: 26px; height: 26px; border-radius: 8px; background: linear-gradient(135deg, #FCA5A5 0%, #DC2626 100%); color: #fff; font-size: 11px; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
  .timeline { list-style: none; margin: 30px 0 0; padding: 0; position: relative; }
  .timeline::before { content: ""; position: absolute; left: 21px; top: 10px; bottom: 10px; width: 2px; background: linear-gradient(180deg, #6EE7B7, #059669); opacity: .35; }
  .timeline > li { position: relative; display: grid; grid-template-columns: 44px 1fr; gap: 22px; padding-bottom: 34px; }
  .timeline > li:last-child { padding-bottom: 0; }
  .tl-num { position: relative; z-index: 1; width: 44px; height: 44px; border-radius: 13px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; font-weight: 800; font-size: 16px; display: flex; align-items: center; justify-content: center; box-shadow: 0 12px 24px -12px rgba(5,150,105,.6), inset 0 1px 0 rgba(255,255,255,.35); }
  .tl-body { border: 1px solid #E2E8F0; border-radius: 18px; padding: 24px 26px; transition: border-color .3s, box-shadow .3s; }
  .tl-body:hover { border-color: #A7F3D0; box-shadow: 0 20px 40px -28px rgba(15,23,42,.3); }
  .tl-body h3 { font-size: 19px; font-weight: 700; color: var(--navy); line-height: 1.4; margin-bottom: 8px; }
  .tl-body p { font-size: 15.5px; line-height: 1.75; }
  .tick-list { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 8px; }
  .tick-list li { display: flex; gap: 10px; font-size: 15px; line-height: 1.6; color: #334155; }
  .tick-list i { flex: none; width: 20px; height: 20px; margin-top: 2px; border-radius: 6px; background: linear-gradient(135deg, #6EE7B7 0%, #059669 100%); color: #fff; font-size: 9px; display: flex; align-items: center; justify-content: center; }
  .side { position: sticky; top: 110px; }
  .side-card { background: linear-gradient(135deg, #064E3B 0%, #065F46 40%, #0F172A 100%); border-radius: 24px; overflow: hidden; color: #fff; }
  .side-photo { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .side-in { padding: 30px 28px; }
  .side-lbl { font-size: 12px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: #6EE7B7; margin-bottom: 14px; }
  .side-kpi { padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,.12); }
  .side-val { font-size: 40px; font-weight: 800; letter-spacing: -1.4px; line-height: 1.1; }
  .side-txt { font-size: 14px; color: #CBD5E1; margin-top: 4px; line-height: 1.5; }
  .side-btn { width: 100%; justify-content: center; margin-top: 24px; }
  .side-link { display: block; text-align: center; margin-top: 14px; font-size: 14px; font-weight: 600; color: #A7F3D0; }
  .side-link i { font-size: 11px; margin-left: 4px; }

  /* 5. Results */
  .results { padding: 100px 0; background: var(--light-bg); }
  .res-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .res { background: #fff; border: 1px solid #E2E8F0; border-radius: 20px; padding: 28px; transition: transform .3s, box-shadow .3s, border-color .3s; }
  .res:hover { transform: translateY(-4px); border-color: #A7F3D0; box-shadow: 0 26px 50px -30px rgba(15,23,42,.3); }
  .res-val { font-size: 40px; font-weight: 800; letter-spacing: -1.4px; line-height: 1.1; color: var(--navy); margin: 20px 0 10px; }
  .res-title { font-size: 17px; font-weight: 700; color: var(--navy); line-height: 1.4; margin-bottom: 6px; }
  .res-text { font-size: 14.5px; line-height: 1.7; color: var(--slate-500); }
  .tbl-wrap { margin-top: 40px; overflow-x: auto; }
  .tbl { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; border: 1px solid #E2E8F0; border-radius: 20px; overflow: hidden; font-size: 15px; min-width: 560px; }
  .tbl th { text-align: left; background: #0F172A; color: #fff; font-weight: 700; padding: 16px 22px; font-size: 13px; letter-spacing: .6px; text-transform: uppercase; }
  .tbl th span { display: block; font-size: 12px; font-weight: 500; color: #94A3B8; letter-spacing: 0; text-transform: none; margin-top: 2px; }
  .tbl td { padding: 15px 22px; border-top: 1px solid #F1F5F9; color: #334155; }
  .tbl tr:nth-child(even) td { background: #FAFBFC; }
  .tbl .muted { color: var(--slate-400); }
  .tbl .strong { font-weight: 700; color: var(--navy); }
  .chg { display: inline-flex; align-items: center; gap: 6px; background: #ECFDF5; color: #047857; font-weight: 700; border-radius: 999px; padding: 4px 12px; font-size: 13.5px; }
  .chg i { font-size: 10px; }

  /* 6. Quote */
  .quote-sec { padding: 100px 0 0; background: #fff; }
  .qcard { position: relative; border-radius: 28px; overflow: hidden; padding: 70px 64px; color: #fff; }
  .q-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .q-shade { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(2,6,23,.94) 0%, rgba(6,78,59,.86) 60%, rgba(6,78,59,.55) 100%); }
  .q-in { position: relative; max-width: 780px; }
  .q-ico { margin-bottom: 26px; }
  .q-text { font-size: 24px; line-height: 1.6; font-weight: 500; color: #fff; padding: 0; margin: 0 0 30px; }
  .q-who { display: flex; align-items: center; gap: 14px; }
  .q-av { width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #0F172A 0%, #065F46 100%); border: 2px solid #6EE7B7; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; color: #fff; }
  .q-name { font-weight: 700; font-size: 16px; }
  .q-role { font-size: 14px; color: #CBD5E1; }

  /* 7. Takeaways */
  .take-sec { padding: 100px 0; background: #fff; }
  .take-row { display: grid; grid-template-columns: .8fr 1.2fr; gap: 72px; align-items: start; }
  .take-head { position: sticky; top: 110px; }
  .takes { display: grid; gap: 14px; }
