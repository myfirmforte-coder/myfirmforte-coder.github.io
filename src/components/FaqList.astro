---
// FAQ list (click se khulne wale sawal) + Google FAQ schema.
// Use: <FaqList faqs={[{ q: 'Sawal?', a: 'Jawab (HTML chal sakta hai)' }]} />
interface Props { faqs: { q: string; a: string }[]; openFirst?: boolean; }
const { faqs, openFirst = true } = Astro.props;
const schema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
};
---
<div class="row faq-list">
  {faqs.map((f, i) => (
    <details class="tg" open={openFirst && i === 0}>
      <summary><h5>{f.q}</h5></summary>
      <p set:html={f.a} />
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<style>
  .faq-list { max-width: 860px; font-family: var(--inter); }
  .tg { background: #fff; border: .8px solid #E2E8F0; border-radius: 10px; padding: 22px 26px; margin-bottom: 14px; }
  .tg[open] { background: var(--light-bg); }
  summary { list-style: none; cursor: pointer; position: relative; padding-right: 50px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 22px; font-weight: 600; color: var(--green); line-height: 1; }
  .tg[open] summary::after { content: '−'; }
  h5 { font-size: 17px; font-weight: 700; line-height: 1.3; color: var(--navy); padding-bottom: 0; }
  .tg p { font-size: 15px; line-height: 26.25px; color: var(--slate-500); padding-top: 14px; }
  .tg p :global(strong) { font-weight: 700; }
  .tg p :global(a) { color: var(--green); }
</style>
