---
// HOME 1: Hero — "Digital Growth Agency for AI SEO / Dominate Both."
import { site } from '../../data/site';
---
<section class="sec hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="glow g1"></div><div class="glow g2"></div><div class="gridlines"></div>
  </div>
  <div class="row hero-row">
    <div class="hero-left">
      <div class="badge"><span class="dot"></span>NOW OPTIMIZING FOR AI SEARCH &amp; GOOGLE</div>
      <h1>Digital Growth Agency for AI SEO<br /><span class="grad">Dominate Both.</span></h1>
      <p class="lead">We build Rank-Ready websites engineered for traditional SEO <em>and</em> generative engines like ChatGPT, Perplexity, and Google AI Overviews — so your business wins the future of search, not just the past.</p>
      <div class="rr-btn-group">
        <a href={site.calendly} class="rr-btn rr-btn-primary" target="_blank" rel="noopener"><span>Book a Free Strategy Call</span><span class="rr-btn-arrow">→</span></a>
        <a href="#audit" class="rr-btn rr-btn-ghost"><span>Get My Free SEO + GEO Audit</span><span class="rr-btn-arrow">→</span></a>
      </div>
      <div class="proof">
        <div><span class="stars">★★★★★</span> 4.9/5 from 120+ clients</div>
        <i class="sep"></i><div>240% average traffic lift</div>
        <i class="sep"></i><div>Global Clients Across 15+ Industries</div>
      </div>
    </div>

    <div class="hero-right">
      <div class="mock">
        <div class="mcard google">
          <div class="search">🔍 best law firm near me</div>
          <div class="lbl">GOOGLE · 1ST RESULT</div>
          <div class="gtitle">Smith &amp; Associates Law Firm</div>
          <div class="gurl">smithlaw.com</div>
        </div>
        <div class="mcard ai">
          <div class="ai-head"><span class="ai-ico">AI</span><span class="lbl2">CHATGPT RESPONSE</span></div>
          <div class="ai-txt">Based on recent reviews and expertise, I would recommend <strong>Smith &amp; Associates</strong> as a top choice for...</div>
        </div>
        <div class="client-badge">✓ Rank Ready Client</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { background: linear-gradient(135deg, #0F172A 0%, #020617 100%); padding: 120px 0; overflow: hidden; font-family: Inter, sans-serif; }
  .hero-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .glow { position: absolute; border-radius: 50%; }
  .g1 { top: 10%; left: -5%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(16,185,129,.15) 0%, transparent 70%); filter: blur(60px); }
  .g2 { bottom: -10%; right: -5%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(139,92,246,.18) 0%, transparent 70%); filter: blur(80px); }
  .gridlines { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%); }
  .hero-row { display: grid; grid-template-columns: 57.8% 36.7%; justify-content: space-between; padding: 0; z-index: 1; }

  .badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: rgba(16,185,129,.12); border: 1px solid rgba(16,185,129,.35); border-radius: 100px; font-size: 13px; font-weight: 600; color: var(--green); letter-spacing: 1px; line-height: 1.7; margin-bottom: 24px; }
  .dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 12px var(--green); animation: rr-pulse 2s ease-in-out infinite; }
  h1 { font-size: 76px; font-weight: 800; line-height: 79.8px; letter-spacing: -2px; color: #fff; margin-bottom: 24px; }
  .grad { background: linear-gradient(135deg, #10B981 0%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .lead { max-width: 620px; font-size: 19px; font-weight: 400; line-height: 30.4px; color: var(--gray-300); margin-bottom: 40px; }
  .rr-btn-group { margin-bottom: 32px; }
  .proof { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; font-size: 13.5px; color: var(--gray-300); font-weight: 500; }
  .proof > div:first-child { display: flex; align-items: center; gap: 6px; }
  .stars { color: #FBBF24; font-size: 15px; }
  .sep { width: 4px; height: 4px; background: #475569; border-radius: 50%; }

  .mock { position: relative; width: 100%; padding: 32px; background: linear-gradient(135deg, rgba(16,185,129,.08), rgba(139,92,246,.08)); border: 1px solid rgba(255,255,255,.08); border-radius: 24px; }
  .mcard { background: #fff; border-radius: 14px; padding: 22px; box-shadow: 0 25px 60px rgba(0,0,0,.4); }
  .google { margin-bottom: 18px; transform: rotate(-1deg); }
  .search { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--light-bg); border-radius: 100px; margin-bottom: 16px; font-size: 13px; color: var(--slate-500); }
  .lbl { font-size: 11px; color: var(--slate-500); margin-bottom: 6px; letter-spacing: 1px; }
  .gtitle { font-size: 17px; color: #1a0dab; font-weight: 600; }
  .gurl { font-size: 13px; color: #5f6368; }
  .ai { border-left: 4px solid var(--purple); transform: rotate(1deg); }
  .ai-head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .ai-ico { width: 28px; height: 28px; background: linear-gradient(135deg, #8B5CF6, #7C3AED); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 14px; font-weight: 700; }
  .lbl2 { font-size: 12px; color: var(--slate-500); font-weight: 600; letter-spacing: .5px; }
  .ai-txt { font-size: 14px; color: var(--navy); line-height: 1.65; }
  .ai-txt strong { background: rgba(139,92,246,.15); padding: 2px 5px; border-radius: 4px; color: var(--purple); }
  .client-badge { position: absolute; top: -14px; right: -14px; background: linear-gradient(135deg, #10B981, #059669); color: #fff; font-size: 12px; font-weight: 700; padding: 8px 14px; border-radius: 100px; box-shadow: 0 10px 25px rgba(16,185,129,.5); line-height: 1.7; }

  @media (max-width: 980px) { .hero-row { grid-template-columns: 1fr; row-gap: 50px; } }
  @media (max-width: 767px) {
    .hero { padding: 60px 0 40px; }
    h1 { font-size: 40px; line-height: 42px; letter-spacing: -1px; }
    .lead { font-size: 17px; }
    .client-badge { right: -6px; }
  }
</style>
