---
// HOME 11: "FREE 20-PAGE AUDIT" — green section with email form (id="audit").
import { site } from '../../data/site';
const report = [
  ['Technical SEO', '48/100', '#DC2626'],
  ['Semantic Structure', '62/100', '#F59E0B'],
  ['Local Signals', '31/100', '#DC2626'],
  ['AI Visibility', '0%', '#DC2626'],
];
---
<section class="sec audit" id="audit">
  <div class="row grid au-row">
    <div>
      <p class="eyebrow" style="color:#fff">FREE 20-PAGE AUDIT</p>
      <h2>See exactly why you’re not ranking — and what to fix first.</h2>
      <p class="lead">Get a free, no-strings audit covering your technical SEO, semantic structure, local footprint, and your visibility inside AI search engines. Delivered in 48 hours. No pitch, no pressure.</p>
      <form class="au-form" data-key={site.web3formsKey} data-email={site.email}>
        <input type="email" name="email" required placeholder="Enter your email" />
        <button type="submit">Get My Free Audit →</button>
      </form>
      <p class="msg" hidden></p>
      <p class="ticks">✓ Free &nbsp;·&nbsp; ✓ 48-hour delivery &nbsp;·&nbsp; ✓ No sales pitch &nbsp;·&nbsp; ✓ 100% actionable</p>
    </div>
    <div>
      <div class="report">
        <div class="r-lbl">RANK READY AUDIT</div>
        <div class="r-title">Your SEO + GEO Health Report</div>
        {report.map(([k, v, c]) => <div class="r-line"><span>{k}</span><b style={`color:${c}`}>{v}</b></div>)}
        <div class="r-note">📍 23 actionable recommendations inside</div>
      </div>
    </div>
  </div>
</section>

<script>
  const f = document.querySelector<HTMLFormElement>('.au-form')!;
  const msg = document.querySelector<HTMLElement>('.audit .msg')!;
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (f.elements.namedItem('email') as HTMLInputElement).value;
    const key = f.dataset.key;
    if (!key) {
      location.href = `mailto:${f.dataset.email}?subject=Free SEO + GEO Audit Request&body=Please send a free audit to: ${email}`;
      return;
    }
    const res = await fetch('https://api.web3forms.com/submit', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ access_key: key, subject: 'Free Audit Request', email }),
    });
    msg.hidden = false;
    msg.textContent = res.ok ? 'Thank you! Your audit request has been received.' : 'Something went wrong. Please email us instead.';
    if (res.ok) f.reset();
  });
</script>

<style>
  .audit { background: var(--green); font-family: var(--inter); }
  .au-row { grid-template-columns: 57.8% 36.7%; justify-content: space-between; align-items: center; }
  h2 { font-size: 44px; font-weight: 800; line-height: 50.6px; color: #fff; margin-bottom: 20px; }
  .lead { font-size: 17px; line-height: 30.6px; color: rgba(255,255,255,.9); margin-bottom: 28px; }
  .au-form { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
  .au-form input { flex: 1; min-width: 240px; padding: 16px 20px; border: 0; border-radius: 8px; font-family: inherit; font-size: 15px; color: var(--navy); }
  .au-form button { padding: 16px 28px; background: var(--navy); color: #fff; border: 0; border-radius: 8px; font-family: inherit; font-weight: 600; font-size: 15px; cursor: pointer; }
  .msg { color: #fff; font-weight: 600; margin-bottom: 10px; }
  .ticks { font-size: 13px; line-height: 30.6px; color: rgba(255,255,255,.85); }
  .report { transform: rotate(4deg); background: #fff; border-radius: 12px; padding: 28px; box-shadow: 0 30px 80px rgba(0,0,0,.25); max-width: 320px; margin: 0 auto; line-height: 1.7; }
  .r-lbl { font-size: 11px; color: var(--slate-500); letter-spacing: 1.5px; margin-bottom: 10px; }
  .r-title { font-weight: 800; font-size: 22px; color: var(--navy); margin-bottom: 18px; line-height: 1.2; }
  .r-line { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #E2E8F0; font-size: 13px; }
  .r-line:last-of-type { border-bottom: 0; }
  .r-line span { color: var(--slate-500); }
  .r-note { margin-top: 16px; padding: 12px; background: var(--light-bg); border-radius: 8px; font-size: 12px; color: var(--slate-500); }
  @media (max-width: 980px) { .au-row { grid-template-columns: 1fr; row-gap: 50px; } }
  @media (max-width: 767px) { h2 { font-size: 30px; line-height: 34.5px; } }
</style>
