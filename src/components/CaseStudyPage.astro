---
// CASE STUDY TEMPLATE — har case study page (Semantic SEO, Local SEO, GEO, Website, GMB) isi design ko use karta hai.
// Page ki file sirf "data" deti hai; design yahan hai. Design badalna ho to yahan badlein — sab pages badal jayenge.
// Tabs aur "More case studies" ki list: src/data/caseStudies.ts
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from './CtaBanner.astro';
import { site } from '../data/site';
import { caseTabs, caseSummaries } from '../data/caseStudies';

export interface CaseStudyData {
  meta: { title: string; description: string };
  path: string;                       // is page ka URL, jaise '/semantic-seo-case-study/'
  hero: { tag: string; title: string; lead: string; icon: string };
  facts: { label: string; value: string }[];          // Client / Industry / Timeline / Services
  kpis: { value: string; label: string }[];           // 4 bare result numbers
  overview: { title: string; text: string }[];        // Client overview + challenge paragraphs
  challenges: string[];                               // challenge bullet points
  table?: { before: string; after: string; rows: [string, string, string, string][] }; // metric, before, after, change
  approach: { title: string; text: string; points?: string[] }[];
  results: { value: string; title: string; text: string }[];
  quote?: { text: string; name: string; role: string; initials: string };
  takeaways: string[];
}
interface Props { data: CaseStudyData }
const { data: d } = Astro.props;
const more = caseSummaries.filter((c) => c.href !== d.path).slice(0, 3);

const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: d.hero.title.replace(/<[^>]+>/g, ''),
  description: d.meta.description,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
};
---
<BaseLayout title={d.meta.title} description={d.meta.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />

  <!-- 1. HERO -->
  <section class="sec cs-hero">
    <div class="bg" aria-hidden="true"><div class="g1"></div><div class="g2"></div><div class="gl"></div></div>
    <div class="row inner hero-grid">
      <div>
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/case-studies/">Case Studies</a><span>/</span><em>{d.hero.tag}</em></nav>
        <div class="badge"><span class="dot"></span>CASE STUDY · {d.hero.tag}</div>
        <h1 set:html={d.hero.title} />
        <p class="lead" set:html={d.hero.lead} />
        <div class="rr-btn-group">
          <a href={site.calendly} class="rr-btn rr-btn-primary rr-btn-lg" target="_blank" rel="noopener"><span>Get Results Like This</span><span class="rr-btn-arrow">→</span></a>
          <a href="#results" class="rr-btn rr-btn-ghost rr-btn-lg"><span>Jump to Results</span><span class="rr-btn-arrow">↓</span></a>
        </div>
      </div>
      <aside class="glance">
        <div class="gl-ico">{d.hero.icon}</div>
        <div class="gl-lbl">AT A GLANCE</div>
        <dl>
          {d.facts.map((f) => (<div class="fact"><dt>{f.label}</dt><dd set:html={f.value} /></div>))}
        </dl>
      </aside>
    </div>
  </section>

  <!-- 2. KPI STRIP -->
  <section class="kpi-sec">
    <div class="row kpis">
      {d.kpis.map((k) => (<div class="kpi"><div class="kpi-val grad">{k.value}</div><div class="kpi-lbl">{k.label}</div></div>))}
    </div>
  </section>

  <!-- 3. TABS -->
  <section class="tabs-sec">
    <div class="row tabs">
      {caseTabs.map((t) => <a href={t.href} class:list={['tab', { active: t.href === d.path }]}>{t.label}</a>)}
    </div>
  </section>

  <!-- 4. STORY -->
  <section class="sec story">
    <div class="row story-grid">
      <article class="body">
        {d.overview.map((o, i) => (
          <div class="block">
            <div class="step-lbl">{String(i + 1).padStart(2, '0')}</div>
            <h2 set:html={o.title} />
            <p set:html={o.text} />
            {i === d.overview.length - 1 && d.challenges.length > 0 && (
              <ul class="xlist">{d.challenges.map((c) => <li set:html={c} />)}</ul>
            )}
          </div>
        ))}

        <div class="block">
          <div class="step-lbl">{String(d.overview.length + 1).padStart(2, '0')}</div>
          <h2>Our approach</h2>
          <ol class="timeline">
            {d.approach.map((a, i) => (
              <li>
                <div class="tl-num">{i + 1}</div>
                <div class="tl-body">
                  <h3 set:html={a.title} />
                  <p set:html={a.text} />
                  {a.points && <ul class="tick-list">{a.points.map((p) => <li set:html={p} />)}</ul>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </article>

      <aside class="side">
        <div class="side-card">
          <div class="side-lbl">THE OUTCOME</div>
          {d.kpis.slice(0, 2).map((k) => (<div class="side-kpi"><div class="side-val grad">{k.value}</div><div class="side-txt">{k.label}</div></div>))}
          <a href={site.calendly} class="rr-btn rr-btn-primary side-btn" target="_blank" rel="noopener"><span>Book a Free Strategy Call</span><span class="rr-btn-arrow">→</span></a>
          <a href="/services/seo-audits/" class="side-link">Or get a free SEO + GEO audit →</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- 5. RESULTS -->
  <section class="sec results" id="results">
    <div class="row center res-head">
      <p class="eyebrow">THE RESULTS</p>
      <h2 class="sec-title">What moved — and by how much.</h2>
    </div>
    <div class="row res-grid">
      {d.results.map((r) => (
        <div class="res"><div class="res-val grad">{r.value}</div><div class="res-title" set:html={r.title} /><div class="res-text" set:html={r.text} /></div>
      ))}
    </div>
    {d.table && (
      <div class="row tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Metric</th><th>Before<span>{d.table.before}</span></th><th>After<span>{d.table.after}</span></th><th>Change</th></tr></thead>
          <tbody>
            {d.table.rows.map(([m, b, a, c]) => (<tr><td>{m}</td><td class="muted">{b}</td><td class="strong">{a}</td><td><span class="chg">{c}</span></td></tr>))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <!-- 6. QUOTE -->
  {d.quote && (
    <section class="sec quote-sec">
      <div class="row quote-row">
        <div class="qcard">
          <div class="q1"></div><div class="q2"></div>
          <div class="q-in">
            <div class="q-mark">“</div>
            <p class="q-text">{d.quote.text}</p>
            <div class="q-who"><div class="q-av">{d.quote.initials}</div><div><div class="q-name">{d.quote.name}</div><div class="q-role" set:html={d.quote.role} /></div></div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 7. TAKEAWAYS -->
  <section class="sec take-sec">
    <div class="row take-row">
      <p class="eyebrow">KEY TAKEAWAYS</p>
      <h2 class="sec-title">What your business can learn from this.</h2>
      <div class="takes">
        {d.takeaways.map((t, i) => (<div class="take"><span class="take-n">{String(i + 1).padStart(2, '0')}</span><p set:html={t} /></div>))}
      </div>
    </div>
  </section>

  <!-- 8. MORE CASE STUDIES -->
  <section class="sec more-sec">
    <div class="row more-head">
      <div><p class="eyebrow">MORE CASE STUDIES</p><h2 class="sec-title">Keep reading.</h2></div>
      <a href="/case-studies/" class="rr-btn rr-btn-outline"><span>All case studies</span><span class="rr-btn-arrow">→</span></a>
    </div>
    <div class="row more-grid">
      {more.map((m) => (
        <a href={m.href} class="mcard">
          <div class="m-top" style={'background:linear-gradient(135deg,' + m.colors[0] + ' 0%,' + m.colors[1] + ' 100%)'}><div class="m-grid"></div><span class="m-ico">{m.icon}</span></div>
          <div class="m-body">
            <div class="m-tag">{m.tag}</div>
            <div class="m-title">{m.title}</div>
            <div class="m-stat"><strong>{m.stat}</strong> {m.statLabel}</div>
            <div class="m-more">Read the case study →</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 9. CTA -->
  <CtaBanner />
</BaseLayout>

<style>
  .grad { background: linear-gradient(135deg, #10B981 0%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  :global(.cs-hero h1 .grad) { background: linear-gradient(135deg, #10B981 0%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  section { font-family: var(--inter); }
  .inner { z-index: 1; }
  .bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .eyebrow { margin-bottom: 12px; padding: 0; }
  .sec-title { letter-spacing: -1px; }

  /* 1. Hero */
  .cs-hero { background: linear-gradient(135deg, #0F172A 0%, #020617 100%); padding: 110px 0 150px; overflow: hidden; }
  .g1 { position: absolute; top: 5%; left: -8%; width: 550px; height: 550px; background: radial-gradient(circle, rgba(16,185,129,.15) 0%, transparent 70%); filter: blur(70px); }
  .g2 { position: absolute; bottom: -20%; right: -8%; width: 650px; height: 650px; background: radial-gradient(circle, rgba(139,92,246,.18) 0%, transparent 70%); filter: blur(80px); }
  .gl { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size: 60px 60px; -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%); mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%); }
  .hero-grid { display: grid; grid-template-columns: 1fr 380px; gap: 64px; align-items: center; }
  .crumbs { display: flex; gap: 10px; align-items: center; font-size: 13px; color: var(--slate-400); margin-bottom: 22px; line-height: 1.7; }
  .crumbs a { color: var(--slate-400); transition: color .2s; }
  .crumbs a:hover { color: var(--green); }
  .crumbs em { font-style: normal; color: var(--slate-300); }
  .badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: rgba(16,185,129,.12); border: 1px solid rgba(16,185,129,.35); border-radius: 100px; font-size: 12px; font-weight: 600; color: var(--green); letter-spacing: 1.5px; line-height: 1.7; margin-bottom: 24px; }
  .dot { display: inline-block; width: 8px; height: 8px; background: var(--green); border-radius: 50%; box-shadow: 0 0 12px var(--green); }
  .cs-hero h1 { font-size: 56px; font-weight: 800; line-height: 1.1; letter-spacing: -1.8px; color: #fff; margin-bottom: 22px; padding: 0; }
  .lead { font-size: 18px; line-height: 1.75; color: var(--slate-300); margin-bottom: 34px; padding: 0; max-width: 680px; }
  .glance { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: 24px; padding: 32px; backdrop-filter: blur(10px); position: relative; overflow: hidden; }
  .gl-ico { position: absolute; top: 18px; right: 22px; font-size: 54px; line-height: 1; opacity: .9; }
  .gl-lbl { font-size: 11px; letter-spacing: 2px; color: rgba(255,255,255,.55); font-weight: 600; margin-bottom: 18px; line-height: 1.7; }
  .glance dl { margin: 0; }
  .fact { padding: 14px 0; border-top: 1px solid rgba(255,255,255,.08); }
  .fact:first-child { border-top: 0; padding-top: 4px; }
  .fact dt { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--slate-400); font-weight: 600; margin-bottom: 4px; line-height: 1.5; }
  .fact dd { margin: 0; font-size: 15px; color: #fff; font-weight: 600; line-height: 1.5; }

  /* 2. KPIs */
  .kpi-sec { position: relative; z-index: 2; margin-top: -80px; }
  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; padding: 0; }
  .kpi { background: #fff; border-radius: 18px; padding: 28px 26px; box-shadow: 0 20px 50px -20px rgba(15,23,42,.25); border: 1px solid #E2E8F0; }
  .kpi-val { font-size: 40px; font-weight: 800; letter-spacing: -1.2px; line-height: 1.1; margin-bottom: 8px; }
  .kpi-lbl { font-size: 13.5px; color: var(--slate-500); line-height: 1.5; }

  /* 3. Tabs */
  .tabs-sec { padding: 56px 0 0; background: #fff; }
  .tabs { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; padding: 0; }
  .tab { padding: 10px 20px; border-radius: 100px; border: 1.5px solid #E2E8F0; background: #fff; color: var(--slate-500); font-size: 14px; font-weight: 600; line-height: 1.7; transition: all .2s; }
  .tab:hover { border-color: var(--green); color: var(--green); }
  .tab.active { background: var(--navy); border-color: var(--navy); color: #fff; }

  /* 4. Story */
  .story { background: #fff; padding: 72px 0 100px; }
  .story-grid { display: grid; grid-template-columns: 1fr 340px; gap: 72px; align-items: start; padding: 0; }
  .block { padding-bottom: 48px; margin-bottom: 48px; border-bottom: 1px solid #E2E8F0; }
  .block:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .step-lbl { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; color: var(--green); background: #ECFDF5; border-radius: 8px; padding: 4px 10px; margin-bottom: 14px; line-height: 1.7; }
  .body h2 { font-size: 32px; font-weight: 800; letter-spacing: -.8px; line-height: 1.2; color: var(--navy); margin-bottom: 16px; padding: 0; }
  .body p { font-size: 16.5px; line-height: 1.8; color: #475569; padding: 0; }
  .body :global(strong) { color: var(--navy); }
  .xlist { list-style: none; padding: 0; margin: 22px 0 0; display: grid; gap: 12px; }
  .xlist li { position: relative; padding: 14px 18px 14px 48px; background: #FEF2F2; border: 1px solid #FECACA; border-radius: 12px; font-size: 15px; color: #7F1D1D; line-height: 1.6; }
  .xlist li::before { content: "!"; position: absolute; left: 16px; top: 14px; width: 20px; height: 20px; border-radius: 50%; background: #EF4444; color: #fff; font-size: 12px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .timeline { list-style: none; padding: 0; margin: 26px 0 0; position: relative; }
  .timeline::before { content: ""; position: absolute; left: 19px; top: 8px; bottom: 8px; width: 2px; background: linear-gradient(#10B981, #8B5CF6); opacity: .35; }
  .timeline > li { display: grid; grid-template-columns: 40px 1fr; gap: 22px; padding-bottom: 30px; position: relative; }
  .timeline > li:last-child { padding-bottom: 0; }
  .tl-num { width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(135deg, #10B981, #8B5CF6); color: #fff; font-weight: 800; font-size: 16px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px -8px rgba(16,185,129,.6); position: relative; }
  .tl-body h3 { font-size: 19px; font-weight: 700; color: var(--navy); line-height: 1.35; margin: 8px 0 8px; padding: 0; }
  .tl-body p { font-size: 15.5px; }
  .tick-list { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
  .tick-list li { position: relative; padding-left: 28px; font-size: 15px; color: #475569; line-height: 1.6; }
  .tick-list li::before { content: "✓"; position: absolute; left: 0; top: 2px; width: 18px; height: 18px; border-radius: 50%; background: var(--green); color: #fff; font-size: 10px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .side { position: sticky; top: 110px; }
  .side-card { background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); border-radius: 22px; padding: 32px 28px; color: #fff; }
  .side-lbl { font-size: 11px; letter-spacing: 2px; color: rgba(255,255,255,.55); font-weight: 600; margin-bottom: 18px; line-height: 1.7; }
  .side-kpi { padding: 14px 0; border-top: 1px solid rgba(255,255,255,.08); }
  .side-kpi:first-of-type { border-top: 0; padding-top: 0; }
  .side-val { font-size: 38px; font-weight: 800; letter-spacing: -1px; line-height: 1.1; }
  .side-txt { font-size: 13.5px; color: var(--slate-400); line-height: 1.5; margin-top: 4px; }
  .side-btn { width: 100%; justify-content: center; margin-top: 20px; }
  .side-link { display: block; text-align: center; font-size: 13.5px; color: var(--slate-300); margin-top: 14px; line-height: 1.7; }
  .side-link:hover { color: var(--green); }

  /* 5. Results */
  .results { background: var(--light-bg); }
  .res-head { padding: 0 0 48px; }
  .res-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; padding: 0; }
  .res { background: #fff; border: 1px solid #E2E8F0; border-radius: 18px; padding: 32px 28px; }
  .res-val { font-size: 46px; font-weight: 800; letter-spacing: -1.5px; line-height: 1.1; margin-bottom: 12px; }
  .res-title { font-size: 18px; font-weight: 700; color: var(--navy); margin-bottom: 8px; line-height: 1.35; }
  .res-text { font-size: 14.5px; color: var(--slate-500); line-height: 1.65; }
  .tbl-wrap { padding: 40px 0 0; overflow-x: auto; }
  .tbl { width: 100%; border-collapse: separate; border-spacing: 0; background: #fff; border: 1px solid #E2E8F0; border-radius: 18px; overflow: hidden; font-size: 15px; }
  .tbl th { text-align: left; background: var(--navy); color: #fff; font-weight: 700; font-size: 13px; letter-spacing: .5px; padding: 18px 22px; line-height: 1.4; }
  .tbl th span { display: block; font-weight: 500; color: var(--slate-400); font-size: 12px; letter-spacing: 0; margin-top: 2px; }
  .tbl td { padding: 18px 22px; border-top: 1px solid #E2E8F0; color: var(--navy); line-height: 1.5; }
  .tbl tr:nth-child(even) td { background: #FBFCFE; }
  .tbl .muted { color: var(--slate-500); }
  .tbl .strong { font-weight: 700; }
  .chg { display: inline-block; background: #ECFDF5; color: #047857; font-weight: 700; font-size: 13.5px; padding: 4px 12px; border-radius: 100px; }

  /* 6. Quote */
  .quote-sec { background: #fff; }
  .quote-row { max-width: 1000px; padding: 0; }
  .qcard { background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); border-radius: 26px; padding: 60px 64px; position: relative; overflow: hidden; color: #fff; }
  .q1 { position: absolute; top: -60px; right: -60px; width: 280px; height: 280px; background: radial-gradient(circle, rgba(16,185,129,.25), transparent 70%); filter: blur(50px); }
  .q2 { position: absolute; bottom: -60px; left: -60px; width: 240px; height: 240px; background: radial-gradient(circle, rgba(139,92,246,.22), transparent 70%); filter: blur(40px); }
  .q-in { position: relative; }
  .q-mark { font-size: 96px; line-height: .8; font-weight: 800; background: linear-gradient(135deg, #10B981, #8B5CF6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 8px; font-family: Georgia, serif; }
  .q-text { font-size: 23px; line-height: 1.6; color: #E2E8F0; font-weight: 500; margin-bottom: 30px; padding: 0; letter-spacing: -.2px; }
  .q-who { display: flex; align-items: center; gap: 14px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.1); }
  .q-av { width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, #10B981, #8B5CF6); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 18px; flex: none; }
  .q-name { font-weight: 700; font-size: 16px; line-height: 1.6; }
  .q-role { font-size: 13.5px; color: var(--slate-400); line-height: 1.5; }

  /* 7. Takeaways */
  .take-sec { background: #fff; }
  .quote-sec + .take-sec { padding-top: 0; }
  .take-row { max-width: 1000px; padding: 0; }
  .takes { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 30px; }
  .take { display: flex; gap: 16px; align-items: flex-start; background: var(--light-bg); border: 1px solid #E2E8F0; border-radius: 16px; padding: 22px 24px; }
  .take-n { flex: none; font-size: 13px; font-weight: 800; color: var(--green); background: #ECFDF5; border-radius: 10px; padding: 6px 10px; line-height: 1.4; }
  .take p { font-size: 15.5px; line-height: 1.7; color: #334155; padding: 0; }
  .take :global(strong) { color: var(--navy); }

  /* 8. More */
  .more-sec { background: var(--light-bg); }
  .more-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; padding: 0 0 36px; }
  .more-head .sec-title { margin: 0; }
  .more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; padding: 0; }
  .mcard { display: block; background: #fff; border: 1px solid #E2E8F0; border-radius: 18px; overflow: hidden; transition: all .3s; }
  .mcard:hover { transform: translateY(-5px); box-shadow: 0 24px 48px -18px rgba(15,23,42,.18); border-color: var(--green); }
  .m-top { position: relative; height: 150px; display: flex; align-items: center; justify-content: center; }
  .m-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px); background-size: 30px 30px; }
  .m-ico { position: relative; font-size: 64px; line-height: 1; filter: drop-shadow(0 10px 20px rgba(0,0,0,.2)); }
  .m-body { padding: 24px 24px 26px; }
  .m-tag { font-size: 11px; letter-spacing: 1.5px; color: var(--slate-500); font-weight: 600; margin-bottom: 8px; line-height: 1.7; }
  .m-title { font-size: 19px; font-weight: 700; color: var(--navy); line-height: 1.3; margin-bottom: 12px; letter-spacing: -.2px; }
