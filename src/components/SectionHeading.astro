---
// Har section ka upar wala heading block: chhota eyebrow + bara title + subtitle.
// title mein <span> ya <br> wala HTML bhi chal sakta hai.
interface Props { eyebrow: string; title: string; sub?: string; eyebrowColor?: string; class?: string; }
const { eyebrow, title, sub, eyebrowColor, class: cls = '' } = Astro.props;
---
<div class={`row row-narrow center sh ${cls}`}>
  <p class="eyebrow" style={eyebrowColor ? `color:${eyebrowColor}` : undefined}>{eyebrow}</p>
  <h2 class="sec-title" set:html={title} />
  {sub && <p class="sec-sub" set:html={sub} />}
</div>
<style>
  .sh { padding-bottom: 60px; }
  .sh .sec-title:last-child { margin-bottom: 0; }
</style>
